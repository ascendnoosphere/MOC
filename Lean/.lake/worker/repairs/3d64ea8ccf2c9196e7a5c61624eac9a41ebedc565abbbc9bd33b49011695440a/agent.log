  have hDa' : diagonal a * diagonal a = diagonal a := by
    rw [← hDa, hDmul, hProj]
  have hDbDa : diagonal b * diagonal a = 0 := by
    rw [← hDa, ← hDb, hDmul, hBA, Matrix.mul_zero, Matrix.zero_mul]
  have haCases (j : Fin 3) : a j = 0 ∨ a j = 1 := by
    have h := congrArg (fun M : Matrix (Fin 3) (Fin 3) ℝ => M j j) hDa'
    rw [Matrix.diagonal_mul_diagonal, Matrix.diagonal_apply_eq, Matrix.diagonal_apply_eq] at h
    exact (mul_eq_zero.mp (show a j * (a j - 1) = 0 by nlinarith [h])).imp id sub_eq_zero.mp
  have haNonneg (j : Fin 3) : 0 ≤ a j := by
    rcases haCases j with h | h <;> simp [h]
  have hai : ∃ i, a i = 1 := by
    by_contra! hnone
    have hz (j : Fin 3) : a j = 0 := (haCases j).resolve_right (hnone j)
    simp [hz] at hsumA
  obtain ⟨i, hi⟩ := hai
  have haSingle : a = Pi.single i 1 := by
    funext j
    by_cases hj : j = i
    · subst j
      simpa using hi
    · have hz := Finset.sum_eq_zero_iff_of_nonneg (s := Finset.univ.erase i)
        (fun k _ => haNonneg k)
      have htail : ∑ k ∈ Finset.univ.erase i, a k = 0 := by
        rw [← Finset.add_sum_erase _ _ (Finset.mem_univ i), hi] at hsumA
        linarith
      simpa [Pi.single_eq_of_ne hj] using hz.mp htail j (Finset.mem_erase.mpr ⟨hj, Finset.mem_univ j⟩)
  have hbi : b i = 0 := by
    have h := congrArg (fun M : Matrix (Fin 3) (Fin 3) ℝ => M i i) hDbDa
    simpa [Matrix.diagonal_mul_diagonal, hi] using h
  have hc : C = 1 - A - B := by
    apply (eq_sub_iff_add_eq).mpr
    apply (eq_sub_iff_add_eq).mpr
    simpa [add_comm, add_left_comm, add_assoc] using hsum
  refine ⟨O, i, b, (fun j => ⟨hbnonneg j, hble j⟩), hbi, hsumB, ?_, hb, ?_⟩
  · simpa only [haSingle] using ha
  · have hdiag : diagonal (fun j => 1 - (Pi.single i 1 : Fin 3 → ℝ) j - b j) =
        1 - diagonal (Pi.single i 1) - diagonal b := by
      rw [← Matrix.diagonal_one, ← Matrix.diagonal_sub, ← Matrix.diagonal_sub] <;> rfl
    rw [hdiag, hc, ha, hb, haSingle, Matrix.mul_sub, Matrix.mul_sub,
      Matrix.sub_mul, Matrix.sub_mul, Matrix.mul_one, hPP]

/-- Six candidate trace-free perturbations of real symmetric `3 × 3`
matrices have a nontrivial combination with zero total perturbation. -/
        limUnder (𝓝[≠] c) (f ∘ e.symm) = limUnder (𝓝[Sᶜ] x) f := by
      unfold limUnder
      rw [← Filter.map_map, hmap]
    apply (mdifferentiableAt_iff_source_of_mem_source (I := 𝓘(ℂ, ℂ))
      (I' := 𝓘(ℂ, ℂ)) (mem_chart_source ℂ x)).2
    rw [hrange, mdifferentiableWithinAt_univ, mdifferentiableAt_iff_differentiableAt]
    change DifferentiableAt ℂ (F ∘ e.symm) c
    apply ((Complex.differentiableOn_update_limUnder_of_bddAbove hT hd hbound)
      .differentiableAt hT).congr_of_eventuallyEq
    filter_upwards [hT] with z hz
    by_cases hzc : z = c
    · subst z
      simp only [Function.comp_apply, hcenter, F, if_pos hx, update_self, hlim]
    · have hzS : e.symm z ∉ S := (hlocal z hz).2 hzc
      simp only [Function.comp_apply, F, if_neg hzS, update_of_ne hzc]
  · apply (hf.mdifferentiableAt (hopen.mem_nhds (show x ∈ Sᶜ from hx))).congr_of_eventuallyEq
    filter_upwards [hopen.mem_nhds (show x ∈ Sᶜ from hx)] with y hy
    exact if_neg (show y ∉ S from hy)

variable [CompactSpace M] [PreconnectedSpace M]

/-- A holomorphic function on the complement of a finite set in a compact
connected complex surface cannot be nonconstant and take all its values
in the closed right half-plane. -/
theorem eqOn_of_re_nonneg_off_finite {S : Set M} (hS : S.Finite)
    {f : M → ℂ} (hf : MDifferentiableOn 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) f Sᶜ)
    (hre : ∀ x ∈ Sᶜ, 0 ≤ (f x).re) {x y : M} (hx : x ∈ Sᶜ) (hy : y ∈ Sᶜ) :
    f x = f y := by
  let g (x : M) := (1 + f x)⁻¹
  have hopen : IsOpen Sᶜ := hS.isClosed.isOpen_compl
  have hpos (x : M) (hx : x ∈ Sᶜ) : 1 ≤ (1 + f x).re := by
    simpa only [Complex.add_re, Complex.one_re] using add_le_add_left (hre x hx) 1
  have hg : MDifferentiableOn 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) g Sᶜ := by
    intro z hz
    have hn : (1 + f z : ℂ) ≠ 0 := by
      intro h
      have h' := hpos z hz
      rw [h, Complex.zero_re] at h'
      exact (not_le_of_gt zero_lt_one) h'
    have hd : DifferentiableAt ℂ (fun w : ℂ => (1 + w)⁻¹) (f z) :=
      (differentiableAt_id.const_add (1 : ℂ)).inv hn
    exact (hd.mdifferentiableAt.comp z (hf.mdifferentiableAt (hopen.mem_nhds hz)))
      .mdifferentiableWithinAt
  have hbounded (z : M) (hz : z ∈ Sᶜ) : ‖g z‖ ≤ 1 := by
    rw [g, norm_inv]
    exact inv_le_one_of_one_le₀ ((hpos z hz).trans (Complex.re_le_norm _))
  obtain ⟨G, hG, hEq⟩ := exists_holomorphic_extension_off_finite hS hg 1 hbounded
  have he : g x = g y := (hEq hx).symm.trans ((hG.apply_eq_of_compactSpace x y).trans (hEq hy))
  have he' : 1 + f x = 1 + f y := by
    simpa only [g, inv_inv] using congrArg (fun z : ℂ => z⁻¹) he
  exact add_left_cancel he'

/-- On a supplied compactified curve, a finite family of initially positive
gaps acquires a zero while the other gaps stay nonnegative, provided one
gap function varies on the connected punctured curve. -/
theorem exists_new_contact_on_curve {ι : Type*} (J : Finset ι) {S : Set M} (hS : S.Finite)
    (hconn : IsPreconnected Sᶜ) (H : ι → M → ℂ)
    (hhol : ∀ i ∈ J, MDifferentiableOn 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) (H i) Sᶜ)
    {x₀ : M} (hx₀ : x₀ ∈ Sᶜ) (hstart : ∀ i ∈ J, 0 < (H i x₀).re)
    (hvar : ∃ i ∈ J, ∃ x ∈ Sᶜ, ∃ y ∈ Sᶜ, H i x ≠ H i y) :
    ∃ z ∈ Sᶜ, (∀ i ∈ J, 0 ≤ (H i z).re) ∧ ∃ i ∈ J, (H i z).re = 0 := by
  obtain ⟨i, hi, x, hx, y, hy, hxy⟩ := hvar
  have hnegative : ∃ w ∈ Sᶜ, (H i w).re < 0 := by
    by_contra! h
    exact hxy (eqOn_of_re_nonneg_off_finite hS (hhol i hi) h hx hy)
  obtain ⟨w, hw, hwi⟩ := hnegative
  let Jne : J.Nonempty := ⟨i, hi⟩
  let m (z : M) : ℝ := J.inf' Jne (fun j => (H j z).re)
  have hm : ContinuousOn m Sᶜ := ContinuousOn.finset_inf'_apply Jne
    (fun j hj => Complex.continuous_re.comp_continuousOn (hhol j hj).continuousOn)
  have hmw : m w < 0 := (Finset.inf'_lt_iff Jne).2 ⟨i, hi, hwi⟩
  have hm₀ : 0 < m x₀ := (Finset.lt_inf'_iff Jne).2 hstart
  have hz : (0 : ℝ) ∈ m '' Sᶜ :=
    (hconn.image _ hm).Icc_subset ⟨w, hw, rfl⟩ ⟨x₀, hx₀, rfl⟩ ⟨hmw.le, hm₀.le⟩
  obtain ⟨z, hzS, hmz⟩ := hz
  have hzle : ∀ j ∈ J, 0 ≤ (H j z).re := by
    apply (Finset.le_inf'_iff Jne).1
    change 0 ≤ m z
    rw [hmz]
  obtain ⟨j, hj, he⟩ := Finset.exists_mem_eq_inf' Jne (fun k => (H k z).re)
  exact ⟨z, hzS, hzle, j, hj, he.symm.trans hmz⟩

end
private theorem mul_star_eq_one_of_normSq {z : ℂ} (hz : Complex.normSq z = 1) :
    z * star z = 1 := by
  rw [Complex.star_def, Complex.mul_conj, hz, Complex.ofReal_one]

theorem isUnitary_schurPivotPhase {z : ℂ} (hz : Complex.normSq z = 1) :
    IsUnitary (schurPivotPhase (ι := ι) z) := by
  let d := Sum.elim (fun _ : Unit => z) (fun _ : ι => (1 : ℂ))
  have h (i : Unit ⊕ ι) : d i * star (d i) = 1 := by
    cases i <;> simp [d, mul_star_eq_one_of_normSq hz]
  have h' (i : Unit ⊕ ι) : star (d i) * d i = 1 := (mul_comm _ _).trans (h i)
  change IsUnitary (diagonal d)
  constructor
  · rw [Matrix.diagonal_conjTranspose, Matrix.diagonal_mul_diagonal, ← Matrix.diagonal_one]
    exact congrArg Matrix.diagonal (funext h)
  · rw [Matrix.diagonal_conjTranspose, Matrix.diagonal_mul_diagonal, ← Matrix.diagonal_one]
    exact congrArg Matrix.diagonal (funext h')

/-- The explicitly phased sum, with the original upper right block `p`. -/
def schurPhaseSum (x : ℂ) (p v : Matrix Unit ι ℂ) (w : Matrix ι Unit ℂ)
    (T : Matrix ι ι ℂ) (z : ℂ) : Matrix (Unit ⊕ ι) (Unit ⊕ ι) ℂ :=
  fromBlocks (fun _ _ => x) (p + (z - 1) • v) ((star z - 1) • w) T

theorem schurPhaseSum_eq_unitary_orbit (x : ℂ) (p : Matrix Unit ι ℂ)
    (T : Matrix ι ι ℂ) (B : Matrix (Unit ⊕ ι) (Unit ⊕ ι) ℂ)
    {z : ℂ} (hz : Complex.normSq z = 1) :
    let C := fromBlocks (fun _ _ : Unit => x) p 0 T
    let R := schurPivotPhase (ι := ι) z
    C - B + R * B * Rᴴ = schurPhaseSum x p B.toBlocks₁₂ B.toBlocks₂₁ T z := by
  have hz' := mul_star_eq_one_of_normSq hz
  dsimp only [schurPhaseSum, schurPivotPhase]
  ext i j : 1
  simp only [Matrix.add_apply, Matrix.sub_apply, Matrix.diagonal_conjTranspose,
    Matrix.mul_diagonal, Matrix.diagonal_mul, Pi.star_apply]
  rcases i with (⟨⟩ | i) <;> rcases j with (⟨⟩ | j)
  · simp only [Sum.elim_inl, Matrix.fromBlocks_apply₁₁]
    rw [mul_right_comm z, hz', one_mul, sub_add_cancel]
  · simp only [Sum.elim_inl, Sum.elim_inr, Matrix.fromBlocks_apply₁₂,
      Matrix.add_apply, Matrix.toBlocks₁₂, Matrix.of_apply, Matrix.smul_apply, smul_eq_mul,
      star_one, mul_one]
    ring
  · simp only [Sum.elim_inl, Sum.elim_inr, Matrix.fromBlocks_apply₂₁,
      Matrix.zero_apply, Matrix.toBlocks₂₁, Matrix.of_apply, Matrix.smul_apply, smul_eq_mul,
      one_mul]
    ring
  · simp only [Sum.elim_inr, Matrix.fromBlocks_apply₂₂, star_one, one_mul, mul_one,
      sub_add_cancel]

/-- In the Schur complement, the original row produces a term linear in the
conjugate phase, in addition to the quadratic term from the two moving blocks. -/
theorem det_schurPhaseSum (x : ℂ) (p v : Matrix Unit ι ℂ) (w : Matrix ι Unit ℂ)
    (T : Matrix ι ι ℂ) (hT : T.det ≠ 0) (z : ℂ) :
    (schurPhaseSum x p v w T z).det =
      T.det * (x + (1 - star z) * (p * T⁻¹ * w) () () -
        ((z - 1) * (star z - 1)) * (v * T⁻¹ * w) () ()) := by
  letI : Invertible T.det := invertibleOfNonzero hT
  letI : Invertible T := T.invertibleOfDetInvertible
  rw [schurPhaseSum, Matrix.det_fromBlocks₂₂, Matrix.invOf_eq_nonsing_inv, Matrix.det_unique]
  simp only [Matrix.add_mul, Matrix.mul_add, Matrix.mul_smul, Matrix.smul_mul,
    Matrix.sub_apply, Matrix.add_apply, Matrix.smul_apply, smul_eq_mul]
  ring

/-- The exact real support along the unit circle. Both coefficients can be
computed from solves against the lower right block. -/
theorem support_schurPhaseSum (x : ℂ) (p v : Matrix Unit ι ℂ) (w : Matrix ι Unit ℂ)
    (T : Matrix ι ι ℂ) (hT : T.det ≠ 0) (η z : ℂ) (hz : Complex.normSq z = 1) :
    let P := η * T.det * (p * T⁻¹ * w) () ()
    let Q := η * T.det * (v * T⁻¹ * w) () ()
    (η * (schurPhaseSum x p v w T z).det).re =
      (η * (T.det * x)).re + (1 - z.re) * (P.re - 2 * Q.re) - z.im * P.im := by
  intro P Q
  have hzz := mul_star_eq_one_of_normSq hz
  have hp : (z - 1) * (star z - 1) = (2 : ℂ) * (1 - (z.re : ℂ)) := by
    calc
      _ = 2 - (z + star z) := by linear_combination hzz
      _ = _ := by rw [Complex.star_def, Complex.add_conj, Complex.ofReal_mul]; ring
  rw [det_schurPhaseSum x p v w T hT z, hp]
  have he : η * (T.det * (x + (1 - star z) * (p * T⁻¹ * w) () () -
      (2 * (1 - (z.re : ℂ))) * (v * T⁻¹ * w) () ())) =
      η * (T.det * x) + (1 - star z) * P - (2 * (1 - (z.re : ℂ))) * Q := by
    dsimp only [P, Q]
    ring
  rw [he]
  norm_num [Complex.add_re, Complex.sub_re, Complex.sub_im, Complex.mul_re, Complex.mul_im,
    Complex.star_def] <;> ring

private theorem phase_support_coefficients {a b : ℝ}
    (h : ∀ z : ℂ, Complex.normSq z = 1 → a * (1 - z.re) + b * z.im ≤ 0) :
    a ≤ 0 ∧ b = 0 := by
  have ha := h (-1) (by norm_num [Complex.normSq_neg, Complex.normSq_one])
  norm_num [Complex.neg_re, Complex.neg_im] at ha
  refine ⟨by linarith only [ha], ?_⟩
  by_contra hb
  let d := (1 - a)^2 + b^2
  have hd : 0 < d := add_pos_of_nonneg_of_pos (sq_nonneg _) (sq_pos_of_ne_zero hb)
  let z : ℂ := ⟨((1 - a)^2 - b^2) / d, (2 * (1 - a) * b) / d⟩
  have hz : Complex.normSq z = 1 := by
    simp only [z, Complex.normSq_mk]
    field_simp [hd.ne']
    dsimp only [d]
    ring
  have hv : a * (1 - z.re) + b * z.im = 2 * b^2 / d := by
    dsimp only [z]
    field_simp [hd.ne']
    dsimp only [d]
    ring
  have hpos : 0 < 2 * b^2 / d := div_pos (mul_pos (by norm_num) (sq_pos_of_ne_zero hb)) hd
  have hzmax := h z hz
  rw [hv] at hzmax
  exact (not_lt_of_ge hzmax) hpos

/-- A support maximum at phase one has zero sine coefficient and a
nonpositive coefficient of `1 - Re z`. -/
theorem schurPhase_support_coefficients (x : ℂ) (p v : Matrix Unit ι ℂ)
    (w : Matrix ι Unit ℂ) (T : Matrix ι ι ℂ) (hT : T.det ≠ 0) (η : ℂ)
    (hmax : ∀ z : ℂ, Complex.normSq z = 1 →
      (η * (schurPhaseSum x p v w T z).det).re ≤ (η * (schurPhaseSum x p v w T 1).det).re) :
    let P := η * T.det * (p * T⁻¹ * w) () ()
    let Q := η * T.det * (v * T⁻¹ * w) () ()
    P.re - 2 * Q.re ≤ 0 ∧ P.im = 0 := by
  intro P Q
  have hbase := support_schurPhaseSum x p v w T hT η 1 Complex.normSq_one
  norm_num at hbase
  have h (z : ℂ) (hz : Complex.normSq z = 1) :
      (P.re - 2 * Q.re) * (1 - z.re) + (-P.im) * z.im ≤ 0 := by
    have hle := hmax z hz
    have hform := support_schurPhaseSum x p v w T hT η z hz
    change (η * (schurPhaseSum x p v w T z).det).re =
      (η * (T.det * x)).re + (1 - z.re) * (P.re - 2 * Q.re) - z.im * P.im at hform
    rw [hform, hbase] at hle
    linarith only [hle]
  obtain ⟨ha, hb⟩ := phase_support_coefficients h
  exact ⟨ha, neg_eq_zero.mp hb⟩

omit [DecidableEq ι] in
private theorem pivot_normSq_balance (M : Matrix (Unit ⊕ ι) (Unit ⊕ ι) ℂ)
    (hM : M * Mᴴ = Mᴴ * M) :
    (∑ j, Complex.normSq (M (Sum.inl ()) (Sum.inr j))) =
      ∑ i, Complex.normSq (M (Sum.inr i) (Sum.inl ())) := by
  have hleft (z : ℂ) : (z * star z).re = Complex.normSq z :=
    congrArg Complex.re (Complex.mul_conj z)
  have hright (z : ℂ) : (star z * z).re = Complex.normSq z := by rw [mul_comm, hleft]
  have h := congrArg (fun X : Matrix (Unit ⊕ ι) (Unit ⊕ ι) ℂ => (X (Sum.inl ()) (Sum.inl ())).re) hM
  simp only [Matrix.mul_apply, Matrix.conjTranspose_apply, Complex.re_sum, hleft, hright,
    Fintype.sum_sum_type, Fintype.sum_unique] at h
  exact add_left_cancel h

/-- At a local maximum of a finite minimum, zero belongs to the convex hull of the
active gradients. The curves can be chosen in a constraint set, with gradients
represented in the Hilbert space of permissible velocities. -/
theorem zero_mem_convexHull_of_active_gradients
    {E J : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E] [Finite J]
    (value : J → ℝ) (gradient : J → E) (curveValues : J → E → ℝ → ℝ) (g : ℝ)
    (hmin : ∀ j, g ≤ value j)
    (hvalue : ∀ j v, curveValues j v 0 = value j)
    (hderiv : ∀ j v, HasDerivAt (curveValues j v) ⟪gradient j, v⟫_ℝ 0)
    (hmax : ∀ v, ∀ᶠ t in 𝓝[>] (0 : ℝ), ∃ j, curveValues j v t ≤ g) :
    (0 : E) ∈ convexHull ℝ (Set.range fun j : {j // value j = g} => gradient j) := by
  let S : Set E := Set.range fun j : {j // value j = g} => gradient j
  change (0 : E) ∈ convexHull ℝ S
  by_contra hn
  have hclosed : IsClosed (convexHull ℝ S) := (Set.finite_range _).isClosed_convexHull
  obtain ⟨L, r, h0, hsep⟩ :=
    geometric_hahn_banach_point_closed (convex_convexHull ℝ S) hclosed hn
  let v := (InnerProductSpace.toDual ℝ E).symm L
  have hgradient (j : J) (hj : value j = g) : 0 < ⟪gradient j, v⟫_ℝ := by
    rw [real_inner_comm v (gradient j)]
    change 0 < ⟪(InnerProductSpace.toDual ℝ E).symm L, gradient j⟫_ℝ
    rw [InnerProductSpace.toDual_symm_apply]
    have hr : 0 < r := by simpa only [map_zero] using h0
    exact hr.trans (hsep _ (subset_convexHull ℝ S ⟨⟨j, hj⟩, rfl⟩))
  have hstrict (j : J) : ∀ᶠ t in 𝓝[>] (0 : ℝ), g < curveValues j v t := by
    by_cases hj : value j = g
    · have hslope := (hderiv j v).tendsto_slope_zero_right (Ioi_mem_nhds (hgradient j hj))
      filter_upwards [hslope, self_mem_nhdsWithin] with t ht htpos
      change 0 < t at htpos
      change 0 < t⁻¹ • (curveValues j v (0 + t) - curveValues j v 0) at ht
      rw [zero_add, smul_eq_mul, hvalue j v, hj] at ht
      exact sub_pos.mp ((mul_pos_iff_of_pos_left (inv_pos.mpr htpos)).mp ht)
    · have hgt : g < curveValues j v 0 := by
        rw [hvalue]
        exact lt_of_le_of_ne (hmin j) hj.symm
      exact ((hderiv j v).continuousAt.eventually_mem (Ioi_mem_nhds hgt)).filter_mono
        nhdsWithin_le_nhds
  obtain ⟨t, hgt, j, hle⟩ := ((Filter.eventually_all.mpr hstrict).and (hmax v)).exists
  exact hle.not_gt (hgt j)

variable {ι : Type*} [Fintype ι]

/-- The squared Euclidean norm of the pair of spectra. -/
def spectralEnergy (a b : ι → ℂ) : ℝ :=
  (∑ i, Complex.normSq (a i)) + ∑ j, Complex.normSq (b j)

theorem spectralEnergy_shift (a b : ι → ℂ) (t : ℂ) :
    spectralEnergy (fun i => a i + t) (fun i => b i - t) =
      spectralEnergy a b + 2 * (Fintype.card ι : ℝ) * Complex.normSq t +
        2 * (((∑ i, a i) - ∑ i, b i) * star t).re := by
  have hre (c : ι → ℂ) :
      (∑ i, (c i * star t).re) = ((∑ i, c i) * star t).re := by
    rw [Finset.sum_mul]
    exact (map_sum Complex.reLm _ _).symm
  simp only [spectralEnergy, Complex.normSq_add, Complex.normSq_sub, Complex.star_def,
    Finset.sum_add_distrib, Finset.sum_sub_distrib, Finset.sum_const, Finset.card_univ,
    nsmul_eq_mul, ← Finset.mul_sum, ← Complex.star_def, hre, sub_mul, Complex.sub_re]
  ring

theorem spectralEnergy_scale (a b : ι → ℂ) (r : ℝ) :
    spectralEnergy (fun i => (r : ℂ) * a i) (fun i => (r : ℂ) * b i) =
      r ^ 2 * spectralEnergy a b := by
  simp only [spectralEnergy, Complex.normSq_mul, Complex.normSq_ofReal, ← Finset.mul_sum]
  ring

variable [DecidableEq ι] [Nonempty ι]

/-- An opposite shift and a common real dilation improve a positive maximal support
gap unless the two traces agree. The maximization here is over the spectral unit ball. -/
theorem equal_trace_of_positive_support_gap_maximizer
    (a b : ι → ℂ) (U : Matrix ι ι ℂ) (hU : IsUnitary U) (η : ℂ) (g : ℝ)
    (henergy : spectralEnergy a b ≤ 1) (hg : 0 < g)
    (hgap : ∀ σ : Equiv.Perm ι,
      g ≤ (η * (determinantValue a b U - matchingProduct a b σ)).re)
    (hmax : ∀ (c d : ι → ℂ), spectralEnergy c d ≤ 1 →
      ∃ σ : Equiv.Perm ι, (η * (determinantValue c d U - matchingProduct c d σ)).re ≤ g) :
    (∑ i, a i) = ∑ i, b i := by
  by_contra htrace
  let n : ℕ := Fintype.card ι
  have hn : n ≠ 0 := Fintype.card_ne_zero
  have hnR : (0 : ℝ) < n := by exact_mod_cast Nat.pos_of_ne_zero hn
  have hnC : (n : ℂ) ≠ 0 := by exact_mod_cast hn
