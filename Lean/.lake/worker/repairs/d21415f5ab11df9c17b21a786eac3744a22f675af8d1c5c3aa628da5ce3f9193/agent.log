    17	  [Fintype ρ] [DecidableEq ρ] [Fintype σ] [DecidableEq σ]
    18	
    19	/-- Two frames for a common subspace give the reciprocal determinant on that
    20	subspace. The change of column labels places the complementary blocks in a
    21	single square matrix. -/
    22	theorem det_support_frames (e : ι ⊕ κ ≃ ρ ⊕ σ)
    23	    (X : Matrix ι ρ ℂ) (Y : Matrix ι σ ℂ)
    24	    (E : Matrix ρ κ ℂ) (F : Matrix σ κ ℂ)
    25	    (hE : Eᴴ * E = 1) (hF : Fᴴ * F = 1) (hcommon : X * E = Y * F)
    26	    (hG : IsUnit (X * Xᴴ + Y * Yᴴ).det)
    27	    (a : ρ → ℂ) (b : σ → ℂ) (ha : ∀ i, a i ≠ 0) (hb : ∀ j, b j ≠ 0) :
    28	    (X * diagonal a * Xᴴ + Y * diagonal b * Yᴴ).det =
    29	      ((∏ i, a i) * ∏ j, b j) * ((X * Xᴴ + Y * Yᴴ).det / (2 : ℂ) ^ Fintype.card κ) *
    30	        (Eᴴ * diagonal (fun i => (a i)⁻¹) * E + Fᴴ * diagonal (fun j => (b j)⁻¹) * F).det := by
    31	  let s : ℂ := ((1 / 2 : ℝ) : ℂ) + ((1 / 2 : ℝ) : ℂ) * Complex.I
    32	  have hs₀ : star s * s = ((1 / 2 : ℝ) : ℂ) := by
    33	    apply Complex.ext <;> norm_num [s, Complex.star_def, Complex.mul_re, Complex.mul_im]
    34	  have hs : star s * s = (2 : ℂ)⁻¹ := by simpa [one_div, Complex.ofReal_inv] using hs₀
    35	  have hs' : s * star s = (2 : ℂ)⁻¹ := (mul_comm _ _).trans hs
    36	  let W₀ := fromBlocks X Y (star s • Eᴴ) ((-star s) • Fᴴ)
    37	  let W := W₀.submatrix id e
    38	  have hreindex (L : Matrix (ρ ⊕ σ) (ρ ⊕ σ) ℂ) :
    39	      W * L.submatrix e e * Wᴴ = W₀ * L * W₀ᴴ := by
    40	    dsimp only [W]
    41	    rw [Matrix.conjTranspose_submatrix, Matrix.submatrix_mul_equiv,
    42	      Matrix.submatrix_mul_equiv] <;> rfl
    43	  have hupper : X * (s • E) + Y * ((-s) • F) = 0 := by
    44	    simp only [Matrix.mul_smul, hcommon, neg_smul, add_neg_cancel]
    45	  have hlower : (star s • Eᴴ) * Xᴴ + ((-star s) • Fᴴ) * Yᴴ = 0 := by
    46	    have h := congrArg Matrix.conjTranspose hupper
    47	    simpa only [Matrix.conjTranspose_add, Matrix.conjTranspose_mul, Matrix.conjTranspose_smul,
    48	      star_neg, Matrix.conjTranspose_zero] using h
    49	  have hgram : W * Wᴴ = fromBlocks (X * Xᴴ + Y * Yᴴ) 0 0 (1 : Matrix κ κ ℂ) := by
    50	    have h := hreindex (1 : Matrix (ρ ⊕ σ) (ρ ⊕ σ) ℂ)
    51	    rw [Matrix.submatrix_one_equiv, Matrix.mul_one, Matrix.mul_one] at h
    52	    rw [h]
    53	    simp only [W₀, Matrix.fromBlocks_conjTranspose, Matrix.conjTranspose_smul,
    54	      Matrix.conjTranspose_conjTranspose, star_neg, star_star, Matrix.fromBlocks_multiply,
    55	      hupper, hlower]
    56	    congr 1
    57	    simp only [Matrix.smul_mul, Matrix.mul_smul, smul_smul, neg_mul_neg, hs, hs', hE, hF,
    58	      ← add_smul]
    59	    norm_num
    60	  have hblocks (c : ρ → ℂ) (d : σ → ℂ) :
    61	      let L := (diagonal (Sum.elim c d)).submatrix e e
    62	      (W * L * Wᴴ).toBlocks₁₁ = X * diagonal c * Xᴴ + Y * diagonal d * Yᴴ ∧
    63	      (W * L * Wᴴ).toBlocks₂₂ =
    64	        ((2 : ℂ)⁻¹) • (Eᴴ * diagonal c * E + Fᴴ * diagonal d * F) := by
    65	    dsimp only
    66	    rw [hreindex, ← Matrix.fromBlocks_diagonal]
    67	    simp only [W₀, Matrix.fromBlocks_conjTranspose, Matrix.conjTranspose_smul,
    68	      Matrix.conjTranspose_conjTranspose, star_neg, star_star, Matrix.fromBlocks_multiply,
    69	      Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add, Matrix.toBlocks_fromBlocks₁₁,
    70	      Matrix.toBlocks_fromBlocks₂₂, Matrix.smul_mul, Matrix.mul_smul, smul_smul,
    71	      neg_mul_neg, hs, hs', ← smul_add] <;> exact ⟨rfl, rfl⟩
    72	  let c : ρ → ℂ := fun i => (a i)⁻¹
    73	  let d : σ → ℂ := fun j => (b j)⁻¹
    74	  let L := (diagonal (Sum.elim a b)).submatrix e e
    75	  let Linv := (diagonal (Sum.elim c d)).submatrix e e
    76	  have hL : L * Linv = 1 := by
    77	    dsimp only [L, Linv]
    78	    rw [Matrix.submatrix_mul_equiv, Matrix.diagonal_mul_diagonal, Matrix.submatrix_diagonal_equiv,
    79	      ← Matrix.diagonal_one]
    80	    apply congrArg Matrix.diagonal
    81	    funext k
    82	    cases e k <;> simp [c, d, ha, hb]
    83	  have hdet : L.det = (∏ i, a i) * ∏ j, b j := by
    84	    dsimp only [L]
    85	    rw [Matrix.det_submatrix_equiv_self, Matrix.det_diagonal, Fintype.prod_sum_type] <;> rfl
    86	  have h := det_compress_of_orthogonal_row_blocks W L Linv _ hgram hG hL
    87	  rw [(hblocks a b).1, (hblocks c d).2, hdet, Matrix.det_smul] at h
    88	  rw [h, inv_pow, div_eq_mul_inv]
    89	  ring
    90	
    91	/-- A spanning pair of isometries has a common frame of the dimension given
    92	by the excess of its total number of columns over the ambient dimension. -/
    93	theorem exists_overlap_frames (e : ι ⊕ κ ≃ ρ ⊕ σ)
    94	    (X : Matrix ι ρ ℂ) (Y : Matrix ι σ ℂ) (hX : Xᴴ * X = 1) (hY : Yᴴ * Y = 1)
    95	    (hG : IsUnit (X * Xᴴ + Y * Yᴴ).det) :
    96	    ∃ (E : Matrix ρ κ ℂ) (F : Matrix σ κ ℂ), Eᴴ * E = 1 ∧ Fᴴ * F = 1 ∧ X * E = Y * F := by
    97	  let T := fromCols X Y
    98	  let G := X * Xᴴ + Y * Yᴴ
    99	  have hTG : T * Tᴴ = G := by
   100	    simp only [T, G, Matrix.conjTranspose_fromCols_eq_fromRows_conjTranspose,
   101	      Matrix.fromCols_mul_fromRows]
   102	  have hInv : T * (Tᴴ * G⁻¹) = 1 := by
   103	    rw [← Matrix.mul_assoc, hTG, Matrix.mul_nonsing_inv _ hG]
   104	  let L := Matrix.toEuclideanLin T
   105	  have hsurj : Function.Surjective L := by
   106	    intro v
   107	    refine ⟨(WithLp.equiv 2 _).symm ((Tᴴ * G⁻¹) *ᵥ WithLp.equiv 2 _ v), ?_⟩
   108	    apply (WithLp.equiv 2 _).injective
   109	    simp only [L, Matrix.piLp_equiv_toEuclideanLin_apply, Equiv.apply_symm_apply,
   110	      Matrix.mulVec_mulVec, hInv, Matrix.one_mulVec]
   111	  have hcard := Fintype.card_congr e
   112	  have hdim := L.finrank_range_add_finrank_ker
   113	  rw [LinearMap.range_eq_top.mpr hsurj, Submodule.finrank_top,
