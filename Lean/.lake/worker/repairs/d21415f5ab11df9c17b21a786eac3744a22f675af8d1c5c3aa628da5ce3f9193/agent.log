import MOC.Support
import Mathlib.Algebra.Polynomial.Roots
import Mathlib.Topology.Baire.CompleteMetrizable

/-! A strict support violation persists at spectra with nonzero and distinct
matching products. -/

open BigOperators Polynomial
open scoped Topology

namespace MOC

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

private abbrev SpectrumPair (ι : Type*) := (ι → ℂ) × (ι → ℂ)

private def spectralLine (x y : SpectrumPair ι) (t : ℂ) : SpectrumPair ι :=
  (fun i => x.1 i + t * (y.1 i - x.1 i), fun i => x.2 i + t * (y.2 i - x.2 i))

private theorem dense_ne_zero_of_polynomial_lines (f : SpectrumPair ι → ℂ)
    (hnonzero : ∃ y, f y ≠ 0)
    (hpoly : ∀ x y, ∃ p : Polynomial ℂ, ∀ t, p.eval t = f (spectralLine x y t)) :
    Dense {x | f x ≠ 0} := by
  rw [dense_iff_inter_open]
  rintro O hO ⟨x, hx⟩
  obtain ⟨y, hy⟩ := hnonzero
  obtain ⟨p, hp⟩ := hpoly x y
  have h₁ : spectralLine x y 1 = y := by
    apply Prod.ext <;> funext i <;> simp [spectralLine]
  have hp₀ : p ≠ 0 := by
    intro he
    exact hy (by simpa only [h₁, he, eval_zero] using (hp 1).symm)
  have hroots : IsClosed ({t : ℂ | p.IsRoot t} \ {0}) :=
    ((finite_setOf_isRoot hp₀).subset Set.diff_subset).isClosed
  have hroot : ∀ᶠ t in 𝓝 (0 : ℂ), t ∉ ({s : ℂ | p.IsRoot s} \ {0}) :=
    hroots.isOpen_compl.mem_nhds (by simp)
  have hne : ∀ᶠ t in 𝓝[≠] (0 : ℂ), f (spectralLine x y t) ≠ 0 := by
    filter_upwards [hroot.filter_mono nhdsWithin_le_nhds, self_mem_nhdsWithin] with t ht h₀
    exact fun hz => ht ⟨(hp t).trans hz, h₀⟩
  have hc : Continuous (spectralLine x y) := by
    apply Continuous.prodMk <;> apply continuous_pi <;> intro i <;>
      simp only [spectralLine] <;> fun_prop
  have hnear : ∀ᶠ t in 𝓝[≠] (0 : ℂ), spectralLine x y t ∈ O :=
    (hc.continuousAt.eventually_mem (hO.mem_nhds
      (by simpa [spectralLine] using hx))).filter_mono nhdsWithin_le_nhds
  obtain ⟨t, ht, htnz⟩ := (hnear.and hne).exists
  exact ⟨spectralLine x y t, ht, htnz⟩

private theorem matchingProducts_ne_at_some_spectra (σ τ : Equiv.Perm ι) (h : σ ≠ τ) :
    ∃ x : SpectrumPair ι, matchingProduct x.1 x.2 σ ≠ matchingProduct x.1 x.2 τ := by
  classical
  obtain ⟨j, hj⟩ := not_forall.mp (fun he : ∀ j, σ j = τ j => h (Equiv.ext he))
  let a (i : ι) : ℂ := if i = σ j then 1 else 0
  let b (i : ι) : ℂ := if i = j then 0 else 1
  have hσ : matchingProduct a b σ = 1 := by
    unfold matchingProduct
    apply Finset.prod_eq_one
    intro k _
    by_cases hk : k = j
    · subst k
      simp [a, b]
    · have hk' : σ k ≠ σ j := fun he => hk (σ.injective he)
      simp [a, b, hk, hk']
  have hτ : matchingProduct a b τ = 0 := by
    unfold matchingProduct
    apply Finset.prod_eq_zero (Finset.mem_univ j)
    simp [a, b, Ne.symm hj]
  refine ⟨(a, b), ?_⟩
  change matchingProduct a b σ ≠ matchingProduct a b τ
  simpa only [hσ, hτ] using (one_ne_zero : (1 : ℂ) ≠ 0)

private theorem continuous_matchingProduct_pair (σ : Equiv.Perm ι) :
    Continuous fun x : SpectrumPair ι => matchingProduct x.1 x.2 σ := by
  unfold matchingProduct
  apply continuous_finset_prod
  intro j _
  fun_prop

private theorem dense_regular_matching_products :
    Dense {x : SpectrumPair ι | (∀ i j, x.1 i + x.2 j ≠ 0) ∧
      Function.Injective (matchingProduct x.1 x.2)} := by
  classical
  let S (q : ι × ι) : Set (SpectrumPair ι) := {x | x.1 q.1 + x.2 q.2 ≠ 0}
  let T (q : {q : Equiv.Perm ι × Equiv.Perm ι // q.1 ≠ q.2}) : Set (SpectrumPair ι) :=
    {x | matchingProduct x.1 x.2 q.1.1 ≠ matchingProduct x.1 x.2 q.1.2}
  let L (a b : ℂ) : Polynomial ℂ := C a + X * C (b - a)
  have hopenS (q : ι × ι) : IsOpen (S q) :=
    isOpen_ne_fun (by fun_prop) continuous_const
  have hopenT (q : {q : Equiv.Perm ι × Equiv.Perm ι // q.1 ≠ q.2}) : IsOpen (T q) :=
    isOpen_ne_fun (continuous_matchingProduct_pair q.1.1) (continuous_matchingProduct_pair q.1.2)
  have hdenseS (q : ι × ι) : Dense (S q) := by
    apply dense_ne_zero_of_polynomial_lines (fun x => x.1 q.1 + x.2 q.2)
    · exact ⟨(fun _ => 1, fun _ => 0), by simp⟩
    · intro x y
      exact ⟨L (x.1 q.1) (y.1 q.1) + L (x.2 q.2) (y.2 q.2), fun t =>
        by simp [L, spectralLine, eval_add, eval_mul, eval_C, eval_X]⟩
  have hdenseT (q : {q : Equiv.Perm ι × Equiv.Perm ι // q.1 ≠ q.2}) : Dense (T q) := by
    have hd := dense_ne_zero_of_polynomial_lines (fun x =>
      matchingProduct x.1 x.2 q.1.1 - matchingProduct x.1 x.2 q.1.2) (by
        obtain ⟨x, hx⟩ := matchingProducts_ne_at_some_spectra q.1.1 q.1.2 q.2
        exact ⟨x, sub_ne_zero.mpr hx⟩) (by
        intro x y
        let P (σ : Equiv.Perm ι) :=
          ∏ j, (L (x.1 (σ j)) (y.1 (σ j)) + L (x.2 j) (y.2 j))
        exact ⟨P q.1.1 - P q.1.2, fun t => by
          simp [P, L, spectralLine, matchingProduct, eval_sub, eval_prod, eval_add,
            eval_mul, eval_C, eval_X]⟩)
    simpa only [T, sub_ne_zero] using hd
  apply ((dense_iInter_of_isOpen hopenS hdenseS).inter_of_isOpen_right
    (dense_iInter_of_isOpen hopenT hdenseT) (isOpen_iInter_of_finite hopenT)).mono
  intro x hx
  refine ⟨fun i j => Set.mem_iInter.mp hx.1 (i, j), ?_⟩
  intro σ τ he
  by_contra hne
  exact (Set.mem_iInter.mp hx.2 ⟨(σ, τ), hne⟩) he

/-- A fixed unitary and direction with a strict support violation admit spectra
with the same strict inequality, all spectral sums nonzero, and distinct vertices. -/
theorem exists_regular_spectra_of_support_violation (a b : ι → ℂ) (U : Matrix ι ι ℂ) (η : ℂ)
    (h : ∀ σ : Equiv.Perm ι,
      (η * matchingProduct a b σ).re < (η * determinantValue a b U).re) :
    ∃ a' b' : ι → ℂ, (∀ i j, a' i + b' j ≠ 0) ∧ Function.Injective (matchingProduct a' b') ∧
      ∀ σ : Equiv.Perm ι,
        (η * matchingProduct a' b' σ).re < (η * determinantValue a' b' U).re := by
  let O (σ : Equiv.Perm ι) : Set (SpectrumPair ι) :=
    {x | (η * matchingProduct x.1 x.2 σ).re < (η * determinantValue x.1 x.2 U).re}
  have hd : Continuous fun x : SpectrumPair ι => (η * determinantValue x.1 x.2 U).re := by
    unfold determinantValue
    fun_prop
  have ho (σ : Equiv.Perm ι) : IsOpen (O σ) := by
    have hm := continuous_matchingProduct_pair σ
    exact isOpen_lt (by fun_prop) hd
  have hmem : (a, b) ∈ ⋂ σ, O σ := Set.mem_iInter.mpr h
  obtain ⟨x, hx, hstrict⟩ :=
    dense_regular_matching_products.exists_mem_open (isOpen_iInter_of_finite ho) ⟨(a, b), hmem⟩
  exact ⟨x.1, x.2, hx.1, hx.2, Set.mem_iInter.mp hstrict⟩

/-- Checking spectra with nonzero entries in the spectral sum matrix and
pairwise distinct matching products suffices in every finite order. -/
theorem conjecture_iff_regular_matching_products :
    Conjecture ι ↔ ∀ (a b : ι → ℂ) (U : Matrix ι ι ℂ), IsUnitary U →
      (∀ i j, a i + b j ≠ 0) → Function.Injective (matchingProduct a b) → Holds a b U := by
  constructor
  · intro h a b U hU _ _
    exact h a b U hU
  · intro h a b U hU
    by_contra hfail
    rw [holds_iff_directional] at hfail
    push_neg at hfail
    obtain ⟨η, hsep⟩ := hfail
    obtain ⟨a', b', hnonzero, hinj, hsep'⟩ :=
      exists_regular_spectra_of_support_violation a b U η hsep
    obtain ⟨σ, hσ⟩ :=
      (holds_iff_directional a' b' U).mp (h a' b' U hU hnonzero hinj) η
    exact (not_le_of_gt (hsep' σ)) hσ

end

end MOC
    ((Set.finite_range _).union (Set.finite_range _)).countable.dense_compl ℂ
  have hgen : Set.EqOn
      (fun t => ∑ m ∈ s, (w m : ℂ) * matchingProduct (A t) (B t) (σ m))
      (fun t => determinantValue (A t) (B t) U) Kᶜ := by
    intro t ht
    have haT (i : ι) (hi : i ∉ Set.range e) : A t i = 0 := by simp [A, hi, ha i hi]
    have hx (k : Fin 2) : A t (e k) ≠ 0 := by
      intro h
      have heq : t = -a (e k) := by
        have hh : a (e k) + t = 0 := by simpa [A, Set.mem_range_self k] using h
        linear_combination hh
      exact ht (Or.inl ⟨k, heq.symm⟩)
    have hy (j : ι) : B t j ≠ 0 := by
      intro h
      have heq : t = -b j := by change b j + t = 0 at h; linear_combination h
      exact ht (Or.inr ⟨j, heq.symm⟩)
    let x (k : Fin 2) := A t (e k)
    let y := B t
    let D := diagonal x
    let E := U * diagonal y * Uᴴ
    let C := U * diagonal (fun j => (y j)⁻¹) * Uᴴ
    let Dinv := diagonal (fun k => (x k)⁻¹)
    let Γ := (∏ k, x k) * ∏ j, y j
    have hD : P * D * Pᴴ = diagonal (A t) := by
      ext i j : 1
      rw [Matrix.mul_apply, Matrix.diagonal_apply]
      simp only [D, Matrix.mul_diagonal, Matrix.conjTranspose_apply, hP]
      by_cases hij : i = j
      · subst j
        by_cases hi : i ∈ Set.range e
        · obtain ⟨k, rfl⟩ := hi
          rw [Finset.sum_eq_single k]
          · simp [x]
          · intro l _ hl
            simp [e.injective.ne hl]
          · simp
        · have hn (k : Fin 2) : e k ≠ i := fun he => hi ⟨k, he⟩
          simp [hn, haT i hi]
      · rw [if_neg hij]
        apply Finset.sum_eq_zero
        intro k _
        by_cases hk : e k = i
        · have hj : e k ≠ j := fun h => hij (hk.symm.trans h)
          simp [hk, hj]
        · simp [hk]
    have hEC : E * C = 1 := by
      calc
        _ = U * (diagonal y * (Uᴴ * U) * diagonal (fun j => (y j)⁻¹)) * Uᴴ := by
          simp only [E, C, Matrix.mul_assoc]
        _ = 1 := by
          rw [hU.2, Matrix.mul_one, Matrix.diagonal_mul_diagonal]
          simp [y, hy, mul_inv_cancel₀, hU.1]
    have hDD : D * Dinv = 1 := by
      simp [D, Dinv, x, Matrix.diagonal_mul_diagonal, hx, mul_inv_cancel₀]
    have hC : Pᴴ * C * P = Fᴴ * diagonal (fun j => (y j)⁻¹) * F := by
      simp only [C, F, Matrix.conjTranspose_mul, Matrix.conjTranspose_conjTranspose, Matrix.mul_assoc]
    have hbig : diagonal (A t) + E = E * (1 + (C * P) * (D * Pᴴ)) := by
      rw [Matrix.mul_add, Matrix.mul_one, ← Matrix.mul_assoc E (C * P),
        ← Matrix.mul_assoc E C, hEC, Matrix.one_mul, ← Matrix.mul_assoc P D, hD, add_comm]
    have hsmall : 1 + (D * Pᴴ) * (C * P) =
        D * (Dinv + Fᴴ * diagonal (fun j => (y j)⁻¹) * F) := by
      rw [Matrix.mul_add, hDD, ← hC]
      simp only [Matrix.mul_assoc]
    have hE_det : E.det = ∏ j, y j := by
      change (U * diagonal y * Uᴴ).det = _
      rw [det_unitary_conjugation U _ hU, Matrix.det_diagonal]
    have hD_det : D.det = ∏ k, x k := Matrix.det_diagonal
    have hdet : determinantValue (A t) (B t) U =
        Γ * (Dinv + Fᴴ * diagonal (fun j => (y j)⁻¹) * F).det := by
      change (diagonal (A t) + E).det = _
      rw [hbig, Matrix.det_mul E, Matrix.det_one_add_mul_comm (C * P) (D * Pᴴ),
        hsmall, Matrix.det_mul D, hE_det, hD_det]
      dsimp only [Γ]
      ring
    have hweights : (∑ m ∈ s, (w m : ℂ) *
        (((x m.val.1.1)⁻¹ + (y m.val.1.2)⁻¹) *
          ((x m.val.2.1)⁻¹ + (y m.val.2.2)⁻¹))) =
        (Dinv + Fᴴ * diagonal (fun j => (y j)⁻¹) * F).det by
      simpa only [Matrix.conjTranspose_one, Matrix.one_mul, Matrix.mul_one, Dinv] using
        hval (fun k => (x k)⁻¹) (fun j => (y j)⁻¹)
    change (∑ m ∈ s, (w m : ℂ) * matchingProduct (A t) (B t) (σ m)) = _
    rw [hdet, ← hweights, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro m _
    rw [matchingProduct_two_reciprocals _ _ e m _ (hσ m) haT hx hy]
    change (w m : ℂ) * (Γ * _) = Γ * ((w m : ℂ) * _)
    ring
  have hA : Continuous A := continuous_pi fun i => by
    by_cases hi : i ∈ Set.range e
    · simpa only [A, if_pos hi] using (continuous_const.add continuous_id :
        Continuous (fun t : ℂ => a i + t))
    · simpa only [A, if_neg hi] using (continuous_const : Continuous (fun _ : ℂ => a i))
  have hB : Continuous B := continuous_pi fun _ => continuous_const.add continuous_id
  have hcont₁ : Continuous (fun t => ∑ m ∈ s, (w m : ℂ) * matchingProduct (A t) (B t) (σ m)) := by
    apply continuous_finset_sum
    intro m _
    apply Continuous.const_mul
    unfold matchingProduct
    exact continuous_finset_prod _ fun j _ =>
      ((continuous_apply (σ m j)).comp hA).add ((continuous_apply j).comp hB)
  have hUconst : Continuous (fun _ : ℂ => U) := continuous_const
  have hUstar : Continuous (fun _ : ℂ => Uᴴ) := continuous_const
  have hcont₂ : Continuous (fun t => determinantValue (A t) (B t) U) :=
    (hA.matrix_diagonal.add
      ((hUconst.matrix_mul hB.matrix_diagonal).matrix_mul hUstar)).matrix_det
  have hzero := hgen.closure hcont₁ hcont₂ (hK 0)
  have hA₀ : A 0 = a := by funext i; by_cases hi : i ∈ Set.range e <;> simp [A, hi]
  have hB₀ : B 0 = b := by funext j; simp [B]
  change (∑ m ∈ s, (w m : ℂ) * matchingProduct (A 0) (B 0) (σ m)) =
    determinantValue (A 0) (B 0) U at hzero
  rw [hA₀, hB₀] at hzero
  let z (m : TwoEdgeMatching (Fin 2) ι) := matchingProduct a b (σ m)
  have hmem : s.centerMass w z ∈ convexHull ℝ (Set.range (matchingProduct a b)) :=
    s.centerMass_mem_convexHull hw (by rw [hs]; norm_num) (fun m _ => ⟨σ m, rfl⟩)
  rw [s.centerMass_eq_of_sum_1 z hs] at hmem
  simpa only [Holds, z, Complex.real_smul, hzero] using hmem

/-- MOC in any finite order when the first spectrum has a common value
outside at most two specified labels. -/
theorem holds_two_exceptions (a b : ι → ℂ) (U : Matrix ι ι ℂ) (hU : IsUnitary U)
    (i₀ i₁ : ι) (c : ℂ) (ha : ∀ i, i ≠ i₀ → i ≠ i₁ → a i = c) : Holds a b U := by
  by_cases hi : i₀ = i₁
  · subst i₁
    apply (holds_swap_iff a b hU).mp
    apply holds_one_exception b a Uᴴ ⟨by simpa using hU.2, by simpa using hU.1⟩ i₀ c
    exact fun i h => ha i h h
  · let e := pairEmbedding i₀ i₁ hi
    apply (holds_shift_iff a b hU (-c)).mp
    apply holds_of_two_supported _ _ U hU e
    intro i h
    have h₀ : i ≠ i₀ := fun he => h ⟨0, he.symm⟩
    have h₁ : i ≠ i₁ := fun he => h ⟨1, he.symm⟩
    simp [ha i h₀ h₁]

/-- The support-cardinality form also includes empty index types. -/
theorem holds_of_card_exceptions_le_two (a b : ι → ℂ) (U : Matrix ι ι ℂ)
    (hU : IsUnitary U) (c : ℂ) (h : (univ.filter (fun i => a i ≠ c)).card ≤ 2) :
    Holds a b U := by
  by_cases hι : Nonempty ι
  · letI := hι
    let S := univ.filter (fun i => a i ≠ c)
    have hc : S.card ≤ 2 := h
    have hp : ∃ i j : ι, S ⊆ {i, j} := by
      by_cases htwo : S.card = 2
      · obtain ⟨i, j, _, heq⟩ := Finset.card_eq_two.mp htwo
        exact ⟨i, j, heq.le⟩
      · obtain ⟨i, hi⟩ := Finset.card_le_one_iff_subset_singleton.mp (show S.card ≤ 1 by omega)
        exact ⟨i, i, by simpa using hi⟩
    obtain ⟨i, j, hs⟩ := hp
    apply holds_two_exceptions a b U hU i j c
    intro k hki hkj
    by_contra hkc
    have hk : k ∈ S := by simp [S, hkc]
    simpa [hki, hkj] using hs hk
  · haveI : IsEmpty ι := not_nonempty_iff.mp hι
    exact conjecture_of_subsingleton a b U hU

end
