private theorem scaledSupport_re {n : ℕ} (a b : Fin n → GaussianInt) (d : ℕ)
    (V : Matrix (Fin n) (Fin n) GaussianInt) (k : GaussianInt)
    (U : Matrix (Fin n) (Fin n) ℂ) (hV : V.map gauss = (d : ℂ) • U) :
    (scaledSupport a b d V k : ℝ) = ((d : ℝ) ^ 2) ^ n *
      (gauss k * determinantValue (gauss ∘ a) (gauss ∘ b) U).re := by
  have hstar := Matrix.conjTranspose_map (A := V) gauss GaussianInt.toComplex_star
  have hm : (scaledSum a b d V).map gauss = ((d : ℂ) ^ 2) •
      (diagonal (gauss ∘ a) + U * diagonal (gauss ∘ b) * Uᴴ) := by
    simp only [scaledSum, Matrix.map_add gauss (map_add gauss),
      Matrix.map_smul' gauss _ _ (map_mul gauss), map_mul, map_natCast, Matrix.map_mul,
      Matrix.diagonal_map (map_zero gauss), hstar, hV, Matrix.conjTranspose_smul, star_natCast,
      Matrix.smul_mul, Matrix.mul_smul, smul_smul, pow_two, smul_add, Function.comp_apply]
  have hd : ((((d : ℝ) ^ 2) ^ n : ℝ) : ℂ) = ((d : ℂ) ^ 2) ^ n := by
    simp only [Complex.ofReal_pow, Complex.ofReal_natCast]
  rw [scaledSupport, GaussianInt.to_real_re]
  change (gauss (k * (scaledSum a b d V).det)).re = _
  rw [map_mul, RingHom.map_det, RingHom.mapMatrix_apply, hm, Matrix.det_smul,
    Fintype.card_fin, ← hd, mul_left_comm, Complex.re_ofReal_mul, determinantValue]

private theorem scaledCompletionSupport_re (i j : Fin 4) (z : GaussianInt) :
    (scaledCompletionSupport i j z : ℝ) = 46656 * (completionSupport i j (gauss z)).re := by
  have h := scaledSupport_re (walshLeftInt ∘ i.succAbove) (walshRightInt ∘ j.succAbove)
  let b (i : ι) : ℂ := (d i).im
  have hadd : diagonal d + diagonal (star d) = (2 : ℂ) • diagonal a := by
    rw [Matrix.diagonal_add, ← Matrix.diagonal_smul]
    apply congrArg Matrix.diagonal
    funext i
    apply Complex.ext <;> simp [a, Pi.star_apply, Complex.star_def, Complex.mul_re, Complex.mul_im] <;> ring
  have hsub : diagonal d - diagonal (star d) = (2 * Complex.I) • diagonal b := by
    rw [Matrix.diagonal_sub, ← Matrix.diagonal_smul]
    apply congrArg Matrix.diagonal
    funext i
    apply Complex.ext <;> simp [b, Pi.star_apply, Complex.star_def, Complex.mul_re, Complex.mul_im] <;> ring
  refine ⟨a, b, W, hW, smul_right_injective _ (by norm_num : (2 : ℂ) ≠ 0) ?_,
    smul_right_injective _ (mul_ne_zero (by norm_num) Complex.I_ne_zero) ?_⟩
  · calc
      (2 : ℂ) • A = (A + Complex.I • B) + (A - Complex.I • B) := by rw [two_smul]; abel
      _ = W * (diagonal d + diagonal (star d)) * Wᴴ := by
        rw [hd, hd', Matrix.mul_add, Matrix.add_mul]
      _ = _ := by rw [hadd, Matrix.mul_smul, Matrix.smul_mul]
  · calc
      (2 * Complex.I) • B = (A + Complex.I • B) - (A - Complex.I • B) := by
        rw [mul_smul, two_smul]
        abel
      _ = W * (diagonal d - diagonal (star d)) * Wᴴ := by
        rw [hd, hd', Matrix.mul_sub, Matrix.sub_mul]
      _ = _ := by rw [hsub, Matrix.mul_smul, Matrix.smul_mul]

/-- Commuting Hermitian summands give one permutation vertex, including repeated eigenvalues. -/
theorem holds_of_commuting_hermitian (a b : ι → ℂ) {U : Matrix ι ι ℂ}
    (hU : IsUnitary U) (hA : (diagonal a).IsHermitian) (hB : (U * diagonal b * Uᴴ).IsHermitian)
    (hAB : Commute (diagonal a) (U * diagonal b * Uᴴ)) : Holds a b U := by
  obtain ⟨a', b', W, hW, ha, hb⟩ := exists_joint_hermitian_diagonalization _ _ hA hB hAB
  have hdet : determinantValue a b U = determinantValue a' b' (1 : Matrix ι ι ℂ) := by
    unfold determinantValue at ⊢
    rw [ha, hb]
    simpa only [hW.2, determinantValue] using determinantValue_relative a' b' W W hW
  have h1 : IsUnitary (1 : Matrix ι ι ℂ) := by simp [IsUnitary]
  have har := roots_unitary_diagonalization a h1
  simp only [Matrix.one_mul, Matrix.conjTranspose_one, Matrix.mul_one] at har
  rw [ha, roots_unitary_diagonalization a' hW] at har
  have hbr := roots_unitary_diagonalization b hU
  rw [hb, roots_unitary_diagonalization b' hW] at hbr
  obtain ⟨e, he⟩ := exists_perm_of_equal_multisets a a' har.symm
  obtain ⟨f, hf⟩ := exists_perm_of_equal_multisets b b' hbr.symm
  unfold Holds
  rw [hdet, he, hf, matchingRange_relabel]
  exact holds_identity a' b'

/-- MOC for two arbitrary normal matrices and any enumerations of their characteristic roots. -/
def NormalConjecture (ι : Type*) [Fintype ι] [DecidableEq ι] : Prop :=
  ∀ (A B : Matrix ι ι ℂ) (a b : ι → ℂ), IsStarNormal A → IsStarNormal B →
    A.charpoly.roots = (Finset.univ : Finset ι).val.map a →
/-- At a characteristic root of the sum, the permutation products with that
root subtracted from each matched sum have zero in their convex hull. -/
theorem zero_mem_matchingHull_of_mem_charpoly_roots (a b : ι → ℂ) {U : Matrix ι ι ℂ}
    (hU : IsUnitary U) {z : ℂ} (hz : z ∈ (diagonal a + U * diagonal b * Uᴴ).charpoly.roots) :
    0 ∈ convexHull ℝ (Set.range (matchingProduct (fun i => a i - z) b)) := by
  let M := diagonal a + U * diagonal b * Uᴴ
  have hchar : M.charpoly.eval z = 0 := Polynomial.isRoot_of_mem_roots hz
  rw [Matrix.charpoly, Matrix.eval_det, Matrix.matPolyEquiv_charmatrix,
    Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C] at hchar
  have hmatrix : diagonal (fun i => a i - z) + U * diagonal b * Uᴴ =
      -(Matrix.scalar ι z - M) := by
    rw [show (fun i => a i - z) = a - (fun _ => z) from rfl, Matrix.diagonal_sub,
      Matrix.scalar_apply]
    unfold M
    abel
  have hdet : determinantValue (fun i => a i - z) b U = 0 := by
    unfold determinantValue
    rw [hmatrix, Matrix.det_neg, hchar, mul_zero]
  simpa only [Holds, hdet] using holds_of_singular (fun i => a i - z) b hU hdet

end
import MOC.Core
import Mathlib.Analysis.Calculus.Deriv.Mul
import Mathlib.Analysis.Calculus.LocalExtr.Basic
import Mathlib.Analysis.Normed.Algebra.MatrixExponential
import Mathlib.Analysis.SpecialFunctions.Exponential
import Mathlib.LinearAlgebra.Matrix.Trace

/-! Compactness and first variation of the determinant support on a unitary orbit. -/

open BigOperators Matrix

namespace MOC

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

theorem isCompact_setOf_isUnitary : IsCompact {U : Matrix ι ι ℂ | IsUnitary U} := by
  let K : Set (Matrix ι ι ℂ) := Set.univ.pi fun _ =>
    Set.univ.pi fun _ => Metric.closedBall 0 1
  have hK : IsCompact K := isCompact_univ_pi fun _ =>
    isCompact_univ_pi fun _ => isCompact_closedBall _ _
  have hclosed : IsClosed {U : Matrix ι ι ℂ | IsUnitary U} := by
    change IsClosed ({U : Matrix ι ι ℂ | U * Uᴴ = 1} ∩ {U : Matrix ι ι ℂ | Uᴴ * U = 1})
    exact (isClosed_eq (by fun_prop) continuous_const).inter
      (isClosed_eq (by fun_prop) continuous_const)
  refine hK.of_isClosed_subset hclosed ?_
  intro U hU
  refine Set.mem_pi.mpr (fun i _ => Set.mem_pi.mpr (fun j _ => ?_))
  have hr := congrArg (fun M : Matrix ι ι ℂ => (M i i).re) hU.1
  have hsum : ∑ k, Complex.normSq (U i k) = 1 := by
    simpa only [Matrix.mul_apply, Matrix.conjTranspose_apply, Matrix.one_apply_eq,
      Complex.re_sum, Complex.star_def, Complex.mul_conj, Complex.ofReal_re, Complex.one_re] using hr
  have hle : Complex.normSq (U i j) ≤ 1 := hsum ▸ Finset.single_le_sum
    (f := fun k => Complex.normSq (U i k)) (fun k _ => Complex.normSq_nonneg _) (Finset.mem_univ j)
  rw [Metric.mem_closedBall, dist_zero_right]
  apply (sq_le_sq₀ (norm_nonneg _) zero_le_one).mp
  simpa only [← Complex.normSq_eq_norm_sq, one_pow] using hle

/-- A real determinant support always achieves its maximum on the unitary group. -/
theorem exists_support_maximizer (a b : ι → ℂ) (η : ℂ) :
    ∃ U : Matrix ι ι ℂ, IsUnitary U ∧ ∀ V : Matrix ι ι ℂ, IsUnitary V →
      (η * determinantValue a b V).re ≤ (η * determinantValue a b U).re := by
  have hne : {U : Matrix ι ι ℂ | IsUnitary U}.Nonempty := ⟨1, by simp [IsUnitary]⟩
  have hc : Continuous (fun U : Matrix ι ι ℂ => (η * determinantValue a b U).re) := by
    unfold determinantValue
    fun_prop
  obtain ⟨U, hU, hmax⟩ := isCompact_setOf_isUnitary.exists_isMaxOn hne hc.continuousOn
  exact ⟨U, hU, fun V hV => hmax hV⟩

section Derivative

attribute [local instance] Matrix.linftyOpNormedRing Matrix.linftyOpNormedAlgebra

private def matrixEntry (i j : ι) : Matrix ι ι ℂ →L[ℝ] ℂ :=
  ⟨{ toFun := fun M => M i j, map_add' := fun _ _ => rfl, map_smul' := fun _ _ => rfl },
    continuous_apply_apply i j⟩

private theorem hasDerivAt_det_one {M : ℝ → Matrix ι ι ℂ} {D : Matrix ι ι ℂ}
    (hM : HasDerivAt M D 0) (h₀ : M 0 = 1) : HasDerivAt (fun t => (M t).det) D.trace 0 := by
  classical
  have hmoved (σ : Equiv.Perm ι) (hσ : σ ≠ 1) (i : ι) : ∃ j, j ≠ i ∧ σ j ≠ j := by
    by_contra! h
    apply hσ
    ext j
    change σ j = j
    by_cases hj : j = i
    · subst j
      by_contra hi
      exact hi (σ.injective (h (σ i) hi))
    · exact h j hj
  let w (σ : Equiv.Perm ι) : ℂ := (Equiv.Perm.sign σ : ℤ)
  let d (σ : Equiv.Perm ι) : ℂ := ∑ i,
    (∏ j ∈ Finset.univ.erase i, M 0 (σ j) j) • D (σ i) i
  have hp (σ : Equiv.Perm ι) : HasDerivAt (fun t => ∏ i, M t (σ i) i) (d σ) 0 := by
    exact HasDerivAt.finset_prod (fun i _ =>
      (matrixEntry (σ i) i).hasFDerivAt.comp_hasDerivAt 0 hM)
  have hsum : (∑ σ, w σ * d σ) = D.trace := by
    rw [Finset.sum_eq_single (1 : Equiv.Perm ι)]
    · simp [w, d, h₀, Matrix.trace, Equiv.Perm.one_def, Matrix.one_apply_eq]
    · intro σ _ hσ
      have hd : d σ = 0 := by
        apply Finset.sum_eq_zero
        intro i _
        obtain ⟨j, hji, hj⟩ := hmoved σ hσ i
        have hzero : ∏ k ∈ Finset.univ.erase i, M 0 (σ k) k = 0 :=
          Finset.prod_eq_zero (Finset.mem_erase.mpr ⟨hji, Finset.mem_univ j⟩)
            (by rw [h₀, Matrix.one_apply_ne hj])
        rw [hzero, zero_smul]
      rw [hd, mul_zero]
    · simp
  simp_rw [Matrix.det_apply']
  rw [← hsum]
  exact HasDerivAt.sum fun σ _ => (hp σ).const_mul (w σ)

private theorem hasDerivAt_det {M : ℝ → Matrix ι ι ℂ} {D : Matrix ι ι ℂ}
    (hM : HasDerivAt M D 0) (h₀ : (M 0).det ≠ 0) :
    HasDerivAt (fun t => (M t).det) ((M 0).det * ((M 0)⁻¹ * D).trace) 0 := by
  let C := M 0
  have hC : IsUnit C.det := isUnit_iff_ne_zero.mpr h₀
  have hd := (hM.const_mul C⁻¹)
  have htrace := hasDerivAt_det_one hd (C.nonsing_inv_mul hC)
  have he (t : ℝ) : C.det * (C⁻¹ * M t).det = (M t).det := by
    rw [← Matrix.det_mul, ← Matrix.mul_assoc, C.mul_nonsing_inv hC, Matrix.one_mul]
  simpa only [he] using htrace.const_mul C.det

private theorem hasDerivAt_exp_orbit (A B X : Matrix ι ι ℂ) :
    HasDerivAt (fun t : ℝ => A + NormedSpace.exp ℝ (t • X) * B *
      NormedSpace.exp ℝ (t • (-X))) (X * B - B * X) 0 := by
  have hp : HasDerivAt (fun t : ℝ => NormedSpace.exp ℝ (t • X)) X 0 := by
    simpa only [zero_smul, NormedSpace.exp_zero, one_mul] using
      hasDerivAt_exp_smul_const X (0 : ℝ)
  have hn : HasDerivAt (fun t : ℝ => NormedSpace.exp ℝ (t • (-X))) (-X) 0 := by
    simpa only [zero_smul, NormedSpace.exp_zero, one_mul] using
      hasDerivAt_exp_smul_const (-X) (0 : ℝ)
  simpa only [zero_smul, NormedSpace.exp_zero, Matrix.one_mul, Matrix.mul_one,
    Matrix.mul_neg, sub_eq_add_neg, add_comm] using ((hp.mul_const B).mul hn).const_add A

omit [DecidableEq ι] in
private theorem trace_mul_skew_test (D : Matrix ι ι ℂ)
    (h : ∀ X : Matrix ι ι ℂ, Xᴴ = -X → (X * D).trace.re = 0) : Dᴴ = D := by
  let X := Dᴴ - D
  have hX : Xᴴ = -X := by simp [X, neg_sub]
  have hconj : star ((X * D).trace) = -((X * Dᴴ).trace) := by
    rw [← Matrix.trace_conjTranspose, Matrix.conjTranspose_mul, hX,
      Matrix.mul_neg, Matrix.trace_neg, Matrix.trace_mul_comm Dᴴ X]
  have hre := congrArg Complex.re hconj
  simp only [Complex.star_def, Complex.conj_re, Complex.neg_re] at hre
  have hfrob : (X * Xᴴ).trace.re = 0 := by
    have he : Xᴴ = D - Dᴴ := by simp [X]
    rw [he, Matrix.mul_sub, Matrix.trace_sub, Complex.sub_re]
    linarith only [h X hX, hre]
  have hz : ∑ i, ∑ j, Complex.normSq (X i j) = 0 := by
    simpa only [Matrix.trace, Matrix.diag_apply, Matrix.mul_apply, Matrix.conjTranspose_apply,
      Complex.re_sum, Complex.star_def, Complex.mul_conj, Complex.ofReal_re] using hfrob
  have hzero : X = 0 := by
    ext i j : 1
    have hi := (Finset.sum_eq_zero_iff_of_nonneg (fun k _ =>
      Finset.sum_nonneg (fun l _ => Complex.normSq_nonneg (X k l)))).mp hz i (Finset.mem_univ i)
    have hj := (Finset.sum_eq_zero_iff_of_nonneg (fun l _ => Complex.normSq_nonneg (X i l))).mp
      hi j (Finset.mem_univ j)
    exact Complex.normSq_eq_zero.mp hj
  exact sub_eq_zero.mp hzero

/-- At a nonsingular unitary support maximum, the determinant-scaled inverse commutator
is Hermitian. The two fixed matrices need not be normal for this first variation. -/
theorem support_maximum_inverse_commutator (A B : Matrix ι ι ℂ) (η : ℂ)
    (hdet : (A + B).det ≠ 0)
    (hmax : ∀ V : Matrix ι ι ℂ, IsUnitary V →
      (η * (A + V * B * Vᴴ).det).re ≤ (η * (A + B).det).re) :
    let C := A + B
    let D := (η * C.det) • (B * C⁻¹ - C⁻¹ * B)
    Dᴴ = D := by
  let C := A + B
  let D := (η * C.det) • (B * C⁻¹ - C⁻¹ * B)
  change Dᴴ = D
  apply trace_mul_skew_test
  intro X hX
  let V (t : ℝ) := NormedSpace.exp ℝ (t • X)
  have hu (t : ℝ) : IsUnitary (V t) := by
    have hs : t • X ∈ skewAdjoint (Matrix ι ι ℂ) := by
      rw [skewAdjoint.mem_iff, Matrix.star_eq_conjTranspose, Matrix.conjTranspose_smul,
        star_trivial, hX, smul_neg]
    have he := unitary.mem_iff.mp (NormedSpace.exp_mem_unitary_of_mem_skewAdjoint ℝ hs)
    exact ⟨he.2, he.1⟩
  have hv (t : ℝ) : (V t)ᴴ = NormedSpace.exp ℝ (t • (-X)) := by
    change (NormedSpace.exp ℝ (t • X))ᴴ = _
    rw [← Matrix.exp_conjTranspose ℝ, Matrix.conjTranspose_smul, star_trivial, hX]
  let M (t : ℝ) := A + V t * B * (V t)ᴴ
  have hm₀ : M 0 = C := by simp [M, V, C, NormedSpace.exp_zero]
  have hm : HasDerivAt M (X * B - B * X) 0 := by
    change HasDerivAt (fun t => A + V t * B * (V t)ᴴ) _ _
    simp_rw [hv]
    exact hasDerivAt_exp_orbit A B X
  have hd := (hasDerivAt_det hm (by simpa only [hm₀] using hdet)).const_mul η
  have hr := Complex.reCLM.hasFDerivAt.comp_hasDerivAt 0 hd
  have hloc : IsLocalMax (fun t : ℝ => (η * (M t).det).re) 0 := by
    apply Filter.Eventually.of_forall
    intro t
    change (η * (M t).det).re ≤ (η * (M 0).det).re
    rw [hm₀]
    exact hmax (V t) (hu t)
  have hz := hloc.hasDerivAt_eq_zero hr
  simp only [Complex.reCLM_apply, hm₀] at hz
  rw [show X * D = (η * C.det) • (X * (B * C⁻¹ - C⁻¹ * B)) from
    Matrix.mul_smul _ _ _, Matrix.trace_smul, smul_eq_mul]
  have hc : (C⁻¹ * (X * B - B * X)).trace = (X * (B * C⁻¹ - C⁻¹ * B)).trace := by
    simp only [Matrix.mul_sub, Matrix.trace_sub]
    rw [← Matrix.trace_mul_cycle' X B C⁻¹, Matrix.trace_mul_cycle' C⁻¹ B X]
  rw [hc, ← mul_assoc] at hz
  exact hz

end Derivative

/-- At a support maximum with nonzero real support, a skew-Hermitian inverse
commutator forces the summands to commute. -/
theorem commute_of_support_maximum_of_skew_inverse_commutator (A B : Matrix ι ι ℂ)
    (η : ℂ) (hdet : (A + B).det ≠ 0) (hκ : (η * (A + B).det).re ≠ 0)
    (hskew : let C := A + B
      let D := B * C⁻¹ - C⁻¹ * B
      Dᴴ = -D)
    (hmax : ∀ V : Matrix ι ι ℂ, IsUnitary V →
      (η * (A + V * B * Vᴴ).det).re ≤ (η * (A + B).det).re) :
    Commute A B := by
  let C := A + B
  let κ := η * C.det
  let D := B * C⁻¹ - C⁻¹ * B
  change Dᴴ = -D at hskew
  have hHerm : (κ • D)ᴴ = κ • D :=
    support_maximum_inverse_commutator A B η hdet hmax
  have hsum : (κ + star κ) • D = 0 := by
    rw [Matrix.conjTranspose_smul, hskew, smul_neg] at hHerm
    rw [add_smul, ← hHerm, neg_add_cancel]
  have hnz : κ + star κ ≠ 0 := by
    intro hz
    have h := congrArg Complex.re hz
    simp only [Complex.add_re, Complex.star_def, Complex.conj_re, Complex.zero_re] at h
    exact hκ (by linarith only [h])
  have hi : B * C⁻¹ = C⁻¹ * B := sub_eq_zero.mp ((smul_eq_zero.mp hsum).resolve_left hnz)
  have hunit : IsUnit C.det := isUnit_iff_ne_zero.mpr hdet
  have hcomm : C * B = B * C := calc
    C * B = C * ((B * C⁻¹) * C) := by rw [C.nonsing_inv_mul_cancel_right B hunit]
    _ = C * ((C⁻¹ * B) * C) := by rw [hi]
    _ = B * C := by rw [← Matrix.mul_assoc C, C.mul_nonsing_inv_cancel_left B hunit]
  simp only [C, Matrix.add_mul, Matrix.mul_add] at hcomm
  exact add_right_cancel hcomm

/-- A support maximizer with nonzero support has commuting normal summands if its
sum has all singular values equal to the same positive number. -/
theorem commute_of_scalar_unitary_support_maximum (A B : Matrix ι ι ℂ) (η : ℂ)
    (r : ℝ) (hr : r ≠ 0)
    (hA : A * Aᴴ = Aᴴ * A) (hB : B * Bᴴ = Bᴴ * B)
    (hC : (A + B) * (A + B)ᴴ = (r : ℂ) • (1 : Matrix ι ι ℂ))
    (hκ : (η * (A + B).det).re ≠ 0)
    (hmax : ∀ V : Matrix ι ι ℂ, IsUnitary V →
      (η * (A + V * B * Vᴴ).det).re ≤ (η * (A + B).det).re) :
    Commute A B := by
  let C := A + B
  let D := B * C⁻¹ - C⁻¹ * B
  let E := B * Cᴴ - Cᴴ * B
  change C * Cᴴ = _ at hC
  have hdet : C.det ≠ 0 := by
    change (η * C.det).re ≠ 0 at hκ
    intro hz
    exact hκ (by simp [hz])
  have hunit : IsUnit C.det := isUnit_iff_ne_zero.mpr hdet
  have hcstar : Cᴴ = (r : ℂ) • C⁻¹ := calc
    Cᴴ = C⁻¹ * (C * Cᴴ) := (C.nonsing_inv_mul_cancel_left Cᴴ hunit).symm
    _ = _ := by rw [hC, Matrix.mul_smul, Matrix.mul_one]
  have hnormal : C * Cᴴ = Cᴴ * C := by
    rw [hC, hcstar, Matrix.smul_mul, C.nonsing_inv_mul hunit]
  have hskew : Eᴴ = -E := by
    apply eq_neg_of_add_eq_zero_left
    have hdecomp : Eᴴ + E =
        (C * Cᴴ - Cᴴ * C) - (A * Aᴴ - Aᴴ * A) + (B * Bᴴ - Bᴴ * B) := by
      simp only [E, C, Matrix.conjTranspose_sub, Matrix.conjTranspose_add,
        Matrix.conjTranspose_mul, Matrix.conjTranspose_conjTranspose, Matrix.mul_add,
        Matrix.add_mul]
      abel
    simp only [hdecomp, hnormal, hA, hB, sub_self, sub_zero, add_zero]
  have hscale : E = (r : ℂ) • D := by
    simp only [E, D, hcstar, Matrix.mul_smul, Matrix.smul_mul, smul_sub]
  rw [hscale, Matrix.conjTranspose_smul, Complex.star_def, Complex.conj_ofReal, ← smul_neg] at hskew
  exact commute_of_support_maximum_of_skew_inverse_commutator A B η hdet hκ
    (smul_right_injective _ (Complex.ofReal_ne_zero.mpr hr) hskew) hmax

end

end MOC
  let B (t : ℂ) (j : ι) := b j + t
  let K : Set ℂ := Set.range (fun k : Fin 2 => -a (e k)) ∪ Set.range (fun j : ι => -b j)
  have hK : Dense Kᶜ :=
    ((Set.finite_range _).union (Set.finite_range _)).countable.dense_compl ℂ
  have hgen : Set.EqOn
      (fun t => ∑ m ∈ s, (w m : ℂ) * matchingProduct (A t) (B t) (σ m))
      (fun t => determinantValue (A t) (B t) U) Kᶜ := by
    intro t ht
    have haT (i : ι) (hi : i ∉ Set.range e) : A t i = 0 := by simp [A, hi, ha i hi]
    have hx (k : Fin 2) : A t (e k) ≠ 0 := by
      intro h
      have heq : t = -a (e k) := by
        have hh : a (e k) + t = 0 := by simpa [A, Set.mem_range_self k] using h
        linear_combination hh
      exact ht (Or.inl ⟨k, heq.symm⟩)
    have hy (j : ι) : B t j ≠ 0 := by
      intro h
      have heq : t = -b j := by change b j + t = 0 at h; linear_combination h
      exact ht (Or.inr ⟨j, heq.symm⟩)
    let x (k : Fin 2) := A t (e k)
    let y := B t
    let D := diagonal x
    let E := U * diagonal y * Uᴴ
    let C := U * diagonal (fun j => (y j)⁻¹) * Uᴴ
    let Dinv := diagonal (fun k => (x k)⁻¹)
    let Γ := (∏ k, x k) * ∏ j, y j
    have hD : P * D * Pᴴ = diagonal (A t) := by
      ext i j : 1
      rw [Matrix.mul_apply, Matrix.diagonal_apply]
      simp only [D, Matrix.mul_diagonal, Matrix.conjTranspose_apply, hP]
      by_cases hij : i = j
      · subst j
        by_cases hi : i ∈ Set.range e
        · obtain ⟨k, rfl⟩ := hi
          rw [Finset.sum_eq_single k]
          · simp [x]
          · intro l _ hl
            simp [e.injective.ne hl]
          · simp
        · have hn (k : Fin 2) : e k ≠ i := fun he => hi ⟨k, he⟩
          simp [hn, haT i hi]
      · rw [if_neg hij]
        apply Finset.sum_eq_zero
        intro k _
        by_cases hk : e k = i
        · have hj : e k ≠ j := fun h => hij (hk.symm.trans h)
          simp [hk, hj]
        · simp [hk]
    have hEC : E * C = 1 := by
      calc
        _ = U * (diagonal y * (Uᴴ * U) * diagonal (fun j => (y j)⁻¹)) * Uᴴ := by
          simp only [E, C, Matrix.mul_assoc]
        _ = 1 := by
          rw [hU.2, Matrix.mul_one, Matrix.diagonal_mul_diagonal]
          simp [y, hy, mul_inv_cancel₀, hU.1]
    have hDD : D * Dinv = 1 := by
      simp [D, Dinv, x, Matrix.diagonal_mul_diagonal, hx, mul_inv_cancel₀]
    have hC : Pᴴ * C * P = Fᴴ * diagonal (fun j => (y j)⁻¹) * F := by
      simp only [C, F, Matrix.conjTranspose_mul, Matrix.conjTranspose_conjTranspose, Matrix.mul_assoc]
    have hbig : diagonal (A t) + E = E * (1 + (C * P) * (D * Pᴴ)) := by
      rw [Matrix.mul_add, Matrix.mul_one, ← Matrix.mul_assoc E (C * P),
        ← Matrix.mul_assoc E C, hEC, Matrix.one_mul, ← Matrix.mul_assoc P D, hD, add_comm]
    have hsmall : 1 + (D * Pᴴ) * (C * P) =
        D * (Dinv + Fᴴ * diagonal (fun j => (y j)⁻¹) * F) := by
      rw [Matrix.mul_add, hDD, ← hC]
      simp only [Matrix.mul_assoc]
    have hE_det : E.det = ∏ j, y j := by
      change (U * diagonal y * Uᴴ).det = _
      rw [det_unitary_conjugation U _ hU, Matrix.det_diagonal]
    have hD_det : D.det = ∏ k, x k := Matrix.det_diagonal
    have hdet : determinantValue (A t) (B t) U =
        Γ * (Dinv + Fᴴ * diagonal (fun j => (y j)⁻¹) * F).det := by
      change (diagonal (A t) + E).det = _
      rw [hbig, Matrix.det_mul E, Matrix.det_one_add_mul_comm (C * P) (D * Pᴴ),
        hsmall, Matrix.det_mul D, hE_det, hD_det]
      dsimp only [Γ]
      ring
    have hweights : (∑ m ∈ s, (w m : ℂ) *
        (((x m.val.1.1)⁻¹ + (y m.val.1.2)⁻¹) *
          ((x m.val.2.1)⁻¹ + (y m.val.2.2)⁻¹))) =
        (Dinv + Fᴴ * diagonal (fun j => (y j)⁻¹) * F).det by
      simpa only [Matrix.conjTranspose_one, Matrix.one_mul, Matrix.mul_one, Dinv] using
        hval (fun k => (x k)⁻¹) (fun j => (y j)⁻¹)
    change (∑ m ∈ s, (w m : ℂ) * matchingProduct (A t) (B t) (σ m)) = _
    rw [hdet, ← hweights, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro m _
    rw [matchingProduct_two_reciprocals _ _ e m _ (hσ m) haT hx hy]
    change (w m : ℂ) * (Γ * _) = Γ * ((w m : ℂ) * _)
    ring
  have hA : Continuous A := continuous_pi fun i => by
    by_cases hi : i ∈ Set.range e
    · simpa only [A, if_pos hi] using (continuous_const.add continuous_id :
        Continuous (fun t : ℂ => a i + t))
    · simpa only [A, if_neg hi] using (continuous_const : Continuous (fun _ : ℂ => a i))
  have hB : Continuous B := continuous_pi fun _ => continuous_const.add continuous_id
  have hcont₁ : Continuous (fun t => ∑ m ∈ s, (w m : ℂ) * matchingProduct (A t) (B t) (σ m)) := by
    apply continuous_finset_sum
    intro m _
    apply Continuous.const_mul
    unfold matchingProduct
    exact continuous_finset_prod _ fun j _ =>
      ((continuous_apply (σ m j)).comp hA).add ((continuous_apply j).comp hB)
  have hUconst : Continuous (fun _ : ℂ => U) := continuous_const
  have hUstar : Continuous (fun _ : ℂ => Uᴴ) := continuous_const
  have hcont₂ : Continuous (fun t => determinantValue (A t) (B t) U) :=
    (hA.matrix_diagonal.add
      ((hUconst.matrix_mul hB.matrix_diagonal).matrix_mul hUstar)).matrix_det
  have hzero := hgen.closure hcont₁ hcont₂ (hK 0)
  have hA₀ : A 0 = a := by funext i; by_cases hi : i ∈ Set.range e <;> simp [A, hi]
  have hB₀ : B 0 = b := by funext j; simp [B]
  change (∑ m ∈ s, (w m : ℂ) * matchingProduct (A 0) (B 0) (σ m)) =
    determinantValue (A 0) (B 0) U at hzero
  rw [hA₀, hB₀] at hzero
  let z (m : TwoEdgeMatching (Fin 2) ι) := matchingProduct a b (σ m)
  have hmem : s.centerMass w z ∈ convexHull ℝ (Set.range (matchingProduct a b)) :=
    s.centerMass_mem_convexHull hw (by rw [hs]; norm_num) (fun m _ => ⟨σ m, rfl⟩)
  rw [s.centerMass_eq_of_sum_1 z hs] at hmem
  simpa only [Holds, z, Complex.real_smul, hzero] using hmem

/-- MOC in any finite order when the first spectrum has a common value
outside at most two specified labels. -/
theorem holds_two_exceptions (a b : ι → ℂ) (U : Matrix ι ι ℂ) (hU : IsUnitary U)
    (i₀ i₁ : ι) (c : ℂ) (ha : ∀ i, i ≠ i₀ → i ≠ i₁ → a i = c) : Holds a b U := by
  by_cases hi : i₀ = i₁
  · subst i₁
    apply (holds_swap_iff a b hU).mp
    apply holds_one_exception b a Uᴴ ⟨by simpa using hU.2, by simpa using hU.1⟩ i₀ c
    exact fun i h => ha i h h
  · let e := pairEmbedding i₀ i₁ hi
    apply (holds_shift_iff a b hU (-c)).mp
    apply holds_of_two_supported _ _ U hU e
    intro i h
    have h₀ : i ≠ i₀ := fun he => h ⟨0, he.symm⟩
    have h₁ : i ≠ i₁ := fun he => h ⟨1, he.symm⟩
    simp [ha i h₀ h₁]

/-- The support-cardinality form also includes empty index types. -/
theorem holds_of_card_exceptions_le_two (a b : ι → ℂ) (U : Matrix ι ι ℂ)
    (hU : IsUnitary U) (c : ℂ) (h : (univ.filter (fun i => a i ≠ c)).card ≤ 2) :
    Holds a b U := by
  by_cases hι : Nonempty ι
  · letI := hι
    let S := univ.filter (fun i => a i ≠ c)
    have hc : S.card ≤ 2 := h
    have hp : ∃ i j : ι, S ⊆ {i, j} := by
      by_cases htwo : S.card = 2
      · obtain ⟨i, j, _, heq⟩ := Finset.card_eq_two.mp htwo
        exact ⟨i, j, heq.le⟩
      · obtain ⟨i, hi⟩ := Finset.card_le_one_iff_subset_singleton.mp (show S.card ≤ 1 by omega)
        exact ⟨i, i, by simpa using hi⟩
    obtain ⟨i, j, hs⟩ := hp
    apply holds_two_exceptions a b U hU i j c
    intro k hki hkj
    by_contra hkc
    have hk : k ∈ S := by simp [S, hkc]
    simpa [hki, hkj] using hs hk
  · haveI : IsEmpty ι := not_nonempty_iff.mp hι
    exact conjecture_of_subsingleton a b U hU

end

end MOC
import MOC.RankSum
import MOC.TwoFrame
import Mathlib.Data.Matrix.ColumnRowPartitioned
import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas

/-! Complementary-block compression of a sum supported on two frames. -/

open BigOperators Matrix
open scoped InnerProductSpace

namespace MOC

noncomputable section

variable {ι κ ρ σ : Type*}
  [Fintype ι] [DecidableEq ι] [Fintype κ] [DecidableEq κ]
  [Fintype ρ] [DecidableEq ρ] [Fintype σ] [DecidableEq σ]

/-- Two frames for a common subspace give the reciprocal determinant on that
subspace. The change of column labels places the complementary blocks in a
single square matrix. -/
theorem det_support_frames (e : ι ⊕ κ ≃ ρ ⊕ σ)
    (X : Matrix ι ρ ℂ) (Y : Matrix ι σ ℂ)
    (E : Matrix ρ κ ℂ) (F : Matrix σ κ ℂ)
    (hE : Eᴴ * E = 1) (hF : Fᴴ * F = 1) (hcommon : X * E = Y * F)
    (hG : IsUnit (X * Xᴴ + Y * Yᴴ).det)
    (a : ρ → ℂ) (b : σ → ℂ) (ha : ∀ i, a i ≠ 0) (hb : ∀ j, b j ≠ 0) :
    (X * diagonal a * Xᴴ + Y * diagonal b * Yᴴ).det =
      ((∏ i, a i) * ∏ j, b j) * ((X * Xᴴ + Y * Yᴴ).det / (2 : ℂ) ^ Fintype.card κ) *
        (Eᴴ * diagonal (fun i => (a i)⁻¹) * E + Fᴴ * diagonal (fun j => (b j)⁻¹) * F).det := by
  let s : ℂ := ((1 / 2 : ℝ) : ℂ) + ((1 / 2 : ℝ) : ℂ) * Complex.I
  have hs₀ : star s * s = ((1 / 2 : ℝ) : ℂ) := by
    apply Complex.ext <;> norm_num [s, Complex.star_def, Complex.mul_re, Complex.mul_im]
  have hs : star s * s = (2 : ℂ)⁻¹ := by simpa [one_div, Complex.ofReal_inv] using hs₀
  have hs' : s * star s = (2 : ℂ)⁻¹ := (mul_comm _ _).trans hs
  let W₀ := fromBlocks X Y (star s • Eᴴ) ((-star s) • Fᴴ)
  let W := W₀.submatrix id e
  have hreindex (L : Matrix (ρ ⊕ σ) (ρ ⊕ σ) ℂ) :
      W * L.submatrix e e * Wᴴ = W₀ * L * W₀ᴴ := by
    dsimp only [W]
    rw [Matrix.conjTranspose_submatrix, Matrix.submatrix_mul_equiv,
      Matrix.submatrix_mul_equiv] <;> rfl
  have hupper : X * (s • E) + Y * ((-s) • F) = 0 := by
    simp only [Matrix.mul_smul, hcommon, neg_smul, add_neg_cancel]
  have hlower : (star s • Eᴴ) * Xᴴ + ((-star s) • Fᴴ) * Yᴴ = 0 := by
    have h := congrArg Matrix.conjTranspose hupper
    simpa only [Matrix.conjTranspose_add, Matrix.conjTranspose_mul, Matrix.conjTranspose_smul,
      star_neg, Matrix.conjTranspose_zero] using h
  have hgram : W * Wᴴ = fromBlocks (X * Xᴴ + Y * Yᴴ) 0 0 (1 : Matrix κ κ ℂ) := by
    have h := hreindex (1 : Matrix (ρ ⊕ σ) (ρ ⊕ σ) ℂ)
    rw [Matrix.submatrix_one_equiv, Matrix.mul_one, Matrix.mul_one] at h
