/-- MOC in any finite order when the first spectrum has a common value
outside at most two specified labels. -/
theorem holds_two_exceptions (a b : ι → ℂ) (U : Matrix ι ι ℂ) (hU : IsUnitary U)
    (i₀ i₁ : ι) (c : ℂ) (ha : ∀ i, i ≠ i₀ → i ≠ i₁ → a i = c) : Holds a b U := by
  by_cases hi : i₀ = i₁
  · subst i₁
    apply (holds_swap_iff a b hU).mp
    apply holds_one_exception b a Uᴴ ⟨by simpa using hU.2, by simpa using hU.1⟩ i₀ c
    exact fun i h => ha i h h
  · let e := pairEmbedding i₀ i₁ hi
    apply (holds_shift_iff a b hU (-c)).mp
  have hf : (∏ j, f j) = (∏ i : {i // a i ≠ 0}, a i) * ∏ j : {j // b j ≠ 0}, b j := by
    have hp (c : ι → ℂ) : (∏ i, if c i = 0 then 1 else c i) = ∏ i : {i // c i ≠ 0}, c i := by
      apply Finset.prod_congr_set {i | c i ≠ 0}
      · intro i hi'
        exact if_neg hi'
      · intro i hi'
        apply if_pos
        simpa using hi'
    dsimp only [f]
    rw [Finset.prod_mul_distrib, Equiv.prod_comp τ (fun i => if a i = 0 then 1 else a i),
      hp a, hp b]
  have hg : (∏ j, g j) = ((a i₀)⁻¹ + (b j₀)⁻¹) * ((a i₁)⁻¹ + (b j₁)⁻¹) := by
    calc
      (∏ j, g j) = ∏ j ∈ J, g j := by
        symm
        apply Finset.prod_subset (Finset.subset_univ _)
        intro j _ hj'
        simp [g, hj']
      _ = _ := by rw [hJ, Finset.prod_pair hj]; simp [g, hJ₀, hJ₁, hτ₀, hτ₁]
  refine ⟨τ, ?_⟩
  unfold matchingProduct
  simp_rw [hv, Finset.prod_mul_distrib, hf, hg]

