    ext i j
    simp [L, R, Matrix.mul_apply, Matrix.vecMulVec_apply]
  have hRL : R * L = 1 := by
    ext i j
    have hij : i = j := Subsingleton.elim _ _
    subst j
    simp [L, R, Matrix.mul_apply, hv]
