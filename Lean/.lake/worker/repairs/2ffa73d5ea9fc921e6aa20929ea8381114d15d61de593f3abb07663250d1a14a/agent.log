private theorem exists_unitary_for_eigenvalue_compressions
    (h : ι → ℂ) (B : Matrix ι ι ℂ) (hB : B * Bᴴ = Bᴴ * B)
    (hA : (diagonal h - B) * (diagonal h - B)ᴴ = (diagonal h - B)ᴴ * (diagonal h - B)) :
