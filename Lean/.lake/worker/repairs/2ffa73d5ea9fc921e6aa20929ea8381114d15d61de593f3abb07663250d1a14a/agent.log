    { toFun := fun k => k.2.val
      invFun := fun i => ⟨⟨h i, ⟨i, rfl⟩⟩, ⟨i, rfl⟩⟩
      left_inv := by
        rintro ⟨⟨z, hz⟩, ⟨i, hi⟩⟩
