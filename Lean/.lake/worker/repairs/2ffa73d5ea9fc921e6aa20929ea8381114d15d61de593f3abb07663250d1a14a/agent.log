    ∃ (O : Matrix.orthogonalGroup (Fin 3) ℝ) (i : Fin 3) (b : Fin 3 → ℝ),
      (∀ j, 0 ≤ b j ∧ b j ≤ 1) ∧ b i = 0 ∧ (∑ j, b j) = 1 ∧
