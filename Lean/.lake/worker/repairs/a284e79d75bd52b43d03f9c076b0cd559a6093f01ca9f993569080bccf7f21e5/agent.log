      (∑ j, (Complex.normSq (u j) : ℂ)) * (star v ⬝ᵥ v) := calc
    _ = star v ⬝ᵥ ((Cᴴ * C) *ᵥ v) := by
      simp only [Matrix.star_mulVec, Matrix.dotProduct_mulVec, Matrix.vecMul_vecMul]
    _ ≤ star v ⬝ᵥ ((C * Cᴴ + Cᴴ * C) *ᵥ v) := by
      rw [Matrix.add_mulVec, dotProduct_add]
