import MOC.Collinear
import Mathlib.Tactic.Linarith

/-! Common inversion at tangency takes two signed spectral circles to parallel
lines. Circle-preserving perturbations handle eigenvalues at the inversion pole. -/

open scoped ComplexConjugate Topology

namespace MOC

noncomputable section

private theorem re_mul_inv_of_circle (u z : ℂ) (hz : z ≠ 0)
    (h : Complex.normSq (z - u) = Complex.normSq u) :
    (u * z⁻¹).re = 1 / 2 := by
  rw [Complex.normSq_sub] at h
  have hswap : (u * conj z).re = (z * conj u).re := by
    simp only [Complex.mul_re, Complex.conj_re, Complex.conj_im]
    ring
  have hre : (z * conj u).re = Complex.normSq z / 2 := by linarith
  have hn : Complex.normSq z ≠ 0 := mt Complex.normSq_eq_zero.mp hz
  rw [Complex.inv_def, ← mul_assoc, Complex.re_mul_ofReal, hswap, hre]
  field_simp [hn]

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

private theorem holds_of_constant_real_parts (a b : ι → ℂ) (u : ℂ) (hu : u ≠ 0)
    (s t : ℝ) (ha : ∀ i, (u * a i).re = s) (hb : ∀ i, (u * b i).re = t)
    (U : Matrix ι ι ℂ) (hU : IsUnitary U) : Holds a b U := by
  have hline (z : ℂ) (r : ℝ) (hr : (u * z).re = r) :
      u⁻¹ * Complex.I * ((u * z).im : ℂ) + u⁻¹ * (r : ℂ) = z := by
    calc
      _ = u⁻¹ * ((r : ℂ) + (u * z).im * Complex.I) := by ring
      _ = _ := by
        rw [← hr, Complex.re_add_im, ← mul_assoc, inv_mul_cancel₀ hu, one_mul]
  have hleft : (fun i => u⁻¹ * Complex.I * ((u * a i).im : ℂ) + u⁻¹ * (s : ℂ)) = a :=
    funext fun i => hline (a i) s (ha i)
  have hright : (fun i => u⁻¹ * Complex.I * ((u * b i).im : ℂ) + u⁻¹ * (t : ℂ)) = b :=
    funext fun i => hline (b i) t (hb i)
  simpa only [hleft, hright] using
    holds_of_parallel_affine_lines (fun i => (u * a i).im) (fun i => (u * b i).im)
      (u⁻¹ * Complex.I) (u⁻¹ * (s : ℂ)) (u⁻¹ * (t : ℂ)) U hU

private theorem holds_of_tangent_circles_at_zero_of_nonzero (a c : ι → ℂ)
    (u : ℂ) (r : ℝ) (hu : u ≠ 0) (hr : r ≠ 0)
    (ha : ∀ i, Complex.normSq (a i - u) = Complex.normSq u)
    (hc : ∀ i, Complex.normSq (c i - (r : ℂ) * u) = Complex.normSq ((r : ℂ) * u))
    (han : ∀ i, a i ≠ 0) (hcn : ∀ i, c i ≠ 0)
    (U : Matrix ι ι ℂ) (hU : IsUnitary U) : Holds a (fun i => -c i) U := by
  apply (holds_inv_iff a c U hU han hcn).mp
  apply holds_of_constant_real_parts _ _ u hu (1 / 2) (-(1 / 2) / r) _ _ U hU
  · exact fun i => re_mul_inv_of_circle u (a i) (han i) (ha i)
  · intro i
    have h := re_mul_inv_of_circle ((r : ℂ) * u) (c i) (hcn i) (hc i)
    rw [mul_assoc, Complex.re_ofReal_mul] at h
    rw [mul_neg, Complex.neg_re]
    apply (eq_div_iff hr).mpr
    rw [neg_mul, mul_comm _ r, h]

private def circleRotation (t : ℝ) : ℂ :=
  (1 + (t : ℂ) * Complex.I) / (1 - (t : ℂ) * Complex.I)

private theorem circleRotation_denominator_ne (t : ℝ) :
    1 - (t : ℂ) * Complex.I ≠ 0 := by
  intro h
  simpa [Complex.mul_re] using congrArg Complex.re h

private theorem continuous_circleRotation : Continuous circleRotation := by
  unfold circleRotation
  have h : Continuous (fun t : ℝ => (t : ℂ) * Complex.I) :=
    Complex.continuous_ofReal.mul continuous_const
  exact (continuous_const.add h).div (continuous_const.sub h) circleRotation_denominator_ne

private theorem circleRotation_normSq (t : ℝ) : Complex.normSq (circleRotation t) = 1 := by
  have h : Complex.normSq (1 + (t : ℂ) * Complex.I) =
      Complex.normSq (1 - (t : ℂ) * Complex.I) := by
    simp [Complex.normSq, Complex.mul_re, Complex.mul_im]
  rw [circleRotation, Complex.normSq_div, h]
  exact div_self (mt Complex.normSq_eq_zero.mp (circleRotation_denominator_ne t))

private theorem circleRotation_ne_one {t : ℝ} (ht : t ≠ 0) : circleRotation t ≠ 1 := by
  intro h
  have he : 1 + (t : ℂ) * Complex.I = 1 - (t : ℂ) * Complex.I := by
    simpa only [one_mul] using (div_eq_iff (circleRotation_denominator_ne t)).mp h
  apply ht
  have hi := congrArg Complex.im he
  simp [Complex.mul_im] at hi
  linarith

private def moveCirclePole (u z : ℂ) (t : ℝ) : ℂ :=
  if z = 0 then u - circleRotation t * u else z

private theorem continuous_moveCirclePole (u z : ℂ) : Continuous (moveCirclePole u z) := by
  by_cases hz : z = 0
  · simpa only [moveCirclePole, hz, if_true] using
      continuous_const.sub (continuous_circleRotation.mul (continuous_const : Continuous fun _ : ℝ => u))
  · simpa only [moveCirclePole, hz, if_false] using (continuous_const : Continuous fun _ : ℝ => z)

private theorem moveCirclePole_zero (u z : ℂ) : moveCirclePole u z 0 = z := by
  by_cases hz : z = 0 <;> simp [moveCirclePole, circleRotation, hz]

private theorem moveCirclePole_normSq (u z : ℂ) (t : ℝ)
    (h : Complex.normSq (z - u) = Complex.normSq u) :
    Complex.normSq (moveCirclePole u z t - u) = Complex.normSq u := by
  by_cases hz : z = 0
  · have he : moveCirclePole u z t - u = -(circleRotation t * u) := by
      simp only [moveCirclePole, hz, if_true]
      ring
    rw [he, Complex.normSq_neg, Complex.normSq_mul, circleRotation_normSq, one_mul]
  · simpa only [moveCirclePole, hz, if_false] using h

private theorem moveCirclePole_ne_zero (u z : ℂ) (hu : u ≠ 0) {t : ℝ} (ht : t ≠ 0) :
    moveCirclePole u z t ≠ 0 := by
  by_cases hz : z = 0
  · simp only [moveCirclePole, hz, if_true]
    intro he
    apply circleRotation_ne_one ht
    apply mul_right_cancel₀ hu
    simpa only [one_mul] using (sub_eq_zero.mp he).symm
  · simpa only [moveCirclePole, hz, if_false] using hz

private theorem holds_of_tangent_circles_at_zero (a c : ι → ℂ)
    (u : ℂ) (r : ℝ) (hu : u ≠ 0) (hr : r ≠ 0)
    (ha : ∀ i, Complex.normSq (a i - u) = Complex.normSq u)
    (hc : ∀ i, Complex.normSq (c i - (r : ℂ) * u) = Complex.normSq ((r : ℂ) * u))
    (U : Matrix ι ι ℂ) (hU : IsUnitary U) : Holds a (fun i => -c i) U := by
  by_contra hfail
  rw [holds_iff_directional, not_forall] at hfail
  obtain ⟨k, hk⟩ := hfail
  push_neg at hk
  let a' (t : ℝ) (i : ι) := moveCirclePole u (a i) t
  let c' (t : ℝ) (i : ι) := moveCirclePole ((r : ℂ) * u) (c i) t
  have ha₀ : a' 0 = a := funext fun i => moveCirclePole_zero u (a i)
  have hc₀ : c' 0 = c := funext fun i => moveCirclePole_zero ((r : ℂ) * u) (c i)
  have hca : Continuous a' := continuous_pi fun i => continuous_moveCirclePole u (a i)
  have hcc : Continuous c' := continuous_pi fun i => continuous_moveCirclePole ((r : ℂ) * u) (c i)
  have hd : Continuous (fun t => (k * determinantValue (a' t) (fun i => -c' t i) U).re) := by
    unfold determinantValue
    fun_prop
  have hm (σ : Equiv.Perm ι) :
      apply nhdsWithin_eq_iff_eventuallyEq.mpr
      filter_upwards [hT] with z hz
      apply propext
      simpa only [mem_preimage, mem_compl_iff, mem_singleton_iff] using hlocal z hz
    have hmap : map e.symm (𝓝[≠] c) = 𝓝[Sᶜ] x := by
      have h := map_extChartAt_symm_nhdsWithin (I := 𝓘(ℂ, ℂ)) (s := Sᶜ) x
      rw [hrange, inter_univ] at h
      change map e.symm (𝓝[e.symm ⁻¹' Sᶜ] c) = 𝓝[Sᶜ] x at h
      rwa [hnhds] at h
    have hlim :
        limUnder (𝓝[≠] c) (f ∘ e.symm) = limUnder (𝓝[Sᶜ] x) f := by
      unfold limUnder
      rw [← Filter.map_map, hmap]
    apply (mdifferentiableAt_iff_source_of_mem_source (I := 𝓘(ℂ, ℂ))
      (I' := 𝓘(ℂ, ℂ)) (mem_chart_source ℂ x)).2
    rw [hrange, mdifferentiableWithinAt_univ, mdifferentiableAt_iff_differentiableAt]
    change DifferentiableAt ℂ (F ∘ e.symm) c
    apply ((Complex.differentiableOn_update_limUnder_of_bddAbove hT hd hbound)
      .differentiableAt hT).congr_of_eventuallyEq
    filter_upwards [hT] with z hz
    by_cases hzc : z = c
    · subst z
      simp only [Function.comp_apply, hcenter, F, if_pos hx, update_self, hlim]
    · have hzS : e.symm z ∉ S := (hlocal z hz).2 hzc
      simp only [Function.comp_apply, F, if_neg hzS, update_of_ne hzc]
  · apply (hf.mdifferentiableAt (hopen.mem_nhds (show x ∈ Sᶜ from hx))).congr_of_eventuallyEq
    filter_upwards [hopen.mem_nhds (show x ∈ Sᶜ from hx)] with y hy
    exact if_neg (show y ∉ S from hy)

variable [CompactSpace M] [PreconnectedSpace M]

/-- A holomorphic function on the complement of a finite set in a compact
connected complex surface cannot be nonconstant and take all its values
in the closed right half-plane. -/
theorem eqOn_of_re_nonneg_off_finite {S : Set M} (hS : S.Finite)
    {f : M → ℂ} (hf : MDifferentiableOn 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) f Sᶜ)
    (hre : ∀ x ∈ Sᶜ, 0 ≤ (f x).re) {x y : M} (hx : x ∈ Sᶜ) (hy : y ∈ Sᶜ) :
    f x = f y := by
  let g (x : M) := (1 + f x)⁻¹
  have hopen : IsOpen Sᶜ := hS.isClosed.isOpen_compl
  have hpos (x : M) (hx : x ∈ Sᶜ) : 1 ≤ (1 + f x).re := by
    simpa only [Complex.add_re, Complex.one_re, add_zero] using add_le_add_left (hre x hx) 1
  have hg : MDifferentiableOn 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) g Sᶜ := by
    intro z hz
    have hn : (1 + f z : ℂ) ≠ 0 := by
      intro h
      have h' := hpos z hz
      rw [h, Complex.zero_re] at h'
      exact (not_le_of_gt zero_lt_one) h'
    have hd : DifferentiableAt ℂ (fun w : ℂ => (1 + w)⁻¹) (f z) :=
      (differentiableAt_id.const_add (1 : ℂ)).inv hn
    exact (hd.mdifferentiableAt.comp z (hf.mdifferentiableAt (hopen.mem_nhds hz)))
      .mdifferentiableWithinAt
  have hbounded (z : M) (hz : z ∈ Sᶜ) : ‖g z‖ ≤ 1 := by
    rw [g, norm_inv]
    exact inv_le_one_of_one_le₀ ((hpos z hz).trans (Complex.re_le_norm _))
  obtain ⟨G, hG, hEq⟩ := exists_holomorphic_extension_off_finite hS hg 1 hbounded
  have he : g x = g y := (hEq hx).symm.trans ((hG.apply_eq_of_compactSpace x y).trans (hEq hy))
  have he' : 1 + f x = 1 + f y := by
    simpa only [g, inv_inv] using congrArg (fun z : ℂ => z⁻¹) he
  exact add_left_cancel he'

/-- On a supplied compactified curve, a finite family of initially positive
gaps acquires a zero while the other gaps stay nonnegative, provided one
gap function varies on the connected punctured curve. -/
theorem exists_new_contact_on_curve {ι : Type*} (J : Finset ι) {S : Set M} (hS : S.Finite)
    (hconn : IsPreconnected Sᶜ) (H : ι → M → ℂ)
    (hhol : ∀ i ∈ J, MDifferentiableOn 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) (H i) Sᶜ)
    {x₀ : M} (hx₀ : x₀ ∈ Sᶜ) (hstart : ∀ i ∈ J, 0 < (H i x₀).re)
    (hvar : ∃ i ∈ J, ∃ x ∈ Sᶜ, ∃ y ∈ Sᶜ, H i x ≠ H i y) :
    ∃ z ∈ Sᶜ, (∀ i ∈ J, 0 ≤ (H i z).re) ∧ ∃ i ∈ J, (H i z).re = 0 := by
  obtain ⟨i, hi, x, hx, y, hy, hxy⟩ := hvar
  have hnegative : ∃ w ∈ Sᶜ, (H i w).re < 0 := by
    by_contra! h
    exact hxy (eqOn_of_re_nonneg_off_finite hS (hhol i hi) h hx hy)
  obtain ⟨w, hw, hwi⟩ := hnegative
  let Jne : J.Nonempty := ⟨i, hi⟩
  let m (z : M) : ℝ := J.inf' Jne (fun j => (H j z).re)
  have hm : ContinuousOn m Sᶜ :=
    ContinuousOn.finset_inf'_apply (f := fun j z => (H j z).re) Jne
      (fun j hj => Complex.continuous_re.comp_continuousOn (hhol j hj).continuousOn)
  have hmw : m w < 0 := (Finset.inf'_lt_iff Jne).2 ⟨i, hi, hwi⟩
  have hm₀ : 0 < m x₀ := (Finset.lt_inf'_iff Jne).2 hstart
  have hz : (0 : ℝ) ∈ m '' Sᶜ :=
    (hconn.image _ hm).Icc_subset ⟨w, hw, rfl⟩ ⟨x₀, hx₀, rfl⟩ ⟨hmw.le, hm₀.le⟩
  obtain ⟨z, hzS, hmz⟩ := hz
  have hzle : ∀ j ∈ J, 0 ≤ (H j z).re := by
    apply (Finset.le_inf'_iff Jne).1
    change 0 ≤ m z
    exact hmz.ge
  obtain ⟨j, hj, he⟩ := Finset.exists_mem_eq_inf' Jne (fun k => (H k z).re)
  exact ⟨z, hzS, hzle, j, hj, he.symm.trans hmz⟩

open scoped BigOperators

/-- The spectral contact step preserves every old contact and the strict
determinant support gap on a supplied compactified deformation curve. -/
theorem exists_new_matching_contact_on_curve {ι : Type*} [Fintype ι] [DecidableEq ι]
    {S : Set M} (hS : S.Finite) (hconn : IsPreconnected Sᶜ)
    (a b : M → ι → ℂ) (U : Matrix ι ι ℂ) (η : ℂ) (r : Equiv.Perm ι)
    (J : Finset (Equiv.Perm ι))
    (A + B + C + D).det =
      (A + B).det + (A + C).det + (A + D).det + (B + C).det + (B + D).det + (C + D).det := by
  have h :
      (A + B + C + D).det + 2 * (A.det + B.det + C.det + D.det) =
        (A + B).det + (A + C).det + (A + D).det + (B + C).det + (B + D).det + (C + D).det := by
    simp only [Matrix.det_fin_two, Matrix.add_apply]
    ring
  simpa only [hA, hB, hC, hD, add_zero, mul_zero] using h

private theorem determinantValue_householder_four_regular (a b v : Fin 4 → ℂ)
    (hv : ∑ i, star (v i) * v i = 1) (hreg : ∀ i, a i + b i ≠ 0) :
    determinantValue a b (rankOnePhase v (-1)) = fourSignedDet a b (fun i => Complex.normSq (v i)) := by
  let p (i : Fin 4) := Complex.normSq (v i)
  let m (i : Fin 4) := a i + b i
  let q (i : Fin 4) := (p i : ℂ) / m i
  let Q (i : Fin 4) : Matrix (Fin 2) (Fin 2) ℂ :=
    !![q i * a i, q i; q i * a i * b i, q i * b i]
  have hp (i : Fin 4) : (p i : ℂ) = star (v i) * v i :=
    Complex.normSq_eq_conj_mul_self
  have hN : rankOneSpectralCompression a b v = ∑ i, Q i := by
    ext r s
    fin_cases r <;> fin_cases s <;>
      simp [rankOneSpectralCompression, Q, q, m, Matrix.sum_apply, ← hp] <;>
      apply Finset.sum_congr rfl <;> intro k _ <;> ring
  have hQ (i : Fin 4) : (Q i).det = 0 := by
    simp [Q, Matrix.det_fin_two] <;> ring
  have hpairs (i j : Fin 4) (hij : i ≠ j) :
      (∏ k, m k) * (Q i + Q j).det =
        (p i : ℂ) * (p j : ℂ) * (matchingProduct a b 1 - matchingProduct a b (Equiv.swap i j)) := by
    let R := ∏ k ∈ (Finset.univ.erase i).erase j, m k
    have hid : matchingProduct a b 1 = m i * m j * R := by
      ((continuous_apply (σ i)).comp hcA).add continuous_const
  have hf : Continuous f := by unfold f determinantValue; fun_prop
  have hg : Continuous g := by
    unfold g fourSignedDet
    exact (hm 1).add (continuous_finset_sum _ fun j _ =>
      continuous_const.mul ((hm (fourSwap j)).sub (hm 1)))
  have hzero := hfg.closure hf hg (hK 0)
  have hA : A 0 = a := by funext i; simp [A]
  simpa only [f, g, hA] using hzero

private def fourTriangleEdges (i : Fin 4) : Fin 3 → Fin 6 :=
  ![![3, 4, 5], ![1, 2, 5], ![0, 2, 4], ![0, 1, 3]] i

private def fourCycle (i : Fin 4) (reverse : Bool) : Equiv.Perm (Fin 4) :=
  let first := fourSwap (fourTriangleEdges i 0)
  let last := fourSwap (fourTriangleEdges i 2)
  if reverse then last * first else first * last

private theorem matchingProduct_fourCycle_sum (a b : Fin 4 → ℂ) (i : Fin 4) :
    matchingProduct a b (fourCycle i false) + matchingProduct a b (fourCycle i true) =
      (∑ j : Fin 3, matchingProduct a b (fourSwap (fourTriangleEdges i j))) -
        matchingProduct a b 1 := by
  fin_cases i <;>
    norm_num [matchingProduct, Fin.sum_univ_three, Fin.prod_univ_four, fourCycle, fourPair,
      fourSwap, fourTriangleEdges, Equiv.Perm.mul_apply, Equiv.swap_apply_def, Fin.ext_iff] <;> ring

/-- A Householder reflection in order four satisfies the determinant hull inclusion.
The weights from the triangle packing depend only on the reflecting vector. -/
theorem holds_householder_four (a b v : Fin 4 → ℂ) (hv : ∑ i, star (v i) * v i = 1) :
    Holds a b (rankOnePhase v (-1)) := by
  let p (i : Fin 4) := Complex.normSq (v i)
      | exact hr 5
      | exact ht 0
      | exact ht 1
      | exact ht 2
      | exact ht 3
  · simp [w, wId, r, Fin.sum_univ_succ, Fin.sum_univ_zero] <;> ring
  · rw [determinantValue_householder_four a b v hv]
    change _ = fourSignedDet a b p
    have C (i : Fin 4) :=
