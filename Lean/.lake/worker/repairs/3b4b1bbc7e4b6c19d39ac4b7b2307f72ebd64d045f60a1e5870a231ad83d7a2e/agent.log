import Mathlib.Order.Fin.Basic
import Mathlib.Tactic.Linarith

/-! The hull inclusion for interlacing lists in Shitov's determinant argument
(2025, Lemma 17, doi:10.4213/im9292e). -/

open BigOperators Matrix


