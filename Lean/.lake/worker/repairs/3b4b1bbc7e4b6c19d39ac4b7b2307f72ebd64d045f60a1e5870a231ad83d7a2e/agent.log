import MOC.PhaseMove
import MOC.SchurPhase
import Mathlib.LinearAlgebra.Matrix.SchurComplement

/-! A phase at the first vector of a Schur basis. The first column of the
initial sum has zero entries below its pivot, but the first row can couple
to the remaining block. -/

open BigOperators Matrix

namespace MOC


==> MOC/SpectralStationarity.lean <==
import MOC.Support
import Mathlib.Analysis.Calculus.Deriv.Slope
import Mathlib.Analysis.InnerProductSpace.Dual
import Mathlib.Tactic.Linarith

/-! First variation of the smallest support deficit over a finite set of matchings. -/

open BigOperators Filter Matrix
open scoped ComplexConjugate InnerProductSpace Topology

namespace MOC

  let ⟨f, _u, v, ha, hst, hb⟩ :=
    geometric_hahn_banach_compact_closed (convex_singleton x) isCompact_singleton ht₁ ht₂
      (disjoint_singleton_left.2 disj)
  ⟨f, v, hst.trans' <| ha x <| mem_singleton _, hb⟩

theorem geometric_hahn_banach_closed_point (hs₁ : Convex ℝ s) (hs₂ : IsClosed s) (disj : x ∉ s) :
    ∃ (f : E →L[ℝ] ℝ) (u : ℝ), (∀ a ∈ s, f a < u) ∧ u < f x :=
  let ⟨f, s, _t, ha, hst, hb⟩ :=
