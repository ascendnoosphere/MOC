    spectralEnergy (fun i => a i + t) (fun j => b j - t) =
      spectralEnergy a b - Complex.normSq S / N := by
  intro S N t
  have hN : N ≠ 0 := by
    dsimp only [N]
    exact mul_ne_zero two_ne_zero (Nat.cast_ne_zero.mpr Fintype.card_ne_zero)
