    change (S * conj (-S / (N : ℂ))).re = _
    rw [map_div₀, map_neg, Complex.conj_ofReal, ← mul_div_assoc, mul_neg,
      Complex.mul_conj, ← Complex.ofReal_neg, ← Complex.ofReal_div, Complex.ofReal_re]
  rw [spectralEnergy_shift]
  change spectralEnergy a b + N * Complex.normSq t + 2 * (S * star t).re =
    spectralEnergy a b - Complex.normSq S / N
  rw [hsq, hprod]
  field_simp [hN] <;> ring

/-- Centered fractional-linear changes give a stronger energy-denominator
test at a positive gap maximum than uncentered changes. -/
theorem spectralEnergy_centered_mobius_bound [Nonempty ι]
    (a b : ι → ℂ) (U : Matrix ι ι ℂ) (hU : IsUnitary U)
    (η : ℂ) (hη : Complex.normSq η = 1) {g : ℝ} (hg : 0 < g)
    (hgap : ∀ σ : Equiv.Perm ι,
      g ≤ (η * (determinantValue a b U - matchingProduct a b σ)).re)
    (hmax : ∀ (c d : ι → ℂ) (k : ℂ), spectralEnergy c d ≤ 1 → Complex.normSq k = 1 →
      ∃ σ : Equiv.Perm ι, (k * (determinantValue c d U - matchingProduct c d σ)).re ≤ g)
    (t : ℂ) (ha : ∀ i, 1 - t * a i ≠ 0) (hb : ∀ j, 1 + t * b j ≠ 0) :
    let c := mobiusSpectrum t a
    let d := mobiusSpectrum (-t) b
    let E := spectralEnergy c d -
      Complex.normSq ((∑ i, c i) - ∑ j, d j) / (2 * (Fintype.card ι : ℝ))
import MOC.HouseholderFour
import MOC.Support
import Mathlib.Data.Real.Sqrt
import Mathlib.LinearAlgebra.Dimension.Constructions

/-! A four-label support reduction for the rank-one phase determinant. -/

open BigOperators Matrix

namespace MOC

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

private theorem simplex_step (y : ι → Fin 3 → ℝ) (score p : ι → ℝ)
    (hp : ∀ i, 0 ≤ p i) (hmass : ∑ i, p i = 1)
    (hlarge : 4 < (Finset.univ.filter fun i => p i ≠ 0).card) :
    ∃ q : ι → ℝ, (∀ i, 0 ≤ q i) ∧ (∑ i, q i) = 1 ∧
      (∀ j, (∑ i, q i * y i j) = ∑ i, p i * y i j) ∧
      (∑ i, p i * score i) ≤ (∑ i, q i * score i) ∧
      (Finset.univ.filter fun i => q i ≠ 0).card <
        (Finset.univ.filter fun i => p i ≠ 0).card := by
  classical
  let S := Finset.univ.filter fun i => p i ≠ 0
  let Y (i : ι) : Fin 4 → ℝ := Fin.cons 1 (y i)
  have hdep : ¬LinearIndependent ℝ (fun i : S => Y i) := by
    intro h
    have hc : S.card ≤ 4 := by
      simpa [Module.finrank_fin_fun] using h.fintype_card_le_finrank
    exact (not_le_of_gt hlarge) hc
  obtain ⟨g, hg, k, hk⟩ := Fintype.not_linearIndependent_iff.mp hdep
  let c (i : ι) := if h : i ∈ S then g ⟨i, h⟩ else 0
  have hcz (i : ι) (hi : i ∉ S) : c i = 0 := dif_neg hi
  have hcS : (∑ i, c i • Y i) = 0 := calc
    _ = ∑ i ∈ S, c i • Y i :=
      (Finset.sum_subset (Finset.subset_univ S)
        (fun i _ hi => by rw [hcz i hi, zero_smul])).symm
    _ = ∑ i : S, c i • Y i := (Finset.sum_coe_sort (fun i => c i • Y i) S).symm
    _ = 0 := by simpa only [c, dif_pos Subtype.property] using hg
  have hcs : (∑ i, c i) = 0 := by
    simpa only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Y, Fin.cons_zero, mul_one,
      Pi.zero_apply] using congrFun hcS 0
  have hcy (j : Fin 3) : (∑ i, c i * y i j) = 0 := by
    simpa only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Y, Fin.cons_succ, Pi.zero_apply]
      using congrFun hcS j.succ
  let T : ℝ := ∑ i, c i * score i
  let r : ℝ := if 0 ≤ T then 1 else -1
  let d (i : ι) := r * c i
  have hr : r ≠ 0 := by dsimp [r]; split_ifs <;> norm_num
  have hds (f : ι → ℝ) : (∑ i, d i * f i) = r * ∑ i, c i * f i := by
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl fun i _ => mul_assoc r (c i) (f i)
  have hd0 : (∑ i, d i) = 0 := by
    simpa only [mul_one, hcs, mul_zero] using hds (fun _ => 1)
  have hdy (j : Fin 3) : (∑ i, d i * y i j) = 0 := by rw [hds, hcy, mul_zero]
  have hdscore : 0 ≤ ∑ i, d i * score i := by
    rw [hds]
    change 0 ≤ r * T
    dsimp only [r]
    split_ifs with h
    · simpa using h
    (hp : ∀ i, 0 ≤ p i) (hmass : ∑ i, p i = 1) :
    ∃ q : ι → ℝ, (∀ i, 0 ≤ q i) ∧ (∑ i, q i) = 1 ∧
      signed_mean_square x y p ≤ signed_mean_square x y q ∧
      (Finset.univ.filter fun i => q i ≠ 0).card ≤ 4 := by
  let X (w : ι → ℝ) (j : Fin 3) := ∑ i, w i * x i j
  let score (i : ι) := ∑ j, X p j * x i j
  have hpair (w : ι → ℝ) :
      (∑ i, w i * score i) = ∑ j, X p j * X w j := by
    simp only [score, X, Finset.mul_sum]
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro j _
    apply Finset.sum_congr rfl
    intro i _
    ring
  obtain ⟨q, hq, hqm, hqy, hscore, hqcard⟩ := exists_four_label_weights y score p hp hmass
  refine ⟨q, hq, hqm, ?_, hqcard⟩
  rw [hpair p, hpair q] at hscore
  have hs : 0 ≤ ∑ j, (X q j - X p j)^2 := Finset.sum_nonneg (fun _ _ => sq_nonneg _)
  unfold signed_mean_square
  simp only [hqy]
  change (∑ j, (X p j)^2 - (∑ i, p i * y i j)^2) ≤
    ∑ j, (X q j)^2 - (∑ i, p i * y i j)^2
  simp only [Fin.sum_univ_three] at hs hscore ⊢
  nlinarith

private def pairCompression (a b : ℂ) : Matrix (Fin 2) (Fin 2) ℂ :=
  Matrix.of fun i j => (if i = 0 then 1 else b) * (a + b)⁻¹ * (if j = 0 then a else 1)

    apply Finset.sum_congr rfl
    intro i _
    ring
  have htr : N 0 0 + N 1 1 = 1 := rankOneSpectralCompression_diagonal_sum a b v hv hreg
  have hQ : w^2 * (1 - 4 * N.det) = ∑ j, (w * traceCoordinates N j)^2 := by
    rw [Matrix.det_fin_two, Fin.sum_univ_three]
    change _ = (w * (N 0 0 - N 1 1))^2 + (w * (N 0 1 + N 1 0))^2 +
      (w * (Complex.I * (N 0 1 - N 1 0)))^2
    linear_combination -(w^2 * (N 0 0 + N 1 1 + 1)) * htr -
      (w^2 * (N 0 1 - N 1 0)^2) * Complex.I_sq
  have hdet : η * determinantValue a b (rankOnePhase v (-1)) =
      ∑ j, (w * traceCoordinates N j)^2 := by
    rw [determinantValue_rankOnePhase a b v (-1) hv (by simp) hreg, ← mul_assoc]
    change (η * matchingProduct a b 1) * _ = _
    rw [← hw, ← hQ]
    norm_num [star_neg, star_one]
  have hRe (j : Fin 3) :
      (w * traceCoordinates N j).re = ∑ i, Complex.normSq (v i) * (C i j).re := by
    rw [hM j]
private theorem holds_rankOnePhase_of_support (a b v : ι → ℂ) (z : ℂ) (S : Finset ι)
    (hS : S.card ≤ 4) (hv : ∑ i, star (v i) * v i = 1) (hz : z * star z = 1)
    (hzero : ∀ i ∉ S, v i = 0) : Holds a b (rankOnePhase v z) := by
  classical
  let T := {i : ι // i ∉ S}
  let e : S ⊕ T ≃ ι := Equiv.sumCompl (fun i => i ∈ S)
  let a₁ (i : S) := a i
  let b₁ (i : S) := b i
  let a₂ (i : T) := a i
  let b₂ (i : T) := b i
  let v₁ (i : S) := v i
  have hv₁ : ∑ i, star (v₁ i) * v₁ i = 1 := calc
    _ = ∑ i ∈ S, star (v i) * v i := Finset.sum_coe_sort _ _
    _ = ∑ i, star (v i) * v i := Finset.sum_subset (Finset.subset_univ S)
      (fun i _ hi => by simp [hzero i hi])
    _ = 1 := hv
  have hV : Holds a₁ b₁ (rankOnePhase v₁ z) :=
    holds_rankOnePhase_of_card_le_four _ _ _ _ (by simpa using hS) hv₁ hz
  have hblock : (rankOnePhase v z).submatrix e e =
      fromBlocks (rankOnePhase v₁ z) 0 0 (1 : Matrix T T ℂ) := by
    ext i j : 1
    rcases i with i | i <;> rcases j with j | j
    · simp [e, v₁, rankOnePhase, Matrix.one_apply, Matrix.vecMulVec_apply, Subtype.ext_iff]
    · have hn : (i : ι) ≠ j := fun h => j.property (h ▸ i.property)
      simp [e, rankOnePhase, Matrix.one_apply_ne hn, Matrix.vecMulVec_apply, hzero j j.property]
    · have hn : (i : ι) ≠ j := fun h => i.property (h.symm ▸ j.property)
      simp [e, rankOnePhase, Matrix.one_apply_ne hn, Matrix.vecMulVec_apply, hzero i i.property]
    · simp [e, rankOnePhase, Matrix.one_apply, Matrix.vecMulVec_apply, Subtype.ext_iff,
        hzero i i.property]
  have ha : a ∘ e = Sum.elim a₁ a₂ := by funext j; cases j <;> rfl
  have hb : b ∘ e = Sum.elim b₁ b₂ := by funext j; cases j <;> rfl
  apply (holds_reindex_iff e e a b (rankOnePhase v z)).mp
  rw [ha, hb, hblock]
  exact holds_directSum _ _ _ _ _ _ hV (holds_identity a₂ b₂)
private theorem matchingProduct_mem_determinantRange (a b : ι → ℂ) (σ : Equiv.Perm ι) :
    matchingProduct a b σ ∈ determinantRange a b := by
  have hright (τ : Equiv.Perm ι) :
      τ.permMatrix ℂ * (τ.permMatrix ℂ)ᴴ = 1 := by
    simpa only [Matrix.mul_one, Matrix.submatrix_one_equiv] using
      permMatrix_conjugates τ (1 : Matrix ι ι ℂ)
  have hu (τ : Equiv.Perm ι) : IsUnitary (τ.permMatrix ℂ) := by
    refine ⟨hright τ, ?_⟩
    rw [Matrix.conjTranspose_permMatrix]
    simpa only [Matrix.conjTranspose_permMatrix, inv_inv] using hright τ⁻¹
  refine ⟨σ.symm.permMatrix ℂ, hu σ.symm, ?_⟩
  rw [determinantValue, permMatrix_conjugates, Matrix.submatrix_diagonal_equiv,
    Matrix.diagonal_add, Matrix.det_diagonal]
  simpa only [Function.comp_apply, Equiv.symm_symm] using (matchingProduct_inverse a b σ.symm).symm

/-- A determinant support violation has a unitary witness with a quadratic
support penalty. A Frobenius maximizer among its support ties retains that penalty. -/
theorem exists_quadratic_support_frobenius_maximizer (a b : ι → ℂ)
    (U : Matrix ι ι ℂ) (hU : IsUnitary U) (η : ℂ)
    (hsep : ∀ σ : Equiv.Perm ι,
      (η * matchingProduct a b σ).re < (η * determinantValue a b U).re) :
    ∃ V : Matrix ι ι ℂ, ∃ ξ : ℂ, IsUnitary V ∧
      (∀ σ : Equiv.Perm ι,
        (ξ * matchingProduct a b σ).re < (ξ * determinantValue a b V).re) ∧
      (∀ W : Matrix ι ι ℂ, IsUnitary W →
        (ξ * (determinantValue a b W - determinantValue a b V)).re ≤
        -Complex.normSq (determinantValue a b W - determinantValue a b V) / 2) ∧
      ∀ W : Matrix ι ι ℂ, IsUnitary W →
        (ξ * determinantValue a b W).re = (ξ * determinantValue a b V).re →
        frobeniusSq (diagonal a + W * diagonal b * Wᴴ) ≤
          frobeniusSq (diagonal a + V * diagonal b * Vᴴ) := by
  classical
  have hc : Continuous (determinantValue a b) := by unfold determinantValue; fun_prop
  have hK : IsCompact (determinantRange a b) :=
    isCompact_setOf_isUnitary.image hc
  have hP : Set.range (matchingProduct a b) ⊆ determinantRange a b := by
    rintro _ ⟨σ, rfl⟩
    exact matchingProduct_mem_determinantRange a b σ
  obtain ⟨σ₀, _, hσ₀⟩ := Finset.exists_max_image Finset.univ
    (fun σ : Equiv.Perm ι => (η * matchingProduct a b σ).re)
    ⟨Equiv.refl ι, Finset.mem_univ _⟩
  let z₀ := determinantValue a b U
  let g := (η * z₀).re - (η * matchingProduct a b σ₀).re
  have hg : 0 < g := sub_pos.mpr (hsep σ₀)
  have hgap : ∀ w ∈ Set.range (matchingProduct a b), g ≤ (η * z₀).re - (η * w).re := by
    rintro _ ⟨σ, rfl⟩
    exact sub_le_sub_left (hσ₀ σ (Finset.mem_univ _)) _
  obtain ⟨z, ⟨Z, hZ, rfl⟩, ξ, _, hstrict, hpenalty⟩ :=
    exists_quadratic_support hK hP ⟨U, hU, rfl⟩ η g hg hgap
  obtain ⟨V, hV, hmax, htie⟩ := exists_support_frobenius_maximizer a b ξ
  have heq : determinantValue a b V = determinantValue a b Z := by
    have hle := hpenalty _ ⟨V, hV, rfl⟩
    rw [Complex.mul_sub, Complex.sub_re] at hle
    have hz : Complex.normSq (determinantValue a b V - determinantValue a b Z) = 0 :=
      le_antisymm (by linarith only [hle, hmax Z hZ]) (Complex.normSq_nonneg _)
    exact sub_eq_zero.mp (Complex.normSq_eq_zero.mp hz)
  refine ⟨V, ξ, hV, ?_, ?_, htie⟩
  · intro σ
    rw [heq]
    have hs := hstrict (matchingProduct a b σ) ⟨σ, rfl⟩
    rw [Complex.mul_sub, Complex.sub_re] at hs
    exact sub_neg.mp hs
  · intro W hW
    rw [heq]
    exact hpenalty _ ⟨W, hW, rfl⟩


private def balancedMixer : Matrix (Fin 2) (Fin 2) ℂ :=
  !![((3 / 5 : ℝ) : ℂ), ((-4 / 5 : ℝ) : ℂ);
     ((4 / 5 : ℝ) : ℂ), ((3 / 5 : ℝ) : ℂ)]

private theorem balancedLeft_hermitian : (diagonal balancedLeft).IsHermitian := by
  apply Matrix.isHermitian_diagonal_iff.mpr
  intro i
  fin_cases i <;> simp [balancedLeft, isSelfAdjoint_iff, Complex.star_def]

private theorem balancedRight_skew : (diagonal balancedRight)ᴴ = -diagonal balancedRight := by
  rw [Matrix.diagonal_conjTranspose, Matrix.diagonal_neg]
  apply congrArg (fun d : Fin 2 → ℂ => diagonal d)
  funext i
  change star (balancedRight i) = -balancedRight i
  fin_cases i <;> simp [balancedRight, Complex.star_def, map_mul]

private theorem balancedMixer_unitary : IsUnitary balancedMixer := by
  constructor <;> apply Matrix.ext <;> intro i j <;> fin_cases i <;> fin_cases j <;>
    apply Complex.ext <;>
    norm_num [balancedMixer, Matrix.mul_apply, Fin.sum_univ_two, Matrix.one_apply,
      Matrix.conjTranspose_apply, Complex.star_def, Complex.add_re, Complex.add_im,
      Complex.mul_re, Complex.mul_im]

private theorem balanced_support_zero (V : Matrix (Fin 2) (Fin 2) ℂ) (hV : IsUnitary V) :
    (determinantValue balancedLeft balancedRight V).re = 0 := by
  let A := diagonal balancedLeft
  let D := diagonal balancedRight
  let B := V * D * Vᴴ
  have hA : Aᴴ = A := balancedLeft_hermitian.eq
  have hB : Bᴴ = -B := skew_adjoint_conjugate D V balancedRight_skew
  have hd : A.det + D.det = 0 := by
    simp only [A, D, Matrix.det_diagonal, Fin.prod_univ_two, balancedLeft, balancedRight,
      Matrix.cons_val_zero, Matrix.cons_val_one]
    rw [show (((1 / 2 : ℝ) : ℂ) * Complex.I) * -(((1 / 2 : ℝ) : ℂ) * Complex.I) =
      -(((1 / 2 : ℝ) : ℂ) * ((1 / 2 : ℝ) : ℂ)) * (Complex.I * Complex.I) by ring,
      Complex.I_mul_I]
    ring
  have he : (A + B).det + (A - B).det = 2 * (A.det + B.det) := by
    simp only [Matrix.det_fin_two, Matrix.add_apply, Matrix.sub_apply]
    ring
  have hs : (A - B).det = star ((A + B).det) := by
    rw [← Matrix.det_conjTranspose, Matrix.conjTranspose_add, hA, hB, sub_eq_add_neg]
  rw [hs, show B.det = D.det from det_unitary_conjugation V D hV, hd, mul_zero] at he
  have hre := congrArg Complex.re he
  simp only [Complex.add_re, Complex.star_def, Complex.conj_re, Complex.zero_re] at hre
  change (A + B).det.re = 0
  linarith only [hre]

private theorem balanced_sum_explicit :
    diagonal balancedLeft + balancedMixer * diagonal balancedRight * balancedMixerᴴ =
    !![⟨1 / 2, -7 / 50⟩, ⟨0, 12 / 25⟩; ⟨0, 12 / 25⟩, ⟨-1 / 2, 7 / 50⟩] := by
  apply Matrix.ext
  intro i j
  fin_cases i <;> fin_cases j <;> apply Complex.ext <;>
    norm_num [balancedLeft, balancedRight, balancedMixer, Matrix.diagonal_apply,
      Matrix.add_apply, Matrix.mul_apply, Fin.sum_univ_two, Matrix.conjTranspose_apply,
      Complex.star_def, Complex.add_re, Complex.add_im, Complex.mul_re, Complex.mul_im]

