private def entry (T : Array (Array ℕ)) (i j : ℕ) : ℕ := (T.getD i #[]).getD j 0
private def get (T : Array (Array ℕ)) (i j : ℕ) : Poly := polyTable.getD (entry T i j) []
def point (p : Label) (i : Axis) := get points p.val i.val
def b (t : Cell) (j k : Axis) := get numRows (5*t.val+j.val) k.val
def den (t : Cell) := get denominators 0 t.val
def vertex (t : Cell) (j : Axis) : Label := Fin.ofNat' _ (entry vertices t.val j.val)
def frow (f : Facet) (k : Axis) := get faceRows f.val k.val
def slack (f : Facet) (p : Label) := get slacks f.val p.val
def face (t : Cell) (j : Axis) : Facet := Fin.ofNat' _ (entry whichFace t.val j.val)
def inner (t : Cell) (j : Axis) := entry isInterior t.val j.val != 0
def near (t : Cell) (j : Axis) : Cell := Fin.ofNat' _ (entry adjacent t.val j.val)
def ls (t : Cell) (j : Axis) := get leftScale t.val j.val
def rs (t : Cell) (j : Axis) := get rightScale t.val j.val
def firstPriority (t : Cell) (j : Axis) : Priority := Fin.ofNat' _ (entry firstDifference t.val j.val)
def liftRow (t : Cell) (i : Priority) (k : Axis) := get scoreRows (20*t.val+i.val) k.val
def fl (f : Facet) := get faceLeft 0 f.val
def fr (f : Facet) := get faceRight 0 f.val
def eventIndex (f : Facet) (e : Term) := events.getD (entry eventNumbers f.val e.val) (0,0)
def eventSets (f : Facet) (e : Term) :=
  (FiveSubsetEvents.subsets (eventIndex f e).1, FiveSubsetEvents.subsets (eventIndex f e).2)
def weight (f : Facet) (e : Term) := get eventWeights f.val e.val
def dot (a b : Axis → Poly) : Poly :=
  add (mul (a 0) (b 0)) (add (mul (a 1) (b 1)) (add (mul (a 2) (b 2))
    (add (mul (a 3) (b 3)) (mul (a 4) (b 4)))))

theorem eval_dot (s : ℝ) (a b : Axis → Poly) :
    eval s (dot a b) = ∑ i, eval s (a i) * eval s (b i) := by
  simp only [dot, eval_add, eval_mul, Fin.sum_univ_five]
  ring

def gap (t : Cell) (j : Axis) (i : Priority) (k : Axis) :=
  sub (mul (liftRow t i k) (den (near t j))) (mul (liftRow (near t j) i k) (den t))

set_option maxRecDepth 16000
set_option maxHeartbeats 13000000

theorem positive_den : ∀ t, positive (den t) = true := by decide +kernel
theorem positive_scales : ∀ t j, positive (ls t j) = true ∧ positive (rs t j) = true := by decide +kernel
theorem positive_face : ∀ f, positive (fl f) = true ∧ positive (fr f) = true := by decide +kernel
theorem nonnegative_weight : ∀ f e, nonneg (weight f e) = true := by decide +kernel
theorem mass_coord : ∀ p, point p 0 = [1] := by decide +kernel
theorem reconstruct (t : Cell) : ∀ r k, equal
    (dot (fun j => b t j r) (fun j => point (vertex t j) k))
    (if r = k then den t else []) = true := by
  fin_cases t <;> decide +kernel

theorem boundary_check (t : Cell) : ∀ j, inner t j = false → ∀ k,
    equal (mul (ls t j) (b t j k)) (mul (rs t j) (frow (face t j) k)) = true := by
  fin_cases t <;> decide +kernel

theorem interior_check (t : Cell) : ∀ j, inner t j = true → ∀ k,
    equal (mul (ls t j) (b t j k)) (mul (rs t j) (gap t j (firstPriority t j) k)) = true := by
  fin_cases t <;> decide +kernel

theorem prefix_check (t : Cell) : ∀ j, inner t j = true → ∀ i, i < firstPriority t j → ∀ k,
    zero (gap t j i k) = true := by
  fin_cases t <;> decide +kernel

theorem facet_check (f : Facet) : ∀ p, equal (mul (fl f) (dot (frow f) (point p)))
    (mul (fr f) (slack f p)) = true := by
  fin_cases f <;> decide +kernel

end MOC.HomotheticFive
