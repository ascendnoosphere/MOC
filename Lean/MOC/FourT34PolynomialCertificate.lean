private def certificates : Fin 6 → PolynomialTerms 7 :=
  ![terms0, terms1, terms2, terms3, terms4, terms5]

private def normalizeCoordinates : Fin 8 → PolynomialTerms 7 :=
  ![indeterminate 3 ++ indeterminate 6, indeterminate 4, indeterminate 0, indeterminate 1,
    indeterminate 2, indeterminate 3, constant 7 1, indeterminate 5]

private def swapCoordinates : Fin 8 → PolynomialTerms 8 :=
  ![indeterminate 5, indeterminate 7, indeterminate 2, indeterminate 4,
    indeterminate 3, indeterminate 0, indeterminate 6, indeterminate 1]

private def donorPolynomial : PolynomialTerms 7 := indeterminate 1 ++ indeterminate 2

private def scalarSlack : PolynomialTerms 7 :=
  constant 7 1 ++ donorPolynomial ++
    mul (constant 7 (-1)) (mul (indeterminate 0) donorPolynomial)

private def pathSlack : PolynomialTerms 7 :=
  (indeterminate 3 ++ indeterminate 6) ++ indeterminate 1 ++
    mul (constant 7 (-1)) (mul (mul (indeterminate 0) (indeterminate 3 ++ indeterminate 6)) (indeterminate 1))

private def leftPolynomial : PolynomialTerms 7 :=
  mul (constant 7 4)
    (mul donorPolynomial (substitute radialTerms normalizeCoordinates ++ constant 7 (-1)))

private def rightPolynomial : PolynomialTerms 7 :=
  certificates 0 ++ mul (certificates 1) scalarSlack ++ mul (certificates 2) pathSlack ++
    mul (certificates 3) (pow scalarSlack 2) ++
    mul (certificates 4) (mul scalarSlack pathSlack) ++ mul (certificates 5) (pow pathSlack 2)

private theorem exact_identity : (normalizedKeys leftPolynomial == normalizedKeys rightPolynomial) = true := by
  decide +kernel

private theorem exact_symmetry :
    (normalizedKeys (substitute radialTerms swapCoordinates) == normalizedKeys radialTerms) = true := by
  decide +kernel

private theorem certificates_nonnegative :
    ∀ i : Fin 6, ∀ t ∈ certificates i, 0 ≤ t.coefficient := by
  decide +kernel

private theorem radialTerms_homogeneous : ∀ t ∈ radialTerms, ∑ i, t.powers i = 9 := by
  decide +kernel

/-- The degree-nine radial polynomial in the T34 Hessian certificate. -/
def radialPolynomial (p r a b c q d s : ℝ) : ℝ :=
  eval ![p, r, a, b, c, q, d, s] radialTerms

/-- The T34 radial polynomial scales by the ninth power. -/
theorem radialPolynomial_normalize (p r a b c q d s : ℝ) (hd : d ≠ 0) :
    radialPolynomial (p / d) (r / d) (a / d) (b / d) (c / d) (q / d) 1 (s / d) =
      d⁻¹ ^ 9 * radialPolynomial p r a b c q d s := by
  let t : Fin 8 → ℝ := ![p, r, a, b, c, q, d, s]
  have hscale : (fun i => d⁻¹ * t i) = ![p / d, r / d, a / d, b / d, c / d, q / d, 1, s / d] := by
    funext i
    fin_cases i <;> simp [t, div_eq_mul_inv, mul_comm, hd]
  have he := eval_homogeneous t d⁻¹ radialTerms 9 radialTerms_homogeneous
  rw [hscale] at he
  exact he

theorem radialPolynomial_swap (p r a b c q d s : ℝ) :
    radialPolynomial p r a b c q d s = radialPolynomial q s a c b p d r := by
  let t : Fin 8 → ℝ := ![p, r, a, b, c, q, d, s]
  have hmap : (fun i => eval t (swapCoordinates i)) = ![q, s, a, c, b, p, d, r] := by
    funext i
    fin_cases i <;> simp [swapCoordinates, t]
  have h := eval_eq_of_normalizedKeys_eq t exact_symmetry
  rw [eval_substitute, hmap] at h
  exact h.symm

private theorem exists_nonnegative_certificate {a b c q r s v : ℝ}
    (ha : 0 ≤ a) (hb : 0 ≤ b) (hc : 0 ≤ c) (hq : 0 ≤ q) (hr : 0 ≤ r)
    (hs : 0 ≤ s) (hv : 0 ≤ v) :
    let X := 1 + (b + c) - a * (b + c)
    let Y := (q + v) + b - a * (q + v) * b
    ∃ S : Fin 6 → ℝ, (∀ i, 0 ≤ S i) ∧
      (b + c) * (radialPolynomial (q + v) r a b c q 1 s - 1) =
        S 0 + S 1 * X + S 2 * Y + S 3 * X ^ 2 + S 4 * X * Y + S 5 * Y ^ 2 := by
  let t : Fin 7 → ℝ := ![a, b, c, q, r, s, v]
  let X := 1 + (b + c) - a * (b + c)
  let Y := (q + v) + b - a * (q + v) * b
  let S := fun i => eval t (certificates i) / 4
  have ht (i : Fin 7) : 0 ≤ t i := by fin_cases i <;> assumption
  have hmap : (fun i => eval t (normalizeCoordinates i)) = ![q + v, r, a, b, c, q, 1, s] := by
    funext i
    fin_cases i <;> simp [normalizeCoordinates, t]
  have hdonor : eval t donorPolynomial = b + c := by simp [donorPolynomial, t]
  have hX : eval t scalarSlack = X := by
    simp [scalarSlack, hdonor, t, X, sub_eq_add_neg, add_assoc]
  have hY : eval t pathSlack = Y := by
    simp [pathSlack, t, Y, sub_eq_add_neg, add_assoc]
  have hleft : eval t leftPolynomial = 4 * ((b + c) *
      (radialPolynomial (q + v) r a b c q 1 s - 1)) := by
    simp [leftPolynomial, hmap, hdonor, radialPolynomial, sub_eq_add_neg]
  have hright : eval t rightPolynomial =
      4 * (S 0 + S 1 * X + S 2 * Y + S 3 * X ^ 2 + S 4 * X * Y + S 5 * Y ^ 2) := by
    simp only [rightPolynomial, eval_append, eval_mul, eval_pow, hX, hY, S]
    ring
  refine ⟨S, fun i => div_nonneg (eval_nonneg t ht _ (certificates_nonnegative i)) (by norm_num),
    ?_⟩
  have h := eval_eq_of_normalizedKeys_eq t exact_identity
  rw [hleft, hright] at h
  linarith only [h]

/-- A nonnegative normalized budget with radial polynomial zero meets the
scalar threshold or one of the two path thresholds. -/
theorem safe_disjunction_of_radial_root {p r a b c q s : ℝ}
    (hp : 0 ≤ p) (hr : 0 ≤ r) (ha : 0 ≤ a) (hb : 0 ≤ b) (hc : 0 ≤ c)
    (hq : 0 ≤ q) (hs : 0 ≤ s) (hdonor : 0 < b + c)
    (hroot : radialPolynomial p r a b c q 1 s = 0) :
    1 + 1 / (b + c) ≤ a ∨
      (0 < p ∧ 0 < b ∧ 1 / p + 1 / b ≤ a) ∨
      (0 < c ∧ 0 < q ∧ 1 / c + 1 / q ≤ a) := by
  by_cases horder : q ≤ p
  · obtain ⟨S, hS, heq⟩ := exists_nonnegative_certificate ha hb hc hq hr hs (sub_nonneg.mpr horder)
    have hsum : q + (p - q) = p := by ring
    rw [hsum] at heq
    rcases t34Normalized_safe_of_nonnegative_certificate hp hb hdonor hroot S hS heq with h | h
    · exact Or.inl h
    · exact Or.inr (Or.inl h)
  · have hpq : p ≤ q := (lt_of_not_ge horder).le
    obtain ⟨S, hS, heq⟩ := exists_nonnegative_certificate ha hc hb hp hs hr (sub_nonneg.mpr hpq)
    have hsum : p + (q - p) = q := by ring
    rw [hsum] at heq
    have hroot' := (radialPolynomial_swap p r a b c q 1 s).symm.trans hroot
    have hdonor' : 0 < c + b := by simpa only [add_comm c b] using hdonor
    rcases t34Normalized_safe_of_nonnegative_certificate hq hc hdonor' hroot' S hS heq with h | h
    · exact Or.inl (by simpa only [add_comm c b] using h)
    · exact Or.inr (Or.inr ⟨h.2.1, h.1, by simpa only [add_comm] using h.2.2⟩)

/-- The same support disjunction at a positive, unnormalized mixed coefficient. -/
theorem safe_disjunction_of_radial_root_scaled {p r a b c q d s : ℝ}
    (hp : 0 ≤ p) (hr : 0 ≤ r) (ha : 0 ≤ a) (hb : 0 ≤ b) (hc : 0 ≤ c)
    (hq : 0 ≤ q) (hs : 0 ≤ s) (hd : 0 < d) (hdonor : 0 < b + c)
    (hroot : radialPolynomial p r a b c q d s = 0) :
    d + d ^ 2 / (b + c) ≤ a ∨
      (0 < p ∧ 0 < b ∧ d ^ 2 / p + d ^ 2 / b ≤ a) ∨
      (0 < c ∧ 0 < q ∧ d ^ 2 / c + d ^ 2 / q ≤ a) := by
  have he := radialPolynomial_normalize p r a b c q d s hd.ne'
  have hz : 0 < b / d + c / d := by rw [← add_div]; exact div_pos hdonor hd
  have hout := safe_disjunction_of_radial_root (div_nonneg hp hd.le) (div_nonneg hr hd.le)
    (div_nonneg ha hd.le) (div_nonneg hb hd.le) (div_nonneg hc hd.le)
    (div_nonneg hq hd.le) (div_nonneg hs hd.le) hz (by rw [he, hroot, mul_zero])
  have hh (x : ℝ) : d * (1 / (x / d)) = d ^ 2 / x := by
    rw [one_div_div, ← mul_div_assoc, pow_two]
  have hda : d * (a / d) = a := by
    field_simp [hd.ne']
    <;> ring
  rcases hout with h | h | h
  · have hx := mul_le_mul_of_nonneg_left h hd.le
    rw [← add_div, mul_add, mul_one, hh, hda] at hx
    exact Or.inl hx
  · have hx := mul_le_mul_of_nonneg_left h.2.2 hd.le
    rw [mul_add, hh, hh, hda] at hx
    exact Or.inr (Or.inl ⟨(div_pos_iff_of_pos_right hd).mp h.1,
      (div_pos_iff_of_pos_right hd).mp h.2.1, hx⟩)
  · have hx := mul_le_mul_of_nonneg_left h.2.2 hd.le
    rw [mul_add, hh, hh, hda] at hx
    exact Or.inr (Or.inr ⟨(div_pos_iff_of_pos_right hd).mp h.1,
      (div_pos_iff_of_pos_right hd).mp h.2.1, hx⟩)

