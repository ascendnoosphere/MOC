def imageAt (p : Fin 120) (s : Fin 15) : Fin 15 :=
  (images.getD p.val #[]).getD s.val 0

set_option maxHeartbeats 28000000 in
set_option maxRecDepth 24000 in
theorem image_check (p : Fin 120) : ∀ s,
    (subsets s).map (FivePermutations.perm p).toEmbedding = subsets (imageAt p s) := by
  fin_cases p <;> decide +kernel

/-- An image test is one lookup in the permutation table. -/
theorem image_iff (p : Fin 120) (I J : Fin 15) :
    (subsets J).map (FivePermutations.perm p).toEmbedding = subsets I ↔ imageAt p J = I := by
  rw [image_check]
  exact subsets_injective.eq_iff

theorem signed_event_nonneg (U : Matrix (Fin 5) (Fin 5) ℂ) (hU : IsUnitary U)
    (I J : Finset (Fin 5)) :
    0 ≤ ∑ p : Fin 120, if J.map (FivePermutations.perm p).toEmbedding = I
      then realSignedWeight U (FivePermutations.perm p) else 0 := by
  classical
  have h := congrArg Complex.re (sum_signedWeight_image_eq_subsetMinorSq U hU I J)
  have he : (∑ σ : Equiv.Perm (Fin 5),
      if J.map σ.toEmbedding = I then realSignedWeight U σ else 0) = subsetMinorSq U I J := by
    simpa only [Finset.sum_filter, Complex.re_sum, apply_ite, Complex.zero_re,
      Complex.ofReal_re, realSignedWeight] using h
  rw [← FivePermutations.permEquiv.sum_comp
    (fun σ : Equiv.Perm (Fin 5) => if J.map σ.toEmbedding = I then realSignedWeight U σ else 0)] at he
  exact he.symm ▸ subsetMinorSq_nonneg U I J

end MOC.FiveSubsetEvents
