private def coefficient (f : Fin 12 ⊕ Fin 4) (i : Fin 24) (z : Fin 3) : ℤ :=
  let k := f.elim Fin.val (fun h => 12 + h.val)
  ((coefficientTable.getD k #[]).getD i.val #[]).getD z.val 0

