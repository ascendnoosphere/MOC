private def productIndex (g i : Fin 24) : Fin 24 :=
  (productTable.getD g.val #[]).getD i.val 0

set_option maxHeartbeats 10000000 in
set_option maxRecDepth 16000 in
private theorem product_check (g : Fin 24) :
    ∀ i, fourPermIndex ((fourPerm g)⁻¹ * fourPerm i) = productIndex g i := by
  fin_cases g <;> decide +kernel

private def coordinate (g : Fin 24) (f : Fin 12 ⊕ Fin 4) (i : Fin 24) : Poly :=
  let a := coefficient f (productIndex g i)
  add (add (scale (a 0) (mul [1, 1] [1, 1])) (scale (a 1) (mul [0, 1] [1, 1])))
    (scale (a 2) (mul [0, 1] [0, 1]))

private theorem coordinate_eq (g : Fin 24) (f : Fin 12 ⊕ Fin 4) (i : Fin 24) :
    homogeneousFacet (fourPerm g, f) i [0, 1] [1, 1] = coordinate g f i := by
  have h (σ : FourPerm) : weightedDiamondBaseCoefficients f σ = coefficient f (fourPermIndex σ) := by
    obtain ⟨j, rfl⟩ := fourPerm_surjective σ
    rw [fourPermIndex_fourPerm j]
    exact funext (coefficient_check f j)
  simp only [homogeneousFacet, coordinate, h, product_check]

