/-- The CQ path threshold gives nonnegativity on a quaternion rotation. -/
theorem pathCQ_nonneg (x y : Fin 4 → ℝ)
    (hx : (∑ i, x i ^ 2) = 1) (hy : (∑ i, y i ^ 2) = 1)
    {a c q d : ℝ} (hc : 0 < c) (hq : 0 < q) (hd : 0 ≤ d)
    (hcapacity : d ^ 2 / c + d ^ 2 / q ≤ a) :
    let f := doubleResponse (quaternionRotation x y)
    0 ≤ a * f 2 + c * f 4 + q * f 5 + d * f 6 := by
  let f := doubleResponse (quaternionRotation x y)
  let F := feature x y
  change 0 ≤ a * f 2 + c * f 4 + q * f 5 + d * f 6
  have h2 : (∑ i : Fin 8, F i 2 ^ 2) = f 2 := by
    simpa [gramPolynomials, gramProduct_eval, costIndex, F, f, pow_two]
      using evaluate_gram x y hx hy 1
  have h4 : (∑ i : Fin 8, F i 4 ^ 2) = f 4 := by
    simpa [gramPolynomials, gramProduct_eval, costIndex, F, f, pow_two]
      using evaluate_gram x y hx hy 3
  have h5 : (∑ i : Fin 8, F i 5 ^ 2) = f 5 := by
    simpa [gramPolynomials, gramProduct_eval, costIndex, F, f, pow_two]
      using evaluate_gram x y hx hy 4
  have h6 : (∑ i : Fin 8, (F i 6 ^ 2 + 2 * (F i 2 * F i 4) - 2 * (F i 2 * F i 5))) = f 6 := by
    simp only [Finset.sum_sub_distrib, Finset.sum_add_distrib, ← Finset.mul_sum]
    simpa [gramPolynomials, gramProduct_eval, eval_negative, costIndex, F, f, pow_two, sub_eq_add_neg]
      using evaluate_gram x y hx hy 6
  have hsum : 0 ≤ ∑ i : Fin 8, (a * F i 2 ^ 2 + c * F i 4 ^ 2 + q * F i 5 ^ 2 +
      d * (F i 6 ^ 2 + 2 * (F i 2 * F i 4) - 2 * (F i 2 * F i 5))) := by
    refine Finset.sum_nonneg (fun i _ => ?_)
    have hg := contact_three_vertex_gram_nonneg hc hq hcapacity (-F i 4) (F i 2) (F i 5)
    nlinarith only [hg, mul_nonneg hd (sq_nonneg (F i 6))]
  simpa only [Finset.sum_add_distrib, ← Finset.mul_sum, h2, h4, h5, h6] using hsum

