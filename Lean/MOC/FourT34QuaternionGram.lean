      doubleResponse (quaternionRotation x y) (weightedCostIndex e i) := by
  have h₀ : eval (quaternionCoords x y) firstNorm = 0 := by
    simp only [quaternionCoords, firstNorm, eval_append, eval_pow, eval_indeterminate,
      eval_constant, Int.cast_neg, Int.cast_one, Matrix.cons_val]
    rw [Fin.sum_univ_four] at hx
    linarith only [hx]
  have h₁ : eval (quaternionCoords x y) secondNorm = 0 := by
    simp only [quaternionCoords, secondNorm, eval_append, eval_pow, eval_indeterminate,
      eval_constant, Int.cast_neg, Int.cast_one, Matrix.cons_val]
    rw [Fin.sum_univ_four] at hy
    linarith only [hy]
  have h := eval_eq_of_normalizedKeys_eq (quaternionCoords x y) (exact_weighted_identity e i)
  simpa only [evaluate_weighted, eval_append, eval_mul, h₀, h₁, zero_mul, add_zero,
    eval_doubleResponse] using h

set_option maxRecDepth 16384 in
set_option maxHeartbeats 12000000 in
private theorem weighted_response_nonneg (O : Matrix (Fin 4) (Fin 4) ℝ)
    (hO : Oᵀ * O = 1) (hdet : O.det = 1) :
    weightedResponse O 0 + weightedResponse O 1 +
      2 * √(weightedResponse O 1 * weightedResponse O 2) ≥ 0 := by
  obtain ⟨x, y, hx, hy, he⟩ := exists_quaternionRotation_of_specialOrthogonal O hO hdet
  have h := mixed_quaternion_rotation_weighted x y
    (by simpa only [Fin.sum_univ_four] using hx) (by simpa only [Fin.sum_univ_four] using hy)
  dsimp only at h
  rw [← he] at h
  let A := minor O 1 2 1 2 ^ 2
  let B := minor O 2 3 2 3 ^ 2
  let F := O 1 2 ^ 2 + O 2 1 ^ 2 + B - minor O 1 3 0 2 ^ 2
  have hmain' : 0 ≤ F + A + 2 * √(B * A) := by
    simpa only [F, A, B, minor] using h
  have hmain : 0 ≤ F + A + 2 * √(A * B) := by
    simpa only [mul_comm B A] using hmain'
  have hsqrt : √((2 * A) * (2 * B)) = 2 * √(A * B) := by
    rw [show (2 * A) * (2 * B) = 4 * (A * B) by ring, Real.sqrt_mul (by norm_num : (0 : ℝ) ≤ 4)]
    have hfour : √(4 : ℝ) = 2 := by
      rw [show (4 : ℝ) = 2 ^ 2 by norm_num, Real.sqrt_sq (by norm_num)]
    rw [hfour]
  change 0 ≤ 2 * F + 2 * A + 2 * √((2 * A) * (2 * B))
  rw [hsqrt]
  linarith only [hmain]

set_option maxRecDepth 16384 in
set_option maxHeartbeats 12000000 in
private theorem weighted_donor_nonneg (O : Matrix (Fin 4) (Fin 4) ℝ)
    (hO : Oᵀ * O = 1) (hdet : O.det = 1) (e : Fin 2) :
    let f := doubleResponse O
    0 ≤ f 6 + f 2 + 2 * √(f 2 * f (if e = 0 then 3 else 4)) := by
  let P := O.submatrix (weightedRows e) (weightedColumns e)
  have hP : Pᵀ * P = 1 := by
    dsimp only [P]
    rw [Matrix.transpose_submatrix, Matrix.submatrix_mul_equiv, hO, Matrix.submatrix_one_equiv]
  have hr' : ∀ j : Fin 2, Equiv.Perm.sign (weightedRows j) = 1 := by decide +kernel
  have hc' : ∀ j : Fin 2, Equiv.Perm.sign (weightedColumns j) = 1 := by decide +kernel
  have hdP : P.det = 1 := by
    change ((O.submatrix id (weightedColumns e)).submatrix (weightedRows e) id).det = 1
    rw [Matrix.det_permute, Matrix.det_permute', hr', hc', hdet]
    simp
  have hmain := weighted_response_nonneg P hP hdP
  obtain ⟨x, y, hx, hy, he⟩ := exists_quaternionRotation_of_specialOrthogonal O hO hdet
  have heq (i : Fin 3) : weightedResponse P i = doubleResponse O (weightedCostIndex e i) := by
    dsimp only [P]
    rw [he]
    exact weighted_response_transport x y hx hy e i
  simpa [heq, weightedCostIndex] using hmain

set_option maxRecDepth 16384 in
set_option maxHeartbeats 12000000 in
/-- The weighted-minor bound applies to both donors of the T34 scalar case. -/
theorem scalar_donor_bounds (O : Matrix (Fin 4) (Fin 4) ℝ)
    (hO : Oᵀ * O = 1) (hdet : O.det = 1) :
    let f := doubleResponse O
    (0 ≤ f 6 + f 2 + 2 * √(f 2 * f 3)) ∧
      (0 ≤ f 6 + f 2 + 2 * √(f 2 * f 4)) := by
  exact ⟨by simpa using weighted_donor_nonneg O hO hdet 0,
    by simpa using weighted_donor_nonneg O hO hdet 1⟩

/-- The same response written as a linear combination of complex squared
minor coordinates. -/
def doubleMinorForm {R : Type*} [CommRing R] (m : Finset (Fin 4) → Finset (Fin 4) → R) :
    Fin 8 → R :=
  let sq (i j : Fin 4) := m {i} {j}
  let msq (i j k l : Fin 4) := m {i, j} {k, l}
  ![2 * sq 0 3, 2 * msq 0 1 2 3, 2 * msq 0 2 2 3, 2 * msq 0 3 1 3,
    2 * msq 0 3 0 2, 2 * sq 1 1,
    sq 0 3 + sq 1 1 + sq 2 2 + sq 3 0 + msq 0 1 3 2 + msq 0 1 1 0 -
      msq 0 2 3 1 - msq 0 2 2 0,
    2 * msq 0 1 0 1]

noncomputable def doubleMinorResponse (U : Matrix (Fin 4) (Fin 4) ℂ) : Fin 8 → ℝ :=
  doubleMinorForm (subsetMinorSq U)

set_option maxRecDepth 16384 in
set_option maxHeartbeats 12000000 in
theorem doubleMinorResponse_of_real (O : Matrix.orthogonalGroup (Fin 4) ℝ) :
    doubleMinorResponse (Complex.ofRealHom.mapMatrix O.val) = doubleResponse O.val := by
  let U := Complex.ofRealHom.mapMatrix O.val
  have hU : IsUnitary U := isUnitary_ofReal_orthogonal O
  have hentry (i j : Fin 4) : subsetMinorSq U {i} {j} = O.val i j ^ 2 := by
    rw [subsetMinorSq_singleton U hU i j]
    change Complex.normSq (O.val i j : ℂ) = _
    rw [Complex.normSq_ofReal, pow_two]
  have hpair (i j k l : Fin 4) (hi : i ≠ j) (hk : k ≠ l) :
      subsetMinorSq U {i, j} {k, l} = minor O.val i j k l ^ 2 := by
    rw [subsetMinorSq_pair U hU hi hk]
    change Complex.normSq
      ((O.val i k : ℂ) * (O.val j l : ℂ) - (O.val i l : ℂ) * (O.val j k : ℂ)) = _
    rw [← Complex.ofReal_mul, ← Complex.ofReal_mul, ← Complex.ofReal_sub, Complex.normSq_ofReal]
    simp [minor, pow_two]
  change doubleMinorResponse U = doubleResponse O.val
  funext i
  fin_cases i <;> simp [doubleMinorResponse, doubleMinorForm, doubleResponse, hentry, hpair]

set_option maxRecDepth 16384 in
set_option maxHeartbeats 12000000 in
/-- Flipping a row to fix the determinant preserves all the squared
coordinates appearing in the response. -/
theorem exists_specialOrthogonal_same_response (O : Matrix (Fin 4) (Fin 4) ℝ)
    (hO : Oᵀ * O = 1) :
    ∃ P : Matrix (Fin 4) (Fin 4) ℝ, Pᵀ * P = 1 ∧ P.det = 1 ∧
      doubleResponse P = doubleResponse O := by
  by_cases hdet : O.det = 1
  · exact ⟨O, hO, hdet, rfl⟩
  have hsq := congrArg Matrix.det hO
  rw [Matrix.det_mul, Matrix.det_transpose, Matrix.det_one] at hsq
  have hzero : (O.det - 1) * (O.det + 1) = 0 := by nlinarith only [hsq]
  have hdet' : O.det = -1 := by
    have h := (mul_eq_zero.mp hzero).resolve_left (sub_ne_zero.mpr hdet)
    linarith only [h]
  let f : Fin 4 → ℝ := ![-1, 1, 1, 1]
  let D := Matrix.diagonal f
  let P := D * O
  have hf (i : Fin 4) : f i ^ 2 = 1 := by fin_cases i <;> norm_num [f]
  have hD : Dᵀ * D = 1 := by
    dsimp only [D]
    rw [Matrix.diagonal_transpose, Matrix.diagonal_mul_diagonal, ← Matrix.diagonal_one]
    apply congrArg Matrix.diagonal
    exact funext fun i => by simpa only [pow_two] using hf i
  have hP : Pᵀ * P = 1 := calc
    _ = Oᵀ * (Dᵀ * D) * O := by simpa only [P, Matrix.transpose_mul, Matrix.mul_assoc]
    _ = 1 := by rw [hD, Matrix.mul_one, hO]
  have hdP : P.det = 1 := by
    simp [P, D, Matrix.det_mul, Matrix.det_diagonal, f, hdet', Fin.prod_univ_four]
  have hp (i j : Fin 4) : P i j = f i * O i j := Matrix.diagonal_mul f O i j
  have hentry (i j : Fin 4) : P i j ^ 2 = O i j ^ 2 := by rw [hp, mul_pow, hf, one_mul]
  have hminor (i j k l : Fin 4) : minor P i j k l ^ 2 = minor O i j k l ^ 2 := by
    calc
      _ = (f i * f j) ^ 2 * minor O i j k l ^ 2 := by simp only [minor, hp]; ring
      _ = _ := by simp only [mul_pow, hf, one_mul]
  refine ⟨P, hP, hdP, ?_⟩
  funext i
  fin_cases i <;> simp [doubleResponse, hentry, hminor]

