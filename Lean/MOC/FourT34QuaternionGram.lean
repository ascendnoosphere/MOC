/-- The PB path threshold gives nonnegativity on a quaternion rotation. -/
theorem pathPB_nonneg (x y : Fin 4 → ℝ)
    (hx : (∑ i, x i ^ 2) = 1) (hy : (∑ i, y i ^ 2) = 1)
    {p a b d : ℝ} (hp : 0 < p) (hb : 0 < b) (hd : 0 ≤ d)
    (hcapacity : d ^ 2 / p + d ^ 2 / b ≤ a) :
    let f := doubleResponse (quaternionRotation x y)
    0 ≤ p * f 0 + a * f 2 + b * f 3 + d * f 6 := by
  let f := doubleResponse (quaternionRotation x y)
  let F := feature x y
  change 0 ≤ p * f 0 + a * f 2 + b * f 3 + d * f 6
  have h0 : (∑ i : Fin 8, F i 0 ^ 2) = f 0 := by
    simpa [gramPolynomials, gramProduct_eval, costIndex, F, f, pow_two]
      using evaluate_gram x y hx hy 0
  have h2 : (∑ i : Fin 8, F i 2 ^ 2) = f 2 := by
    simpa [gramPolynomials, gramProduct_eval, costIndex, F, f, pow_two]
      using evaluate_gram x y hx hy 1
  have h3 : (∑ i : Fin 8, F i 3 ^ 2) = f 3 := by
    simpa [gramPolynomials, gramProduct_eval, costIndex, F, f, pow_two]
      using evaluate_gram x y hx hy 2
  have h6 : (∑ i : Fin 8, (F i 6 ^ 2 - 2 * (F i 0 * F i 2) - 2 * (F i 2 * F i 3))) = f 6 := by
    simp only [Finset.sum_sub_distrib, ← Finset.mul_sum]
    simpa [gramPolynomials, gramProduct_eval, eval_negative, costIndex, F, f, pow_two, sub_eq_add_neg]
      using evaluate_gram x y hx hy 5
  have hsum : 0 ≤ ∑ i : Fin 8, (p * F i 0 ^ 2 + a * F i 2 ^ 2 + b * F i 3 ^ 2 +
      d * (F i 6 ^ 2 - 2 * (F i 0 * F i 2) - 2 * (F i 2 * F i 3))) := by
    refine Finset.sum_nonneg (fun i _ => ?_)
    have hg := contact_three_vertex_gram_nonneg hp hb hcapacity (F i 0) (F i 2) (F i 3)
    nlinarith only [hg, mul_nonneg hd (sq_nonneg (F i 6))]
  simpa only [Finset.sum_add_distrib, ← Finset.mul_sum, h0, h2, h3, h6] using hsum

