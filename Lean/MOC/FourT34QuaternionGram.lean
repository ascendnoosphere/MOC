private theorem eval_negative (x : Fin 8 → ℝ) (p : CoefficientList) :
    eval x (negative p) = -eval x p := by simp [negative]

private def minor (O : Matrix (Fin 4) (Fin 4) ℝ) (i j k l : Fin 4) : ℝ :=
  O i k * O j l - O i l * O j k

private def minorPolynomial (i j k l : Fin 4) : CoefficientList :=
  mul (entries i k) (entries j l) ++ negative (mul (entries i l) (entries j k))

/-- Twice the response of the eight source profiles of T34. -/
def doubleResponse (O : Matrix (Fin 4) (Fin 4) ℝ) : Fin 8 → ℝ :=
  ![2 * O 0 3 ^ 2, 2 * minor O 0 1 2 3 ^ 2, 2 * minor O 0 2 2 3 ^ 2,
    2 * minor O 0 3 1 3 ^ 2, 2 * minor O 0 3 0 2 ^ 2, 2 * O 1 1 ^ 2,
    O 0 3 ^ 2 + O 1 1 ^ 2 + O 2 2 ^ 2 + O 3 0 ^ 2 +
      minor O 0 1 3 2 ^ 2 + minor O 0 1 1 0 ^ 2 -
      minor O 0 2 3 1 ^ 2 - minor O 0 2 2 0 ^ 2,
    2 * minor O 0 1 0 1 ^ 2]

private def doubleResponsePolynomials : Fin 8 → CoefficientList :=
  let sq (i j : Fin 4) := pow (entries i j) 2
  let msq (i j k l : Fin 4) := pow (minorPolynomial i j k l) 2
  let twice (p : CoefficientList) := mul (constant 8 2) p
  ![twice (sq 0 3), twice (msq 0 1 2 3), twice (msq 0 2 2 3), twice (msq 0 3 1 3),
    twice (msq 0 3 0 2), twice (sq 1 1),
    sq 0 3 ++ sq 1 1 ++ sq 2 2 ++ sq 3 0 ++ msq 0 1 3 2 ++ msq 0 1 1 0 ++
      negative (msq 0 2 3 1) ++ negative (msq 0 2 2 0),
    twice (msq 0 1 0 1)]

private def quaternionCoords (x y : Fin 4 → ℝ) : Fin 8 → ℝ :=
  ![x 0, x 1, x 2, x 3, y 0, y 1, y 2, y 3]

