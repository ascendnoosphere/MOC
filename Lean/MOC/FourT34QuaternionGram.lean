private theorem eval_doubleResponse (x y : Fin 4 → ℝ) (i : Fin 8) :
    eval (quaternionCoords x y) (doubleResponsePolynomials i) =
      doubleResponse (quaternionRotation x y) i := by
  fin_cases i <;> simp [doubleResponsePolynomials, doubleResponse,
    eval_entries, eval_minorPolynomial, eval_negative, sub_eq_add_neg] <;> ring

private def feature (x y : Fin 4 → ℝ) (i j : Fin 8) : ℝ :=
  eval (quaternionCoords x y) (blocks i j)

private def gramProduct (j k : Fin 8) : CoefficientList :=
  SparsePolynomialCertificate.sum (fun i : Fin 8 => mul (blocks i j) (blocks i k))

private def gramPolynomials : Fin 7 → CoefficientList :=
  let twice (p : CoefficientList) := mul (constant 8 2) p
  ![gramProduct 0 0, gramProduct 2 2, gramProduct 3 3, gramProduct 4 4, gramProduct 5 5,
    gramProduct 6 6 ++ negative (twice (gramProduct 0 2)) ++ negative (twice (gramProduct 2 3)),
    gramProduct 6 6 ++ twice (gramProduct 2 4) ++ negative (twice (gramProduct 2 5))]

private def costIndex : Fin 7 → Fin 8 := ![0, 2, 3, 4, 5, 6, 6]

private def firstNorm : CoefficientList :=
  pow (indeterminate 0) 2 ++ pow (indeterminate 1) 2 ++ pow (indeterminate 2) 2 ++
    pow (indeterminate 3) 2 ++ constant 8 (-1)

private def secondNorm : CoefficientList :=
  pow (indeterminate 4) 2 ++ pow (indeterminate 5) 2 ++ pow (indeterminate 6) 2 ++
    pow (indeterminate 7) 2 ++ constant 8 (-1)

