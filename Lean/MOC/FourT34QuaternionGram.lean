private theorem evaluate_gram (x y : Fin 4 → ℝ)
    (hx : (∑ i, x i ^ 2) = 1) (hy : (∑ i, y i ^ 2) = 1) (i : Fin 7) :
    eval (quaternionCoords x y) (gramPolynomials i) =
      doubleResponse (quaternionRotation x y) (costIndex i) := by
  let z := quaternionCoords x y
  have h₀ : eval z firstNorm = 0 := by
    simp only [z, quaternionCoords, firstNorm, eval_append, eval_pow, eval_indeterminate,
      eval_constant, Int.cast_neg, Int.cast_one, Matrix.cons_val]
    rw [Fin.sum_univ_four] at hx
    linarith only [hx]
  have h₁ : eval z secondNorm = 0 := by
    simp only [z, quaternionCoords, secondNorm, eval_append, eval_pow, eval_indeterminate,
      eval_constant, Int.cast_neg, Int.cast_one, Matrix.cons_val]
    rw [Fin.sum_univ_four] at hy
    linarith only [hy]
  have h := eval_eq_of_normalizedKeys_eq z (exact_gram_identity i)
  have hcost : eval z (doubleResponsePolynomials (costIndex i)) =
      doubleResponse (quaternionRotation x y) (costIndex i) :=
    eval_doubleResponse x y (costIndex i)
  simpa only [eval_append, eval_mul, h₀, h₁, zero_mul, add_zero, hcost] using h

