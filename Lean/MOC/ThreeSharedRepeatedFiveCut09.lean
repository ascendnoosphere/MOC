private def cross (p k : Fin 64) : Choice 64 58 :=
  let x := (crossRows.getD (positiveIndex.getD p.val 0) 0 >>>
    (8 * negativeIndex.getD k.val 0)) &&& 255
  if x < 64 then .skip (Fin.ofNat' 64 x)
  else .edge (Fin.ofNat' 58 (x-64)) (((x-64) / 58+1 : ℕ) : ℤ)

