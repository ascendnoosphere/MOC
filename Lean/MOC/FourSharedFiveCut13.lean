    (9 * negativeIndex.getD k.val 0)) &&& 511
  if x < 66 then .skip (Fin.ofNat' 66 x)
  else .edge (Fin.ofNat' 116 (x-66)) (((x-66) / 116+1 : ℕ) : ℤ)

