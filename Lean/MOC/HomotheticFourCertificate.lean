def coord (p : Label) (k : Fin 7) : ℤ := get coords p.val k.val
def vertex (t : Cell) (j : Fin 7) : Label := Fin.ofNat' _ (get vertices t.val j.val).toNat
def den (t : Cell) : ℤ := get denoms 0 t.val
def bary (t : Cell) (j : Fin 7) (p : Label) : ℤ := get numCovectors (7*t.val+j.val) p.val
def liftValue (t : Cell) (p : Label) : ℤ := get liftCovectors t.val p.val
def slack (f : Facet) (p : Label) : ℤ := get faceCovectors f.val p.val
private def nextCell (t : Cell) (j : Fin 7) : Cell := Fin.ofNat' _ (get nearby t.val j.val).toNat
private def whichFace (t : Cell) (j : Fin 7) : Facet := Fin.ofNat' _ (get boundary t.val j.val).toNat
private def u (t : Cell) (j : Fin 7) : ℤ := get lhsScale t.val j.val
private def v (t : Cell) (j : Fin 7) : ℤ := get rhsScale t.val j.val
private def z (t : Cell) (j : Fin 7) : ℤ := get faceScale t.val j.val

set_option maxRecDepth 12000
set_option maxHeartbeats 6000000

private theorem trans_rows (t : Cell) : ∀ j p,
    u t j * bary t j p = v t j * (liftValue t p - liftValue (nextCell t j) p) +
      z t j * slack (whichFace t j) p := by
  fin_cases t <;> decide +kernel

private theorem mass (t : Cell) : ∀ p, ∑ j, bary t j p = den t := by
  fin_cases t <;> decide +kernel

theorem reconstruct (t : Cell) : ∀ p k,
    ∑ j, bary t j p * coord (vertex t j) k = den t * coord p k := by
  fin_cases t <;> decide +kernel

def geometry : LiftedSimplexGeometry (Fin 4) Label (Fin 7) Cell Facet where
  index := fourPermEquiv
  vertex := vertex
  denominator := den
  bary := bary
  liftValue := liftValue
  neighbor := nextCell
  face := whichFace
  aScale := u
  bScale := v
  cScale := z
  slack := slack
  den_pos := by decide +kernel
  scales_ok := by decide +kernel
  transition := trans_rows
  bary_mass := mass

private def exceptional {M : Type*} [AddCommGroup M]
    (r c : FourPerm) (m : Finset (Fin 4) → Finset (Fin 4) → M) : M :=
  let a (I J : Finset (Fin 4)) := m (I.map r.toEmbedding) (J.map c.toEmbedding)
  a {2} {0} + a {3} {1} + a {0,2} {0,3} + a {0,2} {1,3} -
    a {0,3} {1,2} + a {0,3} {1,3}

private theorem exceptional_nonneg (r c : FourPerm)
    (U : Matrix (Fin 4) (Fin 4) ℂ) (hU : IsUnitary U) :
    0 ≤ exceptional r c (subsetMinorSq U) := by
  have h := homothetic_minor_facet_nonneg (U.submatrix r c) (unitary_reindex r c hU)
  simpa only [exceptional, squared_minor_reindex r c U hU] using h

