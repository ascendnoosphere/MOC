private theorem form_integer (f : Facet) : ∀ p : Label, slack f p =
    facetForm f (diamondPermProfile (R := ℤ) (fourPerm p)) := by
  fin_cases f <;> decide +kernel

private theorem form_real (f : Facet) (p : Label) : (slack f p : ℝ) =
    facetForm f (diamondPermProfile (R := ℝ) (fourPerm p)) := by
  have h := congrArg (fun x : ℤ => (x : ℝ)) (form_integer f p)
  fin_cases f <;> simpa only [facetForm, exceptional, diamondPermProfile, Matrix.cons_val_zero',
    Matrix.cons_val_succ', nsmul_eq_mul, Int.cast_add, Int.cast_mul, Int.cast_natCast,
    Int.cast_sub, Int.cast_ite, Int.cast_one, Int.cast_zero] using h

private theorem form_nonneg (f : Facet) (U : Matrix (Fin 4) (Fin 4) ℂ) (hU : IsUnitary U) :
    0 ≤ facetForm f (subsetMinorSq U) := by
  have hs (a : ℕ) (I J : Finset (Fin 4)) : 0 ≤ a • subsetMinorSq U I J :=
    nsmul_nonneg (subsetMinorSq_nonneg U I J) a
  have he (a : ℕ) (r c : FourPerm) : 0 ≤ a • exceptional r c (subsetMinorSq U) :=
    nsmul_nonneg (exceptional_nonneg r c U hU) a
  fin_cases f <;> simp only [facetForm, Matrix.cons_val_zero', Matrix.cons_val_succ']
    <;> repeat' first | apply add_nonneg | apply hs | apply he

theorem boundary_nonneg (U : Matrix (Fin 4) (Fin 4) ℂ) (hU : IsUnitary U) (f : Facet) :
    0 ≤ LiftedSimplexCertificate.mean geometry.index U
      (LiftedSimplexCertificate.row (geometry.slack f)) := by
  classical
  let L := facetForm f diamondEvaluate
  have hL (m : Finset (Fin 4) → Finset (Fin 4) → ℝ) : L m = facetForm f m := by
    fin_cases f <;> rfl
  have h : 0 ≤ L (subsetMinorSq U) := by rw [hL]; exact form_nonneg f U hU
  rw [diamond_weighted_profile U hU, map_sum] at h
  simp only [map_smul, smul_eq_mul, hL] at h
  rw [← Equiv.sum_comp fourPermEquiv] at h
  change 0 ≤ ∑ p, realSignedWeight U (fourPerm p) * (slack f p : ℝ)
  simpa only [form_real] using h

end MOC.HomotheticFour
