abbrev Cell := Fin 61
abbrev Facet := Fin 52
abbrev Term := Fin 38

def coord (p : Label) (k : Fin 5) : ℤ := atEntry coords p.val k.val
def vertex (t : Cell) (j : Fin 5) : Label := Fin.ofNat' _ (atEntry vertices t.val j.val).toNat
private def den (t : Cell) : ℤ := atEntry denoms 0 t.val
private def b (t : Cell) (j k : Fin 5) : ℤ := atEntry numCovectors (5*t.val+j.val) k.val
private def g (t : Cell) (k : Fin 5) : ℤ := atEntry liftCovectors t.val k.val
private def h (f : Facet) (k : Fin 5) : ℤ := atEntry faceCovectors f.val k.val
private def nextCell (t : Cell) (j : Fin 5) : Cell := Fin.ofNat' _ (atEntry nearby t.val j.val).toNat
private def whichFace (t : Cell) (j : Fin 5) : Facet := Fin.ofNat' _ (atEntry boundary t.val j.val).toNat
private def u (t : Cell) (j : Fin 5) : ℤ := atEntry lhsScale t.val j.val
private def v (t : Cell) (j : Fin 5) : ℤ := atEntry rhsScale t.val j.val
private def z (t : Cell) (j : Fin 5) : ℤ := atEntry faceScale t.val j.val
private def fDen (f : Facet) : ℤ := atEntry facetDenoms 0 f.val
private def term (f : Facet) (e : Term) : Finset (Fin 5) × Finset (Fin 5) × ℤ :=
  (terms.getD f.val #[]).getD e.val (∅,∅,0)

private def dot (r : Fin 5 → ℤ) (p : Label) : ℤ := ∑ k, r k * coord p k

set_option maxRecDepth 16000
set_option maxHeartbeats 12000000

private theorem coordinate_transition (t : Cell) : ∀ j k, u t j * b t j k =
    v t j * (g t k - g (nextCell t j) k) + z t j * h (whichFace t j) k := by
  fin_cases t <;> decide +kernel

private theorem coordinate_reconstruction (t : Cell) : ∀ r k,
    ∑ j, b t j r * coord (vertex t j) k = if r = k then den t else 0 := by
  fin_cases t <;> decide +kernel

private theorem den_positive : ∀ t, 0 < den t := by decide +kernel
private theorem facet_positive : ∀ f, 0 < fDen f := by decide +kernel
private theorem term_nonnegative : ∀ f e, 0 ≤ (term f e).2.2 := by decide +kernel
private theorem scales : ∀ t j, 0 < u t j ∧ 0 ≤ v t j ∧ 0 ≤ z t j := by decide +kernel
private theorem zeroth : ∀ p, coord p 0 = 1 := by decide +kernel

private theorem facet_formula (f : Facet) : ∀ p, fDen f * dot (h f) p =
    ∑ e : Term, if (term f e).2.1.map (perm p).toEmbedding = (term f e).1 then (term f e).2.2 else 0 := by
  fin_cases f <;> decide +kernel

private theorem trans_rows (t : Cell) (j : Fin 5) (p : Label) :
    u t j * dot (b t j) p = v t j * (dot (g t) p - dot (g (nextCell t j)) p) +
      z t j * dot (h (whichFace t j)) p := by
  simp only [dot, ← Finset.sum_sub_distrib, Finset.mul_sum, ← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro k _
  linear_combination (coord p k) * coordinate_transition t j k

theorem reconstruct (t : Cell) (p : Label) (k : Fin 5) :
    ∑ j, dot (b t j) p * coord (vertex t j) k = den t * coord p k := by
  simp only [dot, Finset.sum_mul]
  rw [Finset.sum_comm]
  calc
    _ = ∑ r, (∑ j, b t j r * coord (vertex t j) k) * coord p r := by
      simp only [Finset.sum_mul]
      exact Finset.sum_congr rfl fun r _ => Finset.sum_congr rfl fun j _ => by ring
    _ = _ := by simp only [coordinate_reconstruction, ite_mul, zero_mul, Finset.sum_ite_eq',
        Finset.sum_ite_eq, Finset.mem_univ, if_true]

def lawCertificate : LiftedSimplexCertificate (Fin 5) Label (Fin 5) Cell Facet Term where
  index := permEquiv
  vertex := vertex
  denominator := den
  bary t j := dot (b t j)
  liftValue t := dot (g t)
  neighbor := nextCell
  face := whichFace
  aScale := u
  bScale := v
  cScale := z
  slack f := dot (h f)
  facetDen := fDen
  term := term
  den_pos := den_positive
  facetDen_pos := facet_positive
  term_nonneg := term_nonnegative
  scales_ok := scales
  transition := trans_rows
  minor_decomposition := facet_formula
  bary_mass t p := by simpa only [zeroth, mul_one] using reconstruct t p 0

end MOC.DoubledFive
