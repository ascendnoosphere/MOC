private theorem crossingFast (p k : Fin 116) (hp : 0 < stage13.ray p 4)
    (hk : stage13.ray k 4 < 0) :
    CrossOK stage13 stage14 4 mask p k (cross p k) := by
  have hitP : ∀ p, 0 < stage13.ray p 4 → positiveRay (positiveOf p) = p := by decide +kernel
  have hitN : ∀ k, stage13.ray k 4 < 0 → negativeRay (negativeOf k) = k := by decide +kernel
  have h : ∀ u v, CrossOK stage13 stage14 4 mask
      (positiveRay u) (negativeRay v) (cross (positiveRay u) (negativeRay v)) := by
    apply blocks
    intro b
    fin_cases b <;> decide +kernel
  simpa only [hitP p hp, hitN k hk] using h (positiveOf p) (negativeOf k)

