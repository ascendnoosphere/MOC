def weightedDiamondLowerRays0 (r : Fin 12) (i : Fin 24) : Poly :=
  (beforeTable.getD r.val #[]).getD i.val []

def weightedDiamondLowerRays1 (r : Fin 16) (i : Fin 24) : Poly :=
  (afterTable.getD r.val #[]).getD i.val []

private def crossingTable : Array (Array (Crossing 12 16)) :=
  #[
    #[.skip 0, .keep 10 [1, 4, 4], .keep 11 [1, 2], .skip 0, .skip 0, .skip 0, .skip 0, .skip 0, .skip 0, .skip 0, .skip 0, .skip 0],
    #[.skip 1, .skip 1, .skip 1, .skip 1, .skip 1, .skip 1, .skip 1, .skip 1, .skip 1, .skip 1, .skip 1, .skip 1],
    #[.skip 2, .skip 2, .skip 2, .skip 2, .skip 2, .skip 2, .skip 2, .skip 2, .skip 2, .skip 2, .skip 2, .skip 2],
    #[.skip 3, .keep 12 [1, 2], .keep 13 [1, 4, 4], .skip 3, .skip 3, .skip 3, .skip 3, .skip 3, .skip 3, .skip 3, .skip 3, .skip 3],
    #[.skip 4, .keep 14 [1], .keep 15 [1], .skip 4, .skip 4, .skip 4, .skip 4, .skip 4, .skip 4, .skip 4, .skip 4, .skip 4],
    #[.skip 5, .skip 5, .skip 5, .skip 5, .skip 5, .skip 5, .skip 5, .skip 5, .skip 5, .skip 5, .skip 5, .skip 5],
