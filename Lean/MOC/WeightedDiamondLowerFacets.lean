theorem weightedDiamondLowerFacetScale_positive :
    ∀ k : Fin 184, positive (weightedDiamondLowerFacetScale k) = true := by
  decide +kernel

/-- Every final lower-chart ray is the indicated facet divided by its
positive scale, with the chart denominator cleared. -/
theorem weightedDiamondLowerFacet_equal (k : Fin 184) (i : Fin 24) :
    equal (homogeneousFacet (weightedDiamondLowerFacet k) i [0, 1] [1, 1])
      (mul (scale 2 (weightedDiamondLowerFacetScale k)) (weightedDiamondLowerRays12 k i)) =
      true := by
  simp only [weightedDiamondLowerFacet, homogeneousFacet_basePoly]
  exact lowerFacetCheck_correct k i

