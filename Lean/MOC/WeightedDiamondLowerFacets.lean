def weightedDiamondLowerFinal : RayStage :=
  ⟨184, weightedDiamondLowerRays12, Finset.univ⟩

/-- The facet associated with each final lower-chart ray. -/
def weightedDiamondLowerFacet (k : Fin 184) : WeightedDiamondFacetIndex :=
  (fourPerm (facetEntry k).2.1, facetKind (facetEntry k).1)

/-- The coefficient polynomial relating each facet to its primitive ray. -/
def weightedDiamondLowerFacetScale (k : Fin 184) : Poly := (facetEntry k).2.2

