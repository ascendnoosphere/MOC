private theorem basePoly_correct (k : Fin 16) : ∀ i : Fin 24,
    homogeneousFacet ((1 : FourPerm), facetKind k) i [0, 1] [1, 1] = basePoly k i := by
  fin_cases k <;> decide +kernel

