/-- The coefficients of the matching polynomial, in ascending degree of the second axis. -/
def coeff (p : Label) (k : Fin 5) : ℤ := get coeffs p.val k.val

set_option maxRecDepth 12000
set_option maxHeartbeats 6000000

theorem den_pos : ∀ t, 0 < denominator t := by decide +kernel
theorem facetDen_pos : ∀ f, 0 < facetDen f := by decide +kernel
theorem term_nonneg : ∀ f e, 0 ≤ (term f e).2.2 := by decide +kernel
theorem scales_ok : ∀ t j, 0 < aScale t j ∧ 0 ≤ bScale t j ∧ 0 ≤ cScale t j := by decide +kernel

theorem transition (t : Cell) : ∀ j p,
    aScale t j * bary t j p = bScale t j * (liftValue t p - liftValue (neighbor t j) p) +
      cScale t j * slack (face t j) p := by
  fin_cases t <;> decide +kernel

theorem bary_mass (t : Cell) : ∀ p, ∑ j, bary t j p = denominator t := by
  fin_cases t <;> decide +kernel

theorem reconstruct (t : Cell) : ∀ (p : Label) k,
    ∑ j, bary t j p * coeff (vertex t j) k = denominator t * coeff p k := by
  fin_cases t <;> decide +kernel

theorem minor_decomposition (f : Facet) : ∀ p,
    facetDen f * slack f p = ∑ e : Term, if (term f e).2.1.map (fourPerm p).toEmbedding =
      (term f e).1 then (term f e).2.2 else 0 := by
  fin_cases f <;> decide +kernel

end MOC.DoubleAntipodalCertificate
