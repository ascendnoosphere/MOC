private abbrev allBits : ℕ := 4074071952668972172536891376818756322102936787331872501272280898708762599526673412366794751

private theorem columnTable : ∀ (p : Fin 301) (i : Fin 51),
    (column i).testBit p.val = (mask p).testBit i.val := by
  apply blocks
  intro b
  fin_cases b <;> decide +kernel

private theorem zeroTable : ∀ (k : Fin 301) (i : Fin 51),
    i ∈ zeros k → (mask k).testBit i.val = false := by
  apply blocks
  intro b
  fin_cases b <;> decide +kernel

private theorem unionTable : ∀ k : Fin 301,
    bitUnion column (zeros k) ||| 2 ^ k.val = allBits := by
  apply blocks
  intro b
  fin_cases b <;> decide +kernel

private theorem allTable : ∀ p : Fin 301, allBits.testBit p.val = true := by decide +kernel

private theorem separating : ∀ p k : Fin 301, p ≠ k → ∃ i : Fin 51,
    (mask p).testBit i.val = true ∧ (mask k).testBit i.val = false :=
  separates_of_cover mask column zeros allBits columnTable zeroTable unionTable allTable

private theorem oldSigns : ∀ (p : Fin 301) (i : Fin 51),
    i ∈ stage39.imposed → 0 ≤ stage39.ray p i := by
  apply blocks
  intro b
  fin_cases b <;> decide +kernel

private theorem newSigns : ∀ (p : Fin 297) (i : Fin 51),
    i ∈ stage39.imposed → 0 ≤ stage40.ray p i := by
  apply blocks
  intro b
  fin_cases b <;> decide +kernel

private theorem newPositive : ∀ p : Fin 297, ∃ i ∈ stage39.imposed, 0 < stage40.ray p i := by
  apply blocks
  intro b
  fin_cases b <;> decide +kernel

private theorem supportTable : ∀ (p : Fin 301) (i : Fin 51), (mask p).testBit i.val =
    (decide (i ∈ stage39.imposed) && decide (0 < stage39.ray p i)) := by
  apply blocks
  intro b
  fin_cases b <;> decide +kernel

private theorem retained : ∀ p : Fin 301, 0 ≤ stage39.ray p 44 →
    ∀ i : Fin 51, stage39.ray p i = stage40.ray (keep p) i := by
  apply blocks
  intro b
  fin_cases b <;> decide +kernel

private theorem valid : Valid stage39 stage40 44 mask keep cross :=
  ⟨rfl, oldSigns, newSigns, newPositive, supportTable, separating, retained, crossingFast⟩

theorem covered {W : Submodule ℝ (Fin 51 → ℝ)} (h : Covered W stage39)
    (hm : ∀ r, realRow (poolRay r) ∈ W) : Covered W stage40 :=
  valid.advance h fun _ => hm _

