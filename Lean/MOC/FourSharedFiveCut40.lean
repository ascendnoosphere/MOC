private theorem hitPositive : ∀ p : Fin 301,
    0 < stage39.ray p 44 → positiveRay (positiveOf p) = p := by decide +kernel

private theorem hitNegative : ∀ k : Fin 301,
    stage39.ray k 44 < 0 → negativeRay (negativeOf k) = k := by decide +kernel

private theorem crossingTable : ∀ (u : Fin 177) (v : Fin 38),
    CrossOK stage39 stage40 44 mask (positiveRay u) (negativeRay v)
      (cross (positiveRay u) (negativeRay v)) := by
  apply blocks
  intro b
  fin_cases b <;> decide +kernel

private theorem crossingFast (p k : Fin 301) (hp : 0 < stage39.ray p 44)
    (hk : stage39.ray k 44 < 0) : CrossOK stage39 stage40 44 mask p k (cross p k) := by
  simpa only [hitPositive p hp, hitNegative k hk] using
    crossingTable (positiveOf p) (negativeOf k)

