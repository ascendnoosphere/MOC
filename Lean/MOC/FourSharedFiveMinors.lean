private def term (r : Fin 282) (k : Fin 15) : Fin 15 × Fin 15 × ℕ :=
  (terms.getD r.val #[]).getD k.val (0, 0, 0)

set_option maxHeartbeats 180000000 in
set_option maxRecDepth 32000 in
private theorem ray_events (r : Fin 282) : ∀ p : Fin 120,
    finalRay r (labelPoint p) = ∑ k : Fin 15,
      if imageAt p (term r k).2.1 = (term r k).1 then ((term r k).2.2 : ℤ) else 0 := by
  fin_cases r <;> decide +kernel

private theorem ray_events_real (r : Fin 282) (p : Fin 120) :
    (finalRay r (labelPoint p) : ℝ) = ∑ k : Fin 15,
      if (subsets (term r k).2.1).map (FivePermutations.perm p).toEmbedding = subsets (term r k).1
      then ((term r k).2.2 : ℝ) else 0 := by
  have h := congrArg (fun x : ℤ => (x : ℝ)) (ray_events r p)
  simpa only [image_check, subsets_injective.eq_iff, Int.cast_sum, Int.cast_ite,
    Int.cast_natCast, Int.cast_zero] using h

/-- The signed determinant law has nonnegative expectation on every final ray. -/
theorem signed_ray_nonneg (U : Matrix (Fin 5) (Fin 5) ℂ) (hU : IsUnitary U) (r : Fin 282) :
    0 ≤ ∑ p : Fin 120, realSignedWeight U (FivePermutations.perm p) *
      (finalRay r (labelPoint p) : ℝ) := by
  classical
  have hm (I J : Finset (Fin 5)) :
      0 ≤ ∑ p : Fin 120, if J.map (FivePermutations.perm p).toEmbedding = I
        then realSignedWeight U (FivePermutations.perm p) else 0 := by
    have h := congrArg Complex.re (sum_signedWeight_image_eq_subsetMinorSq U hU I J)
    have he : (∑ σ : Equiv.Perm (Fin 5),
        if J.map σ.toEmbedding = I then realSignedWeight U σ else 0) = subsetMinorSq U I J := by
      simpa only [Finset.sum_filter, Complex.re_sum, apply_ite, Complex.zero_re,
        Complex.ofReal_re, realSignedWeight] using h
    rw [← FivePermutations.permEquiv.sum_comp
      (fun σ : Equiv.Perm (Fin 5) => if J.map σ.toEmbedding = I then realSignedWeight U σ else 0)] at he
    exact he.symm ▸ subsetMinorSq_nonneg U I J
  simp_rw [ray_events_real, Finset.mul_sum]
  rw [Finset.sum_comm]
  apply Finset.sum_nonneg
  intro k _
  have h := mul_nonneg (hm (subsets (term r k).1) (subsets (term r k).2.1))
    (Nat.cast_nonneg (α := ℝ) (term r k).2.2)
  rw [Finset.sum_mul] at h
  convert h using 1
  apply Finset.sum_congr rfl
  intro p _
  split_ifs <;> simp

end MOC.FourSharedFive
