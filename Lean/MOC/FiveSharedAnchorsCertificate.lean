/-! Integer certificate for four shared marked eigenvalues at 0, 2, 3 and 6.
The affine coordinates are 1 and the matching products at the four corners. -/

open BigOperators

namespace MOC.FiveSharedAnchors

set_option maxRecDepth 20000
set_option maxHeartbeats 32000000

abbrev Label := Equiv.Perm (Fin 5)
def firstMarks : Fin 5 → ℤ := ![0, 2, 3, 6, 0]
def secondMarks : Fin 5 → ℤ := ![0, -2, -3, -6, 0]

def corner (p : Label) (x y : ℤ) : ℤ :=
  ∏ j, (Function.update firstMarks 4 x (p j) + Function.update secondMarks 4 y j)

def point (p : Label) : Fin 5 → ℤ :=
  ![1, corner p 0 0, corner p 0 1, corner p 1 0, corner p 1 1]

private def get (A : Array (Array ℤ)) (i j : ℕ) : ℤ := (A.getD i #[]).getD j 0

