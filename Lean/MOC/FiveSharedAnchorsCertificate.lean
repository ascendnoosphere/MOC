abbrev Cell := Fin 106
abbrev Facet := Fin 54
abbrev Term := Fin 23

def vertex (t : Cell) (j : Fin 5) : Label :=
  permutations.getD (get vertices t.val j.val).toNat 1
def denominator (t : Cell) : ℤ := get den 0 t.val
def baryForm (t : Cell) (j k : Fin 5) : ℤ := get barycentric (5*t.val+j.val) k.val
def liftForm (t : Cell) (k : Fin 5) : ℤ := get liftTable t.val k.val
def faceForm (f : Facet) (k : Fin 5) : ℤ := get supportTable f.val k.val
def neighbor (t : Cell) (j : Fin 5) : Cell := Fin.ofNat' _ (get neTable t.val j.val).toNat
def face (t : Cell) (j : Fin 5) : Facet := Fin.ofNat' _ (get faTable t.val j.val).toNat
def aScale (t : Cell) (j : Fin 5) : ℤ := get ascaleTable t.val j.val
def bScale (t : Cell) (j : Fin 5) : ℤ := get bscaleTable t.val j.val
def cScale (t : Cell) (j : Fin 5) : ℤ := get cscaleTable t.val j.val
def facetDen (f : Facet) : ℤ := get facetDenTable 0 f.val
def term (f : Facet) (e : Term) : Finset (Fin 5) × Finset (Fin 5) × ℤ :=
  (termTable.getD f.val #[]).getD e.val (∅, ∅, 0)

def evaluate (v : Fin 5 → ℤ) (p : Label) : ℤ := ∑ k, v k * point p k
def bary (t : Cell) (j : Fin 5) := evaluate (baryForm t j)
def liftValue (t : Cell) := evaluate (liftForm t)
def slack (f : Facet) := evaluate (faceForm f)

set_option maxRecDepth 20000
set_option maxHeartbeats 32000000

theorem den_pos : ∀ t, 0 < denominator t := by decide +kernel
theorem facetDen_pos : ∀ f, 0 < facetDen f := by decide +kernel
theorem term_nonneg : ∀ f e, 0 ≤ (term f e).2.2 := by decide +kernel
theorem scales_ok : ∀ t j, 0 < aScale t j ∧ 0 ≤ bScale t j ∧ 0 ≤ cScale t j := by
  decide +kernel

private theorem transition_coeff (t : Cell) : ∀ j k,
    aScale t j * baryForm t j k =
      bScale t j * (liftForm t k - liftForm (neighbor t j) k) +
      cScale t j * faceForm (face t j) k := by
  fin_cases t <;> decide +kernel

private theorem mass_coeff (t : Cell) : ∀ k, ∑ j, baryForm t j k =
    if k = 0 then denominator t else 0 := by
  fin_cases t <;> decide +kernel

private theorem reconstruction_coeff (t : Cell) : ∀ k l,
    ∑ j, baryForm t j k * point (vertex t j) l =
      if k = l then denominator t else 0 := by
  fin_cases t <;> decide +kernel

theorem minor_decomposition (f : Facet) : ∀ p : Label,
    facetDen f * slack f p = ∑ e : Term, if (term f e).2.1.map p.toEmbedding =
      (term f e).1 then (term f e).2.2 else 0 := by
  letI := fintypePerm (α := Fin 5)
  fin_cases f <;> decide +kernel

theorem transition (t : Cell) (j : Fin 5) (p : Label) :
    aScale t j * bary t j p = bScale t j * (liftValue t p - liftValue (neighbor t j) p) +
      cScale t j * slack (face t j) p := by
  simp only [bary, liftValue, slack, evaluate, ← Finset.sum_sub_distrib, Finset.mul_sum,
    ← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro k _
  have h := congrArg (fun z : ℤ => z * point p k) (transition_coeff t j k)
  change _ * point p k = _ * point p k at h
  linear_combination h

theorem bary_mass (t : Cell) (p : Label) : ∑ j, bary t j p = denominator t := by
  simp only [bary, evaluate]
  rw [Finset.sum_comm]
  simp_rw [← Finset.sum_mul, mass_coeff]
  simp [ite_mul, point]

theorem reconstruct (t : Cell) (p : Label) (k : Fin 5) :
    ∑ j, bary t j p * point (vertex t j) k = denominator t * point p k := by
  simp only [bary, evaluate, Finset.sum_mul]
  rw [Finset.sum_comm]
  have h (l : Fin 5) :
      ∑ j, baryForm t j l * point p l * point (vertex t j) k =
        (if l = k then denominator t else 0) * point p l := by
    rw [← reconstruction_coeff t l k, Finset.sum_mul]
    apply Finset.sum_congr rfl
    intro j _
    ring
  simp_rw [h]
  simp [ite_mul]

end MOC.FiveSharedAnchors
